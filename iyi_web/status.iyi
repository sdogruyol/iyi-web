# Status phrases: `std/http`'s table, plus the codes Kemal actually sends
# that that table does not name. An unnamed code still serialises; it
# gets the class `HTTP.reason_for` gives it.
module iyi_web/status

import std/http::{HTTP}

pub def phrase(code : Int32) : String
  case code
  when 101 then "Switching Protocols"
  when 206 then "Partial Content"
  when 302 then "Found"
  when 303 then "See Other"
  when 307 then "Temporary Redirect"
  when 308 then "Permanent Redirect"
  when 405 then "Method Not Allowed"
  when 409 then "Conflict"
  when 410 then "Gone"
  when 414 then "URI Too Long"
  when 415 then "Unsupported Media Type"
  when 418 then "I'm a teapot"
  when 422 then "Unprocessable Content"
  when 426 then "Upgrade Required"
  when 429 then "Too Many Requests"
  when 502 then "Bad Gateway"
  else          HTTP.reason_for(code)
  end
end

# An `Error` that knows the status it answers with. A route that returns
# one gets that status instead of 500, and the pages for it: `error` for
# its type, then `error` for its status. Kemal reaches the same place by
# raising `Kemal::Exceptions::CustomException` subclasses.
#
# Below 500 the error is the client's, so the built-in page shows its
# `message` and `fields`; write them for the client. From 500 up it is the
# server's, and the built-in page shows the message only under
# `show_exceptions`, as for any other error.
#
# It lives here and not in `iyi_web/failure` because the body readers
# below the context return one, and `failure` is above the context.
pub trait HttpError : Error
  abstract def status : Int32

  # Messages by field name for the client: what a body that failed
  # validation got wrong. Empty for an error about the whole request.
  def fields : Hash(String, String)
    {} of String => String
  end
end
