# HTTP path helpers the rest of the framework shares: joining, prefix
# matching, and the percent-decoding RFC 3986 asks for on a path.
#
# `std/uri` panics on a `%` that is not two hex digits; a request path
# is not a place to 400 over `%GG`, so the decoder lives here. Query
# tables are last-wins `Hash`, which is what `env.params` is; the pairs
# they are built from keep every value, in order.
module iyi_web/codec

import std/text

pub def join_paths(a : String, b : String) : String
  left = a.chomp('/')
  right = b.starts_with?('/') ? b.lchop('/') : b
  return "/" + right if left.empty?
  return left if right.empty?
  left + "/" + right
end

# True when *path* is *prefix* or a descendant of it. `/api` matches `/api`
# and `/api/users`, and does not match `/apiv2`.
pub def matches_path_prefix?(prefix : String, path : String) : Bool
  return true if prefix.empty? || prefix == "/"
  trimmed = prefix.chomp('/')
  return true if path == trimmed
  path.starts_with?(trimmed + "/")
end

# Filter and handler paths. `*` and `/*` match every path; a pattern ending
# in `/*` matches its prefix and every path under it; any other pattern
# matches one path, segment by segment, where `:name` stands for any one
# segment and `*name` for the rest. A trailing slash counts on neither side.
pub def pattern_matches?(pattern : String, path : String) : Bool
  return true if pattern == "*" || pattern == "/*"
  if pattern.ends_with?("/*")
    return matches_path_prefix?(pattern[0, pattern.bytesize - 2], path)
  end
  want = path_segments(pattern)
  have = path_segments(path)
  index = 0
  while index < want.size
    segment = want[index]
    return true if segment.starts_with?('*')
    return false if index >= have.size
    unless segment.starts_with?(':')
      return false unless segment == have[index]
    end
    index = index + 1
  end
  index == have.size
end

private def path_segments(path : String) : Array(String)
  trimmed = path.starts_with?('/') ? path.lchop('/') : path
  trimmed = trimmed.chomp('/')
  return [] of String if trimmed.empty?
  trimmed.split('/')
end

# RFC 3986 percent-decoding, and `+` as space for form bodies. Invalid
# `%` sequences are left as written rather than rejected: a path is not
# a place to 400 over a client that sent `%GG`.
pub def decode(text : String, form : Bool = false) : String
  bytes = Pointer(UInt8).malloc(text.bytesize.to_u64)
  written = 0
  index = 0
  while index < text.bytesize
    ch = text[index]
    if form && ch == '+'
      bytes[written] = 32_u8
      written = written + 1
      index = index + 1
    elsif ch == '%' && index + 2 < text.bytesize
      hi = hex_value(text[index + 1])
      lo = hex_value(text[index + 2])
      if hi >= 0 && lo >= 0
        bytes[written] = (hi * 16 + lo).to_u8
        written = written + 1
        index = index + 3
      else
        bytes[written] = ch.ord.to_u8
        written = written + 1
        index = index + 1
      end
    else
      bytes[written] = ch.ord.to_u8
      written = written + 1
      index = index + 1
    end
  end

  String.new(written) do |target|
    target.copy_from(bytes, written)
  end
end

pub def decode_path(text : String) : String
  decode(text, false)
end

pub def decode_form(text : String) : String
  decode(text, true)
end

# `a=1&b=two+words` into a last-wins table. Empty values are kept, because
# `?flag=` is a present flag with an empty string, not an absent one.
pub def parse_query(text : String) : Hash(String, String)
  table = {} of String => String
  parse_query_pairs(text).each { |pair| table[pair[0]] = pair[1] }
  table
end

# Every name/value pair of a query or form body, decoded, in the order
# sent: `tag=a&tag=b` is two pairs. Pairs with an empty name are dropped.
pub def parse_query_pairs(text : String) : Array(Tuple(String, String))
  pairs = [] of Tuple(String, String)
  return pairs if text.empty?

  text.split('&').each do |pair|
    next if pair.empty?
    eq = pair.index('=')
    if eq
      name = decode_form(pair[0, eq])
      value = decode_form(pair[eq + 1, pair.bytesize - eq - 1])
      pairs << {name, value} unless name.empty?
    else
      name = decode_form(pair)
      pairs << {name, ""} unless name.empty?
    end
  end
  pairs
end

pub def extension_of(path : String) : String
  slash = path.rindex("/")
  start = slash ? slash + 1 : 0
  name = path[start, path.bytesize - start]
  dot = name.rindex(".")
  return "" unless dot
  return "" if dot == 0
  name[dot + 1, name.bytesize - dot - 1].downcase
end

private def hex_value(char : Char) : Int32
  return char.ord - 48 if char >= '0' && char <= '9'
  return char.ord - 65 + 10 if char >= 'A' && char <= 'F'
  return char.ord - 97 + 10 if char >= 'a' && char <= 'f'
  -1
end
