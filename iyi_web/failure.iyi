# What an error page is told caused it, and the built-in pages.
#
# Kemal hands every error handler an `Exception`. iyi has none: a failure is
# a value of a type implementing the prelude's `Error`, so that is what a
# `|env, err|` page gets: the `Panicked` a route's panic was caught as, the
# error a route returned, or a `StatusError` when there is only a status,
# such as the 404 for a path no route serves. An error that implements
# `HttpError` (`iyi_web/status`) carries the status it is answered with.
module iyi_web/failure

import std/html::{HTML}
import std/json::{JSON}
import iyi_web/context::{Context}
import iyi_web/request::{Request}
import iyi_web/status::*

# An error status with no failure behind it: one the router answers itself
# (404, 405, 400 ...), or one a filter or route set on the response. A
# route may return one too, `StatusError.new(404)`, and gets that status.
pub struct StatusError
  getter status : Int32

  def initialize(@status : Int32)
  end
end

impl Error for StatusError
  def message : String
    status.to_s + " " + phrase(status)
  end
end

impl HttpError for StatusError
  def status : Int32
    @status
  end
end

# Renders the first of *pages* - `error` pages for error types, keyed by
# type name in registration order - that takes *failure*'s type. False
# when none does. A page answers nil for an error of another type; one it
# takes answers its body, or writes it with a helper and answers "". The
# caller sets the status and clears the body first.
pub def render_error_type_page(ctx : Context, failure : Error, pages : Hash(String, Proc(Context, Error, String?))) : Bool
  pages.each_value do |page|
    if body = page.call(ctx, failure)
      ctx.response.set_body(body) unless body.empty?
      return true
    end
  end
  false
end

# Writes the built-in page for a failure no `error` handler answered: a
# panic, or an error a route returned, with *status* 500 unless it carries
# another. *message* reaches the client only when *show* is set, and then
# the page is locked down so a message that echoes request data cannot run
# as script. The caller sets the status.
pub def render_failure_page(ctx : Context, message : String, show : Bool, status : Int32 = 500) : Nil
  title = status.to_s + " " + phrase(status)
  head = "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h1>" + title + "</h1>"
  ctx.response.content_type = "text/html; charset=utf-8"
  unless show
    ctx.response.set_body(head + "</body></html>\n")
    return
  end
  request = ctx.request
  ctx.response.set_body(head + "<p>" + HTML.escape(request.method) + " " + HTML.escape(request.path) + "</p><pre>" +
                        HTML.escape(message) + "</pre></body></html>\n")
  ctx.response.headers["Content-Security-Policy"] = "default-src 'none'; style-src 'unsafe-inline'"
  ctx.response.headers["X-Content-Type-Options"] = "nosniff"
end

# Writes the built-in page for an `HttpError` below 500 no `error` handler
# answered: the client's error, so its message and field messages are
# shown in every environment. A request that sent JSON or asks for it gets
# `{"error": message, "fields": {field: message}}`, `fields` left out when
# there are none; any other gets the message as plain text. Neither is
# HTML, so a message that echoes request data cannot run as script. The
# caller sets the status.
pub def render_client_error_page(ctx : Context, failure : HttpError) : Nil
  ctx.response.headers["X-Content-Type-Options"] = "nosniff"
  unless wants_json?(ctx.request)
    ctx.response.content_type = "text/plain; charset=utf-8"
    ctx.response.set_body(failure.message + "\n")
    return
  end
  fields = failure.fields
  body = JSON.build do |json|
    json.object do
      json.field("error", failure.message)
      unless fields.empty?
        json.field("fields") do
          json.object do
            fields.each { |field, message| json.field(field, message) }
          end
        end
      end
    end
  end
  ctx.response.content_type = "application/json; charset=utf-8"
  ctx.response.set_body(body)
end

# An `Accept` that names JSON wins, one that names HTML loses, and with
# neither a request that sent JSON is answered in JSON.
private def wants_json?(request : Request) : Bool
  accept = (request.headers["Accept"]? || "").downcase
  return true if accept.includes?("json")
  return false if accept.includes?("html")
  type = request.content_type.downcase
  type == "application/json" || (type.starts_with?("application/") && type.ends_with?("+json"))
end
