# Static files from a real folder: MIME, index.html, HEAD, a missing file
# falling through, and a `..` path that must not walk out of the folder.
module iyi_web/static_test

import iyi_web/static
import iyi_web/handler
import iyi_web/harness
import iyi_web/spec

using iyi_web/static::{StaticHandler}
using iyi_web/handler::{chain}
using iyi_web/harness
using iyi_web/spec

ROOT = __DIR__ + "/fixtures"

def static_app
  chain([StaticHandler.new(ROOT), routes { |r|
    r.get "/fallback" do |env|
      "from-route"
    end
  }])
end

describe "StaticHandler" do
  it "serves a file with its MIME type" do
    hello = File.read(ROOT + "/hello.txt")
    ctx = dispatch(static_app, "GET", "/hello.txt")
    assert ctx.response.body == hello
    assert ctx.response.content_type == "text/plain; charset=utf-8"
  end

  it "maps common extensions" do
    app = static_app
    assert dispatch(app, "GET", "/app.css").response.content_type == "text/css; charset=utf-8"
    assert dispatch(app, "GET", "/app.js").response.content_type == "text/javascript; charset=utf-8"
    assert dispatch(app, "GET", "/data.json").response.content_type == "application/json; charset=utf-8"
    assert dispatch(app, "GET", "/unknown.bin").response.content_type == "application/octet-stream"
  end

  it "serves index.html for a directory" do
    ctx = dispatch(static_app, "GET", "/")
    assert ctx.response.body == File.read(ROOT + "/index.html")
    assert ctx.response.content_type == "text/html; charset=utf-8"
  end

  it "omits the body on HEAD and keeps the length" do
    hello = File.read(ROOT + "/hello.txt")
    ctx = dispatch(static_app, "HEAD", "/hello.txt")
    assert ctx.response.body == ""
    assert ctx.response.headers["content-length"] == hello.bytesize.to_s
  end

  it "does not serve a file for POST" do
    assert dispatch(static_app, "POST", "/hello.txt").response.status_code == 404
  end

  it "falls through when the file is missing" do
    assert dispatch(static_app, "GET", "/no-such-static.txt").response.status_code == 404
  end

  it "refuses a path that walks out of the folder" do
    walk = dispatch(static_app, "GET", "/../router.iyi")
    assert walk.response.status_code == 404
    assert !walk.response.body.includes?("Modular routing")

    nested = dispatch(static_app, "GET", "/foo/../../router.iyi")
    assert nested.response.status_code == 404
  end

  it "reaches the router when nothing is served" do
    assert dispatch(static_app, "GET", "/fallback").response.body == "from-route"
  end

  it "does not File.read a directory that has no index.html" do
    listing = chain([StaticHandler.new(__DIR__), routes { |r|
      r.get "/fallback" do |env|
        "from-route"
      end
    }])
    assert dispatch(listing, "GET", "/").response.status_code == 404
  end
end
