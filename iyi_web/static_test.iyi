# Static files from a real folder: MIME, index.html, HEAD, a missing file
# falling through, and a `..` path that must not walk out of the folder.
module iyi_web/static_test

import iyi_web/static
import iyi_web/handler
import iyi_web/router
import iyi_web/harness

using iyi_web/static::{StaticHandler}
using iyi_web/handler::{chain}
using iyi_web/router::{Router, RouteHandler}
using iyi_web/harness

root = __DIR__ + "/fixtures"
router = Router.new
router.get "/fallback" do |env|
  "from-route"
end
static_chain = chain([StaticHandler.new(root), RouteHandler.new(router)])

hello = File.read(root + "/hello.txt")
txt = dispatch(static_chain, "GET", "/hello.txt")
assert txt.response.body == hello, "GET file"
assert txt.response.content_type == "text/plain; charset=utf-8", "txt mime"

css = dispatch(static_chain, "GET", "/app.css")
assert css.response.body == File.read(root + "/app.css"), "GET css"
assert css.response.content_type == "text/css; charset=utf-8", "css mime"

js = dispatch(static_chain, "GET", "/app.js")
assert js.response.content_type == "text/javascript; charset=utf-8", "js mime"

json = dispatch(static_chain, "GET", "/data.json")
assert json.response.content_type == "application/json; charset=utf-8", "json mime"

bin = dispatch(static_chain, "GET", "/unknown.bin")
assert bin.response.body == File.read(root + "/unknown.bin"), "GET unknown"
assert bin.response.content_type == "application/octet-stream", "unknown mime"

index = File.read(root + "/index.html")
listed = dispatch(static_chain, "GET", "/")
assert listed.response.body == index, "GET / serves index.html"
assert listed.response.content_type == "text/html; charset=utf-8", "index mime"

headed = dispatch(static_chain, "HEAD", "/hello.txt")
assert headed.response.body == "", "HEAD body empty"
assert headed.response.headers["content-length"] == hello.bytesize.to_s, "HEAD length"

posted = dispatch(static_chain, "POST", "/hello.txt")
assert posted.response.status_code == 404, "POST is not a static verb"

missing = dispatch(static_chain, "GET", "/no-such-static.txt")
assert missing.response.status_code == 404, "missing file falls through"

walk = dispatch(static_chain, "GET", "/../router.iyi")
assert walk.response.status_code == 404, ".. is refused"
assert !walk.response.body.includes?("Modular routing"), ".. must not serve a sibling source file"

nested = dispatch(static_chain, "GET", "/foo/../../router.iyi")
assert nested.response.status_code == 404, "nested .. is refused"

fallback = dispatch(static_chain, "GET", "/fallback")
assert fallback.response.body == "from-route", "unmatched GET reaches the router"

puts "static_test ok"
