# Static files from a real folder: MIME, index.html, HEAD, a missing file
# falling through, a `..` path that must not walk out of the folder, and
# the caching, compression and range behaviour a production server needs.
module iyi_web/static_test

import std/file::{File}
import std/compress::{Gzip, Zlib, Inflater, Envelope}
import std/mutex::{Mutex}
import std/shared_proc::{SharedProc}
import iyi_web/static::{StaticHandler}
import iyi_web/handler::{chain}
import iyi_web/context::{Context}
import iyi_web/harness::*
import iyi_web/spec::*

ROOT = __DIR__ + "/fixtures"

def static_app
  static_app_at(ROOT)
end

def static_app_at(root : String)
  chain([StaticHandler.new(root), routes { |r|
    r.get "/fallback" do |env|
      "from-route"
    end
  }])
end

# *size* bytes of numbered lines, so every offset holds different text.
def numbered(size : Int32) : String
  lines = [] of String
  total = 0
  index = 0
  while total < size
    digits = index.to_s
    line = "0" * (7 - digits.bytesize) + digits + "\n"
    lines << line
    total = total + line.bytesize
    index = index + 1
  end
  lines.join[0, size]
end

describe "StaticHandler" do
  it "serves a file with its MIME type" do
    hello = File.read(ROOT + "/hello.txt")
    ctx = dispatch(static_app, "GET", "/hello.txt")
    assert ctx.response.body == hello
    assert ctx.response.content_type == "text/plain; charset=utf-8"
  end

  it "maps common extensions" do
    app = static_app
    assert dispatch(app, "GET", "/app.css").response.content_type == "text/css; charset=utf-8"
    assert dispatch(app, "GET", "/app.js").response.content_type == "text/javascript; charset=utf-8"
    assert dispatch(app, "GET", "/data.json").response.content_type == "application/json; charset=utf-8"
    assert dispatch(app, "GET", "/unknown.bin").response.content_type == "application/octet-stream"
  end

  it "takes media types from std/mime" do
    File.tempfile("iyi-web-static-", ".wasm") do |wasm|
      File.write(wasm, "\u0000asm")
      app = static_app_at(File.dirname(wasm))
      assert dispatch(app, "GET", "/" + File.basename(wasm)).response.content_type == "application/wasm"
    end
    File.tempfile("iyi-web-static-", ".mjs") do |module_file|
      File.write(module_file, "export {}")
      app = static_app_at(File.dirname(module_file))
      assert dispatch(app, "GET", "/" + File.basename(module_file)).response.content_type == "text/javascript; charset=utf-8"
    end
  end

  it "serves index.html for a directory" do
    ctx = dispatch(static_app, "GET", "/")
    assert ctx.response.body == File.read(ROOT + "/index.html")
    assert ctx.response.content_type == "text/html; charset=utf-8"
  end

  it "omits the body on HEAD and keeps the length" do
    hello = File.read(ROOT + "/hello.txt")
    ctx = dispatch(static_app, "HEAD", "/hello.txt")
    assert ctx.response.body == ""
    assert ctx.response.headers["content-length"] == hello.bytesize.to_s
  end

  it "does not serve a file for POST" do
    assert dispatch(static_app, "POST", "/hello.txt").response.status_code == 404
  end

  it "falls through when the file is missing" do
    assert dispatch(static_app, "GET", "/no-such-static.txt").response.status_code == 404
  end

  it "refuses a path that walks out of the folder" do
    walk = dispatch(static_app, "GET", "/../router.iyi")
    assert walk.response.status_code == 404
    assert !walk.response.body.includes?("Modular routing")

    nested = dispatch(static_app, "GET", "/foo/../../router.iyi")
    assert nested.response.status_code == 404

    # `\` is a separator to Windows: decoded from `%5C`, this named the
    # router's source one folder up and served it.
    slashed = dispatch(static_app, "GET", "/..\\router.iyi")
    assert slashed.response.status_code == 404
    assert !slashed.response.body.includes?("Modular routing")
  end

  it "does not serve a Windows alternate stream of a file" do
    assert dispatch(static_app, "GET", "/hello.txt::$DATA").response.status_code == 404
  end

  it "reaches the router when nothing is served" do
    assert dispatch(static_app, "GET", "/fallback").response.body == "from-route"
  end

  it "does not File.read a directory that has no index.html" do
    listing = chain([StaticHandler.new(__DIR__), routes { |r|
      r.get "/fallback" do |env|
        "from-route"
      end
    }])
    assert dispatch(listing, "GET", "/").response.status_code == 404
  end

  it "redirects a directory without a trailing slash, then serves its index" do
    moved = dispatch(static_app, "GET", "/docs")
    assert moved.response.status_code == 302
    assert moved.response.headers["location"] == "/docs/"
    assert dispatch(static_app, "GET", "/docs/").response.body == File.read(ROOT + "/docs/index.html")
  end

  it "lists a directory when dir_listing is on" do
    app = chain([StaticHandler.new(ROOT, dir_index: false, dir_listing: true), routes { |r|
      r.get "/fallback" do |env|
        "from-route"
      end
    }])
    listing = dispatch(app, "GET", "/")
    assert listing.response.status_code == 200
    assert listing.response.body.includes?("<a href=\"/hello.txt\">hello.txt</a>")
    assert listing.response.body.includes?("<a href=\"/docs/\">docs/</a>")
  end

  it "sends ETag and Last-Modified and answers a matching request with 304" do
    first = dispatch(static_app, "GET", "/hello.txt")
    tag = first.response.headers["etag"]
    modified = first.response.headers["last-modified"]
    assert tag.starts_with?("W/\"")
    assert first.response.headers["x-content-type-options"] == "nosniff"
    assert first.response.headers["accept-ranges"] == "bytes"

    again = http_request("GET", "/hello.txt")
    again.headers["If-None-Match"] = "\"other\", " + tag
    cached = dispatch(static_app, again)
    assert cached.response.status_code == 304
    assert cached.response.body == ""

    dated = http_request("GET", "/hello.txt")
    dated.headers["If-Modified-Since"] = modified
    assert dispatch(static_app, dated).response.status_code == 304

    stale = http_request("GET", "/hello.txt")
    stale.headers["If-Modified-Since"] = "Sun, 06 Nov 1994 08:49:37 GMT"
    assert dispatch(static_app, stale).response.status_code == 200

    other = http_request("GET", "/hello.txt")
    other.headers["If-None-Match"] = "\"nope\""
    other.headers["If-Modified-Since"] = modified
    assert dispatch(static_app, other).response.status_code == 200
  end

  it "answers a byte range with 206 and an unsatisfiable one with 416" do
    ranged = http_request("GET", "/hello.txt")
    ranged.headers["Range"] = "bytes=0-4"
    part = dispatch(static_app, ranged)
    assert part.response.status_code == 206
    assert part.response.body == "hello"
    assert part.response.headers["content-range"] == "bytes 0-4/12"

    beyond = http_request("GET", "/hello.txt")
    beyond.headers["Range"] = "bytes=50-60"
    missed = dispatch(static_app, beyond)
    assert missed.response.status_code == 416
    assert missed.response.headers["content-range"] == "bytes */12"

    two = http_request("GET", "/hello.txt")
    two.headers["Range"] = "bytes=0-0,-1"
    multi = dispatch(static_app, two)
    assert multi.response.status_code == 206
    assert multi.response.content_type.starts_with?("multipart/byteranges; boundary=")
  end

  it "compresses a large textual file for a client that accepts gzip" do
    request = http_request("GET", "/large.txt")
    request.headers["Accept-Encoding"] = "gzip, deflate"
    packed = dispatch(static_app, request)
    assert packed.response.headers["content-encoding"] == "gzip"
    assert packed.response.headers["vary"] == "Accept-Encoding"
    assert packed.response.headers["etag"].ends_with?("-gzip\"")
    assert Gzip.decompress(packed.response.body) == File.read(ROOT + "/large.txt")

    plain = dispatch(static_app, "GET", "/large.txt")
    assert plain.response.headers["content-encoding"]?.nil?
    assert plain.response.headers["vary"] == "Accept-Encoding"
    assert plain.response.body == File.read(ROOT + "/large.txt")
  end

  it "sends a file larger than one chunk whole, by range, for HEAD and as a 304" do
    File.tempfile("iyi-web-static-", ".bin") do |path|
      content = numbered(200000)
      File.write(path, content)
      app = static_app_at(File.dirname(path))
      url = "/" + File.basename(path)

      whole = dispatch(app, "GET", url)
      assert whole.response.status_code == 200
      assert whole.response.headers["content-length"] == "200000"
      assert whole.response.body == content

      headed = dispatch(app, "HEAD", url)
      assert headed.response.status_code == 200
      assert headed.response.body == ""
      assert headed.response.headers["content-length"] == "200000"
      assert headed.response.headers["etag"] == whole.response.headers["etag"]
      assert headed.response.headers["last-modified"] == whole.response.headers["last-modified"]
      assert headed.response.headers["accept-ranges"] == "bytes"

      ranged = http_request("GET", url)
      ranged.headers["Range"] = "bytes=100000-"
      part = dispatch(app, ranged)
      assert part.response.status_code == 206
      assert part.response.headers["content-range"] == "bytes 100000-199999/200000"
      assert part.response.body == content[100000, 100000]

      cached = http_request("GET", url)
      cached.headers["If-None-Match"] = whole.response.headers["etag"]
      unchanged = dispatch(app, cached)
      assert unchanged.response.status_code == 304
      assert unchanged.response.body == ""
    end
  end

  it "compresses a textual file larger than 1 MiB as it reads it, and sends a range of it as it is" do
    File.tempfile("iyi-web-static-", ".txt") do |path|
      content = numbered(1572864 + 77)
      File.write(path, content)
      app = static_app_at(File.dirname(path))
      url = "/" + File.basename(path)

      accepted = http_request("GET", url)
      accepted.headers["Accept-Encoding"] = "gzip"
      packed = dispatch(app, accepted)
      assert packed.response.headers["content-encoding"] == "gzip"
      assert packed.response.headers["vary"] == "Accept-Encoding"
      assert packed.response.headers["etag"].ends_with?("-gzip\"")
      assert packed.response.body.bytesize < content.bytesize
      assert Gzip.decompress(packed.response.body) == content

      # The same stream read a piece at a time, as a client would.
      given = false
      reader = Inflater.new(Envelope::Gzip) do
        if given
          nil
        else
          given = true
          packed.response.body
        end
      end
      unpacked = ""
      loop do
        piece = reader.read(65536).or_panic
        break if piece.empty?
        unpacked = unpacked + piece
      end
      assert unpacked == content

      deflate = http_request("GET", url)
      deflate.headers["Accept-Encoding"] = "deflate"
      zlib = dispatch(app, deflate)
      assert zlib.response.headers["content-encoding"] == "deflate"
      assert Zlib.decompress(zlib.response.body) == content

      ranged = http_request("GET", url)
      ranged.headers["Accept-Encoding"] = "gzip"
      ranged.headers["Range"] = "bytes=1500000-1500099"
      part = dispatch(app, ranged)
      assert part.response.status_code == 206
      assert !part.response.headers.has_key?("Content-Encoding")
      assert part.response.headers["vary"] == "Accept-Encoding"
      assert !part.response.headers["etag"].ends_with?("-gzip\"")
      assert part.response.headers["content-range"] == "bytes 1500000-1500099/" + content.bytesize.to_s
      assert part.response.body == content[1500000, 100]

      cached = http_request("GET", url)
      cached.headers["Accept-Encoding"] = "gzip"
      cached.headers["If-None-Match"] = packed.response.headers["etag"]
      assert dispatch(app, cached).response.status_code == 304
      identity_tag = http_request("GET", url)
      identity_tag.headers["Accept-Encoding"] = "gzip"
      identity_tag.headers["If-None-Match"] = part.response.headers["etag"]
      assert dispatch(app, identity_tag).response.status_code == 200

      headed = http_request("HEAD", url)
      headed.headers["Accept-Encoding"] = "gzip"
      head = dispatch(app, headed)
      assert head.response.headers["content-encoding"] == "gzip"
      assert head.response.body == ""
    end
  end

  it "sends a .gz copy beside the file to a client that accepts gzip" do
    File.tempfile("iyi-web-static-", ".js") do |path|
      content = numbered(4000)
      File.write(path, content)
      copy = path + ".gz"
      # Marked, so a body from the copy cannot pass for one compressed on
      # the fly.
      File.write(copy, Gzip.compress("precompressed " + content))
      app = static_app_at(File.dirname(path))
      url = "/" + File.basename(path)

      accepted = http_request("GET", url)
      accepted.headers["Accept-Encoding"] = "gzip"
      packed = dispatch(app, accepted)
      assert packed.response.headers["content-encoding"] == "gzip"
      assert packed.response.content_type == "text/javascript; charset=utf-8"
      assert packed.response.headers["vary"] == "Accept-Encoding"
      assert packed.response.headers["etag"].ends_with?("-gzip\"")
      assert packed.response.body == File.read(copy)

      # Sent with the gzip option off too: the copy alone makes the file
      # negotiable.
      off = chain([StaticHandler.new(File.dirname(path), gzip: false)])
      assert dispatch(off, accepted).response.body == File.read(copy)

      plain = dispatch(app, "GET", url)
      assert !plain.response.headers.has_key?("Content-Encoding")
      assert plain.response.headers["vary"] == "Accept-Encoding"
      assert plain.response.body == content

      refused = http_request("GET", url)
      refused.headers["Accept-Encoding"] = "gzip;q=0, deflate"
      deflated = dispatch(app, refused)
      assert deflated.response.headers["content-encoding"] == "deflate"
      assert Zlib.decompress(deflated.response.body) == content

      ranged = http_request("GET", url)
      ranged.headers["Accept-Encoding"] = "gzip"
      ranged.headers["Range"] = "bytes=0-6"
      part = dispatch(app, ranged)
      assert part.response.status_code == 206
      assert !part.response.headers.has_key?("Content-Encoding")
      assert part.response.body == content[0, 7]

      headed = http_request("HEAD", url)
      headed.headers["Accept-Encoding"] = "gzip"
      head = dispatch(app, headed)
      assert head.response.headers["content-length"] == File.size(copy).to_s

      # A copy older than the file is stale and is not sent.
      File.touch(copy, File.info(path).modification_time - 10_i64)
      stale = dispatch(app, accepted)
      assert stale.response.headers["content-encoding"] == "gzip"
      assert Gzip.decompress(stale.response.body) == content
      File.delete(copy)
    end
  end

  it "calls the headers hook with the served file" do
    seen = Mutex.new { [] of String }
    hook = SharedProc({Context, String, File::Info}, Nil).of do |args|
      path = args[1]
      seen.lock { |paths| paths << path }
      args[0].response.headers["Cache-Control"] = "max-age=" + args[2].size.to_s
      nil
    end
    app = chain([StaticHandler.new(ROOT, headers_hook: hook), routes { |r|
      r.get "/fallback" do |env|
        "from-route"
      end
    }])
    ctx = dispatch(app, "GET", "/hello.txt")
    assert seen.get { |paths| paths.join(",") } == ROOT + "/hello.txt"
    assert ctx.response.headers["cache-control"] == "max-age=12"
  end
end
