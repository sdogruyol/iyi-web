# Command-line flags: bind and port reach the config, bad input is named,
# TLS loads its key and certificate, help is noticed, and an application's
# own flags run.
module iyi_web/cli_test

import std/tls::{TlsVersion}
import iyi_web/cli::{CLIParser, cli_parser}
import iyi_web/config::{Config}
import iyi_web/spec::*

describe "cli_parser" do
  it "sets host and port in every spelling" do
    cfg = Config.new
    assert cli_parser(cfg).parse(["-b", "127.0.0.1", "--port=4000"]).nil?
    assert cfg.host == "127.0.0.1"
    assert cfg.port == 4000
    assert cli_parser(cfg).parse(["--bind", "0.0.0.0", "-p5000"]).nil?
    assert cfg.host == "0.0.0.0"
    assert cfg.port == 5000
    assert cli_parser(cfg).parse(["-p", "0"]).nil?
    assert cfg.port == 0
  end

  it "names an invalid port, an unknown flag and a missing value" do
    cfg = Config.new
    assert cli_parser(cfg).parse(["-p", "70000"]) == "Invalid port \"70000\": must be an integer between 0 and 65535."
    assert cli_parser(cfg).parse(["--port", " 80"]) == "Invalid port \" 80\": must be an integer between 0 and 65535."
    assert cli_parser(cfg).parse(["--nope"]) == "Invalid option: --nope"
    assert cli_parser(cfg).parse(["--port"]) == "Missing argument for option: --port"
  end

  it "loads TLS from -s with both files, and refuses -s without one" do
    key = __DIR__ + "/testdata/localhost.key"
    cert = __DIR__ + "/testdata/localhost.crt"
    cfg = Config.new
    assert cli_parser(cfg).parse(["-s", "--ssl-key-file", key, "--ssl-cert-file=" + cert]).nil?
    if tls = cfg.ssl
      # HTTP/2 first: the server speaks it over TLS to a client that asks.
      assert tls.alpn == ["h2", "http/1.1"]
      assert tls.leaf.matches_host?("localhost")
      assert tls.min_version == TlsVersion::TLS13
      assert tls.client_roots.nil?
    else
      assert false
    end

    plain = Config.new
    assert cli_parser(plain).parse(["--ssl-key-file", key, "--ssl-cert-file", cert]).nil?
    assert plain.ssl.nil?

    assert cli_parser(Config.new).parse(["--ssl", "--ssl-cert-file", cert]) == "SSL configuration error: SSL key file not specified. Use --ssl-key-file FILE to specify the key file."
    assert cli_parser(Config.new).parse(["-s", "--ssl-key-file", key]) == "SSL configuration error: SSL certificate file not specified. Use --ssl-cert-file FILE to specify the certificate file."
    assert cli_parser(Config.new).parse(["-s", "-h"]).nil?
  end

  it "names a TLS file it cannot read and a key TLS refuses, rather than starting" do
    key = __DIR__ + "/testdata/localhost.key"
    cert = __DIR__ + "/testdata/localhost.crt"
    missing = __DIR__ + "/testdata/no-such.pem"
    assert cli_parser(Config.new).parse(["-s", "--ssl-key-file", missing, "--ssl-cert-file", cert]) == "SSL configuration error: cannot read the SSL key file " + missing + "."
    assert cli_parser(Config.new).parse(["-s", "--ssl-key-file", key, "--ssl-cert-file", __DIR__ + "/testdata"]) == "SSL configuration error: cannot read the SSL certificate file " + __DIR__ + "/testdata."
    # The certificate given as the key: no PRIVATE KEY block in it.
    refused = cli_parser(Config.new).parse(["-s", "--ssl-key-file", cert, "--ssl-cert-file", cert])
    if problem = refused
      assert problem.starts_with?("SSL configuration error: tls: the private key")
    else
      assert false
    end
  end

  it "asks for client certificates under --ssl-client-ca and takes TLS 1.2 under --ssl-min-version" do
    key = __DIR__ + "/testdata/localhost.key"
    cert = __DIR__ + "/testdata/localhost.crt"
    roots = __DIR__ + "/testdata/client-ca.crt"
    cfg = Config.new
    assert cli_parser(cfg).parse(["-s", "--ssl-key-file", key, "--ssl-cert-file", cert, "--ssl-client-ca", roots, "--ssl-min-version", "1.2"]).nil?
    if tls = cfg.ssl
      assert tls.min_version == TlsVersion::TLS12
      if presented = tls.client_roots
        assert presented.size == 1
        assert presented[0].subject_name.includes?("iyi-web test client root")
      else
        assert false
      end
    else
      assert false
    end
    assert cli_parser(Config.new).parse(["--ssl-min-version", "1.1"]) == "Invalid TLS version \"1.1\": must be 1.2 or 1.3."
    missing = __DIR__ + "/testdata/no-such.pem"
    assert cli_parser(Config.new).parse(["-s", "--ssl-key-file", key, "--ssl-cert-file", cert, "--ssl-client-ca", missing]) == "SSL configuration error: cannot read the SSL client CA file " + missing + "."
    not_pem = cli_parser(Config.new).parse(["-s", "--ssl-key-file", key, "--ssl-cert-file", cert, "--ssl-client-ca", key])
    assert (not_pem || "").starts_with?("SSL configuration error: the SSL client CA file " + key + ": ")
    # Without -s, as the other file flags.
    plain = Config.new
    assert cli_parser(plain).parse(["--ssl-client-ca", roots]).nil?
    assert plain.ssl.nil?
  end

  it "notices help and leaves plain arguments and everything after -- alone" do
    parser = cli_parser(Config.new)
    assert parser.parse(["serve", "-h", "--", "--nope"]).nil?
    assert parser.help?
    assert parser.usage.includes?("-p PORT, --port PORT")
    assert parser.usage.includes?("-h, --help")
  end

  it "runs an application's own flags" do
    seen = [] of String
    parser = cli_parser(Config.new)
    parser.on("-j COUNT", "--jobs COUNT", "Job count") { |value| seen << value }
    parser.on("--verbose", "Log more") { |value| seen << "verbose" }
    assert parser.parse(["--jobs", "4", "--verbose"]).nil?
    assert seen == ["4", "verbose"]
    assert parser.parse(["--verbose=1"]) == "Option --verbose takes no value"
    assert parser.usage.includes?("-j COUNT, --jobs COUNT")
  end

  it "sets how many threads serve with -w, the cores unless it is given" do
    cfg = Config.new
    assert cfg.workers == IyiWorkers.count
    assert cli_parser(cfg).parse(["-w", "1"]).nil?
    assert cfg.workers == 1
    assert cli_parser(cfg).parse(["--workers=6"]).nil?
    assert cfg.workers == 6
    assert cli_parser(cfg).parse(["-w", "0"]) == "Invalid workers \"0\": must be a whole number, 1 or more."
    assert cli_parser(cfg).parse(["-w", "many"]) == "Invalid workers \"many\": must be a whole number, 1 or more."
    assert cfg.workers == 6
    assert cli_parser(cfg).usage.includes?("-w WORKERS, --workers WORKERS")
  end
end
