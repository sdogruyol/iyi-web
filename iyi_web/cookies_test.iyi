# Cookie header parsing. Setting cookies lives on Context.
module iyi_web/cookies_test

import iyi_web/cookies::{CookieJar}
import iyi_web/spec::*

describe "CookieJar" do
  it "treats an empty header as an empty jar" do
    assert CookieJar.parse("").empty?
  end

  it "splits name/value pairs on semicolon" do
    jar = CookieJar.parse("session=abc; theme=dark")
    assert jar["session"] == "abc"
    assert jar["theme"] == "dark"
    assert jar.has_key?("session")
    assert !jar.has_key?("missing")
    assert jar["nope"]?.nil?
  end

  it "trims spaces around names and values" do
    jar = CookieJar.parse(" a = 1 ; b=2 ")
    assert jar["a"] == "1"
    assert jar["b"] == "2"
  end

  it "treats plus as space in a cookie value" do
    assert CookieJar.parse("msg=hello+world")["msg"] == "hello world"
  end
end
