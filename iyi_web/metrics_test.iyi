# Metrics: the exposition page line for line after a few requests - the
# route label the pattern, histogram buckets cumulative up to `+Inf`, the
# in-flight gauge - and the registry's own counters, gauges, histograms,
# name checks and escaping.
module iyi_web/metrics_test

import iyi_web/metrics::*
import iyi_web/handler::{Handler, chain}
import iyi_web/harness::*
import iyi_web/spec::*

def app(handler : MetricsHandler, registry : MetricsRegistry) : Handler
  chain([handler, routes { |r|
    r.get "/users/:id" do |env|
      "user " + env.params.url["id"]
    end
    r.post "/users" do |env|
      env.response.status_code = 201
      "made"
    end
    r.get "/slow" do |env|
      sleep(150)
      "slow"
    end
    r.get "/busy" do |env|
      found = registry["http_requests_in_flight"]
      found ? found.value.to_s : "none"
    end
  }])
end

def lines(text : String) : Array(String)
  text.split("\n").reject(&.empty?)
end

describe "MetricsHandler" do
  it "exposes requests by route pattern, cumulative buckets and +Inf" do
    registry = MetricsRegistry.new
    handler = MetricsHandler.new(registry, buckets: [0.1, 1.0])
    handler_app = app(handler, registry)
    dispatch(handler_app, "GET", "/users/1")
    dispatch(handler_app, "GET", "/users/2")
    dispatch(handler_app, "POST", "/users")
    dispatch(handler_app, "GET", "/missing")
    dispatch(handler_app, "GET", "/slow")
    page = dispatch(handler_app, "GET", "/metrics")
    assert_eq "text/plain; version=0.0.4; charset=utf-8", page.response.headers["Content-Type"]
    got = lines(page.response.body)

    assert_eq [
      "# HELP http_requests_total HTTP requests answered, by method, route pattern and status.",
      "# TYPE http_requests_total counter",
      "http_requests_total{method=\"GET\",route=\"/slow\",status=\"200\"} 1",
      "http_requests_total{method=\"GET\",route=\"/users/:id\",status=\"200\"} 2",
      "http_requests_total{method=\"GET\",route=\"unrouted\",status=\"404\"} 1",
      "http_requests_total{method=\"POST\",route=\"/users\",status=\"201\"} 1",
      "# HELP http_request_duration_seconds Time from the request reaching this handler to the response being ready, by method and route pattern.",
      "# TYPE http_request_duration_seconds histogram",
    ], got[0, 8]

    slow = got.select(&.includes?("route=\"/slow\""))
    assert_eq "http_request_duration_seconds_bucket{method=\"GET\",route=\"/slow\",le=\"0.1\"} 0", slow[1]
    assert_eq "http_request_duration_seconds_bucket{method=\"GET\",route=\"/slow\",le=\"1\"} 1", slow[2]
    assert_eq "http_request_duration_seconds_bucket{method=\"GET\",route=\"/slow\",le=\"+Inf\"} 1", slow[3]
    assert slow[4].starts_with?("http_request_duration_seconds_sum{method=\"GET\",route=\"/slow\"} 0.1"), slow[4]
    assert_eq "http_request_duration_seconds_count{method=\"GET\",route=\"/slow\"} 1", slow[5]

    users = got.select { |line| line.starts_with?("http_request_duration_seconds") && line.includes?("route=\"/users/:id\"") }
    assert_eq [
      "http_request_duration_seconds_bucket{method=\"GET\",route=\"/users/:id\",le=\"0.1\"} 2",
      "http_request_duration_seconds_bucket{method=\"GET\",route=\"/users/:id\",le=\"1\"} 2",
      "http_request_duration_seconds_bucket{method=\"GET\",route=\"/users/:id\",le=\"+Inf\"} 2",
    ], users[0, 3]
    assert_eq "http_request_duration_seconds_count{method=\"GET\",route=\"/users/:id\"} 2", users[4]

    assert_eq [
      "# HELP http_requests_in_flight HTTP requests being handled now.",
      "# TYPE http_requests_in_flight gauge",
      "http_requests_in_flight 0",
    ], got[got.size - 3, 3]
    # The scrape itself is not counted.
    assert !page.response.body.includes?("/metrics")
  end

  it "counts a request in flight while it runs" do
    registry = MetricsRegistry.new
    handler_app = app(MetricsHandler.new(registry), registry)
    assert_eq "1.0", dispatch(handler_app, "GET", "/busy").response.body
    found = registry["http_requests_in_flight"]
    assert_eq 0.0, found ? found.value : -1.0
  end

  it "leaves out what only and exclude say it is not for" do
    registry = MetricsRegistry.new
    handler = MetricsHandler.new(registry)
    handler.exclude(["/users/*"])
    handler_app = app(handler, registry)
    dispatch(handler_app, "GET", "/users/1")
    dispatch(handler_app, "POST", "/users")
    body = dispatch(handler_app, "GET", "/metrics").response.body
    assert !body.includes?("route=\"/users/:id\""), body
    assert_includes body, "http_requests_total{method=\"POST\",route=\"/users\",status=\"201\"} 1"
  end

  it "serves the page at the path it is given" do
    registry = MetricsRegistry.new
    handler_app = app(MetricsHandler.new(registry, path: "/internal/metrics"), registry)
    assert_includes dispatch(handler_app, "GET", "/internal/metrics").response.body, "# TYPE http_requests_total counter"
    assert_eq 404, dispatch(handler_app, "GET", "/metrics").response.status_code
  end
end

describe "MetricsRegistry" do
  it "writes counters, gauges and histograms an application registers" do
    registry = MetricsRegistry.new
    jobs = registry.counter("jobs_total", "Jobs run.", ["queue"])
    jobs.inc(["mail"])
    jobs.inc(["mail"], 2.0)
    jobs.inc(["sms"])
    temperature = registry.gauge("room_celsius", "Room temperature.")
    temperature.set(21.5)
    temperature.dec(by: 0.5)
    sizes = registry.histogram("upload_bytes", "Upload sizes.", buckets: [100.0, 1000.0])
    sizes.observe(50.0)
    sizes.observe(100.0)
    sizes.observe(5000.0)
    assert_eq [
      "# HELP jobs_total Jobs run.",
      "# TYPE jobs_total counter",
      "jobs_total{queue=\"mail\"} 3",
      "jobs_total{queue=\"sms\"} 1",
      "# HELP room_celsius Room temperature.",
      "# TYPE room_celsius gauge",
      "room_celsius 21",
      "# HELP upload_bytes Upload sizes.",
      "# TYPE upload_bytes histogram",
      "upload_bytes_bucket{le=\"100\"} 2",
      "upload_bytes_bucket{le=\"1000\"} 2",
      "upload_bytes_bucket{le=\"+Inf\"} 3",
      "upload_bytes_sum 5150",
      "upload_bytes_count 3",
    ], lines(registry.expose)
    assert_eq 3.0, jobs.value(["mail"])
  end

  it "shows a family without labels at 0 before anything is counted" do
    registry = MetricsRegistry.new
    registry.counter("starts_total", "Starts.")
    assert_eq ["# HELP starts_total Starts.", "# TYPE starts_total counter", "starts_total 0"], lines(registry.expose)
  end

  it "escapes label values and help text" do
    registry = MetricsRegistry.new
    odd = registry.counter("odd_total", "Line one\nback\\slash.", ["path"])
    odd.inc(["a\"b\\c\nd"])
    assert_eq [
      "# HELP odd_total Line one\\nback\\\\slash.",
      "# TYPE odd_total counter",
      "odd_total{path=\"a\\\"b\\\\c\\nd\"} 1",
    ], lines(registry.expose)
  end

  it "answers the family already registered, and refuses a clash" do
    registry = MetricsRegistry.new
    first = registry.counter("hits_total", "Hits.", ["page"])
    again = registry.counter("hits_total", "Hits.", ["page"])
    first.inc(["a"])
    again.inc(["a"])
    assert_eq 2.0, first.value(["a"])
    assert panics? { registry.gauge("hits_total", "Hits.", ["page"]) }
    assert panics? { registry.counter("hits_total", "Hits.", ["other"]) }
  end

  it "refuses bad names, the wrong label count, a falling counter and unsorted buckets" do
    registry = MetricsRegistry.new
    assert panics? { registry.counter("2fast", "x") }
    assert panics? { registry.counter("ok_total", "x", ["__reserved"]) }
    assert panics? { registry.histogram("h", "x", ["le"]) }
    assert panics? { registry.histogram("h2", "x", buckets: [1.0, 1.0]) }
    labelled = registry.counter("l_total", "x", ["a", "b"])
    assert panics? { labelled.inc(["only one"]) }
    assert panics? { labelled.inc(["a", "b"], -1.0) }
    assert metric_name?("http:requests_total")
    assert !label_name?("le-x")
  end

  it "formats numbers as Prometheus reads them" do
    assert_eq "3", format_number(3.0)
    assert_eq "0.005", format_number(0.005)
    assert_eq "+Inf", format_number(1.0 / 0.0)
    assert_eq "-Inf", format_number(-1.0 / 0.0)
    assert_eq "NaN", format_number(0.0 / 0.0)
  end

  it "loses no count when every worker counts at once" do
    registry = MetricsRegistry.new
    hits = registry.counter("par_total", "x", ["w"])
    group do |g|
      8.times do
        g.spawn(unit: :new) do
          500.times { hits.inc(["same"]) }
          0
        end
      end
    end
    assert_eq 4000.0, hits.value(["same"])
  end
end

describe "MetricsRegistry#gauge_function" do
  it "reads its value when the page is written" do
    registry = MetricsRegistry.new
    queued = Atomic(Int32).new(3)
    registry.gauge_function("queue_length", "Jobs waiting.") { queued.get.to_f64 }
    queued.add(2)
    assert_eq ["# HELP queue_length Jobs waiting.", "# TYPE queue_length gauge", "queue_length 5"], lines(registry.expose)
    assert panics? { registry.gauge_function("queue_length", "again") { 0.0 } }
  end
end
