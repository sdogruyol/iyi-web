# The writable half of a request: status, headers, body, and the `close`
# flag `halt` sets so the rest of the chain writes nothing.
#
# A response is buffered and sent whole once the chain has run, unless the
# handler calls `flush`. The first `flush` sends the status line and the
# headers, then everything printed so far; each later one sends what was
# printed since. How the pieces are framed is the server's (std/http's):
# chunked on HTTP/1.1 unless the handler set `Content-Length`, to the
# close on HTTP/1.0, DATA frames on HTTP/2. Headers changed after the
# first `flush` are not sent.
module iyi_web/response

import std/socket::{IyiSocket}
import std/http::{TlsStream}
import iyi_web/headers::{Headers}
import iyi_web/status::*

pub class Response
  @status_code : Int32
  @headers : Headers
  @body : String
  @closed : Bool
  @content_type : String
  @sink : Proc(String, Nil)?
  @head : Bool
  @headers_sent : Bool
  @upgrade : Proc(IyiSocket | TlsStream, String, Nil)?

  def initialize
    @status_code = 200
    @headers = Headers.new
    @body = ""
    @closed = false
    @content_type = "text/html; charset=utf-8"
    @sink = nil
    @head = false
    @headers_sent = false
    @upgrade = nil
  end

  pub def status_code : Int32
    @status_code
  end

  pub def status_code=(code : Int32) : Int32
    @status_code = code
  end

  pub def headers : Headers
    @headers
  end

  pub def body : String
    @body
  end

  pub def closed? : Bool
    @closed
  end

  pub def close : Nil
    @closed = true
  end

  pub def content_type : String
    @content_type
  end

  pub def content_type=(value : String) : String
    @content_type = value
    @headers["Content-Type"] = value
    value
  end

  pub def print(text : String) : Nil
    @body = @body + text
  end

  pub def write(text : String) : Nil
    print(text)
  end

  pub def set_body(text : String) : Nil
    @body = text
  end

  # A fresh 200 with no headers and no body, for a response that has to be
  # rebuilt after its handler failed part-way through writing it.
  pub def reset : Nil
    @status_code = 200
    @headers = Headers.new
    @body = ""
    @closed = false
    @content_type = "text/html; charset=utf-8"
    @upgrade = nil
  end

  # True once `flush` has sent the status line and headers.
  pub def headers_sent? : Bool
    @headers_sent
  end

  # Where `flush` sends the body, and whether the request was a HEAD,
  # whose flushes send the headers alone. The server attaches this before
  # the chain runs; without it `flush` keeps buffering. *sink* is called
  # once per flush with what was printed since the last one - "" on a
  # first flush with nothing printed, which is the headers going out on
  # their own - and the first call is the moment the status and headers
  # are final.
  pub def attach(sink : Proc(String, Nil), head : Bool) : Nil
    @sink = sink
    @head = head
  end

  # Sends what has been printed so far and keeps the response open.
  pub def flush : Nil
    sink = @sink
    return unless sink
    first = !@headers_sent
    @headers_sent = true
    if @head || no_entity?
      @body = ""
      sink.call("") if first
      return
    end
    return if @body.empty? && !first
    piece = @body
    @body = ""
    sink.call(piece)
  end

  # Ends a flushed response: what was printed after the last `flush`
  # goes out; the server ends the body once the chain has returned.
  pub def finish : Nil
    flush
  end

  # The response whole, as HTTP/1.1 carries a buffered one: what a test
  # reads to see the bytes a client would. `Content-Length` is written
  # for every status that can carry a body; a handler that already set
  # one is left alone. HEAD omits the body (RFC 9110 §9.3.2) but keeps
  # the length a GET of the same resource would have advertised. 1xx, 204
  # and 304 carry neither a body nor a Content-Type. The server writes
  # through std/http instead, which frames the same answer for HTTP/1.1
  # and HTTP/2 alike.
  pub def to_http(version : String, include_body : Bool = true) : String
    no_entity = no_entity?
    unless @headers.has_key?("Content-Type") || no_entity
      @headers["Content-Type"] = @content_type
    end

    # RFC 9110 §8.6: no Content-Length on 1xx or 204; a 304 keeps one only
    # when the handler set it to the selected representation's length.
    unless @headers.has_key?("Content-Length") || no_entity
      @headers["Content-Length"] = @body.bytesize.to_s
    end

    reason = phrase(@status_code)
    payload = include_body && !no_entity ? @body : ""
    version + " " + @status_code.to_s + " " + reason + "\r\n" + @headers.to_s + "\r\n" + payload
  end

  # Takes the connection over once this response - a 101 - is out. The
  # server writes the status line and headers, then calls *block* with the
  # connection - the socket, or under TLS the `TlsStream` over it - and
  # whatever the client sent after the request, and the connection carries
  # no more HTTP. How a WebSocket starts.
  pub def upgrade(&block : (IyiSocket | TlsStream, String) -> Nil) : Nil
    @upgrade = block
  end

  pub def upgrade_handler : Proc(IyiSocket | TlsStream, String, Nil)?
    @upgrade
  end

  # 1xx, 204 and 304 carry no body (RFC 9110 §6.4.1).
  pub def no_entity? : Bool
    @status_code == 204 || @status_code == 304 || (@status_code >= 100 && @status_code < 200)
  end
end
