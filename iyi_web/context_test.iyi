# halt and redirect close the response and stop the chain; the store
# is a string bag a middleware can write for a later handler.
module iyi_web/context_test

import iyi_web/context
import iyi_web/harness
import iyi_web/spec

using iyi_web/context::{Context}
using iyi_web/harness
using iyi_web/spec

def env : Context
  Context.for(http_request("GET", "/"))
end

describe "Context" do
  it "starts open with the request and an empty store" do
    ctx = env
    assert !ctx.halted?
    assert ctx.request.path == "/"
    assert ctx.response.status_code == 200
    assert ctx["missing"]?.nil?
  end

  it "reads and overwrites string store values" do
    ctx = env
    ctx["user"] = "ada"
    assert ctx["user"] == "ada"
    assert ctx["user"]? == "ada"
    ctx["user"] = "grace"
    assert ctx["user"] == "grace"
  end

  it "carries url params given at construction" do
    url = {} of String => String
    url["id"] = "7"
    ctx = Context.for(http_request("GET", "/"), url)
    assert ctx.params.url["id"] == "7"
  end
end

describe "Context#halt" do
  it "sets status and body and closes the response" do
    ctx = env
    ctx.halt(401, "no")
    assert ctx.halted?
    assert ctx.response.status_code == 401
    assert ctx.response.body == "no"
    assert ctx.response.closed?
  end

  it "defaults to 200 and an empty body" do
    ctx = env
    ctx.halt
    assert ctx.response.status_code == 200
    assert ctx.response.body == ""
  end
end

describe "Context#redirect" do
  it "halts with 302 and a Location header" do
    ctx = env
    ctx.redirect("/there")
    assert ctx.halted?
    assert ctx.response.status_code == 302
    assert ctx.response.headers["location"] == "/there"
    assert ctx.response.closed?
  end

  it "accepts a status override" do
    ctx = env
    ctx.redirect("/new", 301)
    assert ctx.response.status_code == 301
  end
end

describe "Context cookies" do
  it "starts empty without a Cookie header" do
    assert env.cookies.empty?
  end

  it "parses the request Cookie header" do
    headed = http_request("GET", "/")
    headed.headers["Cookie"] = "session=abc; theme=dark"
    ctx = Context.for(headed)
    assert ctx.cookies["session"] == "abc"
    assert ctx.cookies["theme"] == "dark"
  end

  it "writes Set-Cookie, including Secure, Max-Age and SameSite" do
    ctx = env
    ctx.set_cookie("sid", "1")
    ctx.set_cookie("x", "y", "/", true)
    written = ctx.response.headers.to_s
    assert written.includes?("Set-Cookie: sid=1; Path=/\r\n")
    assert written.includes?("Set-Cookie: x=y; Path=/; HttpOnly\r\n")

    secure = env
    secure.set_cookie("sid", "1", "/", true, true, 60, "Lax")
    assert secure.response.headers.to_s.includes?("Secure")
    assert secure.response.headers.to_s.includes?("Max-Age=60")
    assert secure.response.headers.to_s.includes?("SameSite=Lax")
  end
end

describe "Context helpers" do
  it "chains status and html" do
    ctx = env
    ctx.status(201).html("<p>hi</p>")
    assert ctx.response.status_code == 201
    assert ctx.response.content_type == "text/html; charset=utf-8"
    assert ctx.response.body == "<p>hi</p>"
  end

  it "send_file attaches the file with a filename disposition" do
    ctx = env
    ctx.send_file(__DIR__ + "/fixtures/hello.txt", "", "hello.txt")
    assert ctx.response.headers["content-disposition"] == "attachment; filename=\"hello.txt\""
    assert ctx.response.body == File.read(__DIR__ + "/fixtures/hello.txt")
    assert ctx.response.content_type == "text/plain; charset=utf-8"
    assert ctx.response.headers["x-content-type-options"] == "nosniff"
  end

  it "send_file of a missing path is a halted 404" do
    ctx = env
    ctx.send_file(__DIR__ + "/fixtures/no-such.txt")
    assert ctx.response.status_code == 404
    assert ctx.halted?
  end
end
