# halt and redirect close the response and stop the chain; the store
# is a string bag a middleware can write for a later handler.
module iyi_web/context_test

import iyi_web/context
import iyi_web/harness

using iyi_web/context::{Context}
using iyi_web/harness

ctx = Context.for(http_request("GET", "/"))
assert !ctx.halted?, "fresh context"
assert ctx.request.path == "/", "request"
assert ctx.response.status_code == 200, "default status"
assert ctx["missing"]?.nil?, "empty store"

ctx["user"] = "ada"
assert ctx["user"] == "ada", "store read"
assert ctx["user"]? == "ada", "store []?"

halted = Context.for(http_request("GET", "/"))
halted.halt(401, "no")
assert halted.halted?, "halted"
assert halted.response.status_code == 401, "halt status"
assert halted.response.body == "no", "halt body"
assert halted.response.closed?, "halt closes"

redirected = Context.for(http_request("GET", "/"))
redirected.redirect("/there")
assert redirected.halted?, "redirect halted"
assert redirected.response.status_code == 302, "redirect default 302"
assert redirected.response.headers["location"] == "/there", "Location"
assert redirected.response.closed?, "redirect closes"

quiet = Context.for(http_request("GET", "/"))
quiet.halt
assert quiet.response.status_code == 200, "halt defaults to 200"
assert quiet.response.body == "", "halt defaults to empty body"

moved = Context.for(http_request("GET", "/"))
moved.redirect("/new", 301)
assert moved.response.status_code == 301, "redirect status override"

ctx["user"] = "grace"
assert ctx["user"] == "grace", "store overwrite"

url = {} of String => String
url["id"] = "7"
with_url = Context.for(http_request("GET", "/"), url)
assert with_url.params.url["id"] == "7", "url params on construct"

puts "context_test ok"
