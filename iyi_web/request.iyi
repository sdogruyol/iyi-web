# An HTTP/1.1 request as a value: method, path, query, headers, body.
#
# The bytes come from `std/http`'s parser. This type is what a handler
# mutates — `_method` override, a content-type chop — so it is a class
# this module owns rather than `std/http`'s struct.
module iyi_web/request

import std/http
import std/text
import iyi_web/codec
import iyi_web/headers

using std/http::{HTTP, Server}
using iyi_web/codec
using iyi_web/headers::{Headers}

pub struct ParseError
  getter message : String

  def initialize(@message : String)
  end
end

impl Error for ParseError
  def message : String
    @message
  end
end

pub class Request
  def initialize(@method : String, @path : String, @query_string : String, @version : String, @headers : Headers, @body : String)
  end

  # `std/http`'s request as this type: path percent-decoded, query left
  # encoded, headers in the case-insensitive table a handler writes.
  def self.from_http(method : String, path : String, query : String?, headers : Hash(String, String), body : String, version : String = "HTTP/1.1") : Request
    table = Headers.new
    headers.each { |name, value| table[name] = value }

    raw = path == "*" || path.empty? ? "/" : path
    decoded = decode_path(raw)
    Request.new(method, decoded.empty? ? "/" : decoded, query ? query : "", version, table, body)
  end

  pub def method : String
    @method
  end

  pub def method=(value : String) : String
    @method = value
  end

  pub def path : String
    @path
  end

  pub def query_string : String
    @query_string
  end

  pub def version : String
    @version
  end

  pub def headers : Headers
    @headers
  end

  pub def body : String
    @body
  end

  pub def content_type : String
    header = @headers["content-type"]?
    return "" unless header
    semi = header.index(';')
    semi ? header[0, semi].strip : header.strip
  end

  pub def content_length : Int32
    raw = @headers["content-length"]?
    return 0 unless raw
    raw.to_i? || 0
  end

  pub def keep_alive? : Bool
    conn = @headers["connection"]?
    if conn
      lowered = conn.downcase
      return false if lowered == "close"
      return true if lowered == "keep-alive"
    end
    @version == "HTTP/1.1"
  end

  pub def host : String
    @headers["host"]? || ""
  end
end

# One pass of `std/http`'s parser: a request, a refusal, or "not yet".
pub struct Incoming
  getter request : Request?
  getter error : String?
  getter close : Bool
  getter consumed : Int32

  def initialize(@request : Request?, @error : String?, @close : Bool, @consumed : Int32)
  end
end

# Split a request-target into path and query, percent-decoding the path.
# The query is left encoded; `parse_query` is what turns it into a table,
# and form bodies share that function.
pub def split_target(target : String) : Tuple(String, String)
  q = target.index('?')
  if q
    path = decode_path(target[0, q])
    query = target[q + 1, target.bytesize - q - 1]
    {path.empty? ? "/" : path, query}
  else
    path = decode_path(target)
    {path.empty? ? "/" : path, ""}
  end
end

# A complete request off the wire, or why not. Headers-only text is
# completed with a blank line so a unit test can share the parser the
# server uses.
pub def parse_head(block : String) : Request | ParseError
  text = block.includes?("\r\n\r\n") ? block : block + "\r\n\r\n"
  incoming = parse_incoming(text)
  if req = incoming.request
    req
  elsif err = incoming.error
    ParseError.new(err)
  else
    ParseError.new("incomplete request")
  end
end

pub def parse_incoming(text : String) : Incoming
  parsed = Server.parse_request(text)
  if req = parsed.request
    Incoming.new(Request.from_http(req.method, req.path, req.query, req.headers, req.body, wire_version(text)), nil, parsed.close, parsed.consumed)
  else
    Incoming.new(nil, parsed.error, parsed.close, parsed.consumed)
  end
end

pub def with_body(request : Request, body : String) : Request
  Request.new(request.method, request.path, request.query_string, request.version, request.headers, body)
end

private def wire_version(text : String) : String
  lines = HTTP.split_crlf(text)
  return "HTTP/1.1" if lines.empty?
  line = lines[0]
  sp = line.rindex(" ")
  sp ? line[sp + 1, line.bytesize - sp - 1] : "HTTP/1.1"
end
