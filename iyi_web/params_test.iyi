# URL, query and form tables, and the combined lookup that prefers the
# most specific: url, then query, then body.
module iyi_web/params_test

import iyi_web/params
import iyi_web/request
import iyi_web/headers
import iyi_web/spec

using iyi_web/params::{Params}
using iyi_web/request::{Request}
using iyi_web/headers::{Headers}
using iyi_web/spec

describe "Params" do
  it "starts with empty tables" do
    empty = Params.empty
    assert empty.url.empty?
    assert empty.query.empty?
    assert empty.body.empty?
    assert !empty.has_key?("id")
  end

  it "fills url, query and form tables from the request" do
    headers = Headers.new
    headers["Host"] = "localhost"
    headers["Content-Type"] = "application/x-www-form-urlencoded; charset=utf-8"
    req = Request.new("POST", "/users", "q=from-query&id=query-id", "HTTP/1.1", headers, "name=iyi&id=body-id")
    url = {"id" => "url-id"}
    params = Params.from(req, url)

    assert params.url["id"] == "url-id"
    assert params.query["q"] == "from-query"
    assert params.query["id"] == "query-id"
    assert params.body["name"] == "iyi"
    assert params.body["id"] == "body-id"
  end

  it "treats plus as space in a form body" do
    headers = Headers.new
    headers["Content-Type"] = "application/x-www-form-urlencoded"
    req = Request.new("POST", "/", "", "HTTP/1.1", headers, "msg=hello+world")
    params = Params.from(req, {} of String => String)
    assert params.body["msg"] == "hello world"
  end

  it "looks up url, then query, then body" do
    headers = Headers.new
    headers["Content-Type"] = "application/x-www-form-urlencoded"
    req = Request.new("POST", "/users", "q=from-query&id=query-id", "HTTP/1.1", headers, "name=iyi&id=body-id")
    params = Params.from(req, {"id" => "url-id"})

    assert params["id"] == "url-id"
    assert params["q"] == "from-query"
    assert params["name"] == "iyi"
    assert params.has_key?("name")
    assert !params.has_key?("missing")
    assert params["nope"]?.nil?
  end

  it "does not parse a JSON or untyped body as a form" do
    json_headers = Headers.new
    json_headers["Content-Type"] = "application/json"
    json_req = Request.new("POST", "/", "", "HTTP/1.1", json_headers, "{\"a\":1}")
    assert Params.from(json_req, {} of String => String).body.empty?

    plain = Params.from(Request.new("POST", "/", "", "HTTP/1.1", Headers.new, "a=1"), {} of String => String)
    assert plain.body.empty?
  end

  it "replaces the url table on update_url" do
    params = Params.empty
    params.update_url({"id" => "next"})
    assert params.url["id"] == "next"
  end
end
