# Request logging must not swallow the route's body or status.
module iyi_web/log_test

import iyi_web/log
import iyi_web/handler
import iyi_web/harness
import iyi_web/spec

using iyi_web/log::{LogHandler}
using iyi_web/handler::{chain}
using iyi_web/harness
using iyi_web/spec

describe "LogHandler" do
  it "preserves the route's status and body" do
    handler = chain([LogHandler.new, routes { |r|
      r.get "/log" do |env|
        env.response.status_code = 201
        "logged"
      end
    }])
    ctx = dispatch(handler, "GET", "/log")
    assert ctx.response.status_code == 201
    assert ctx.response.body == "logged"
  end
end
