# Application settings. A value, not a pile of class variables: the
# original's `Config::INSTANCE` and the five arrays beside it were why
# tests had to `clear` the world between examples. The DSL still has one
# process-wide config, because that is the Sinatra contract; it is this
# object rather than a handful of globals.
module iyi_web/config

import std/file::{File}
import iyi_web/handler::{Handler}
import iyi_web/context::{Context}
import iyi_web/log::{Logger, StdoutLogger}

# Called for every file the static handler serves, before its body is
# written: the context, the file's path and its `File::Info`.
pub alias StaticHeadersHook = Proc(Context, String, File::Info, Nil)

pub class Config
  @app_name : String
  @host : String
  @port : Int32
  @env : String
  @public_folder : String
  @logging : Bool
  @logger : Logger
  @running : Bool
  @serve_static : Bool
  @powered_by_header : Bool
  @keepalive : Bool
  @max_keepalive_requests : Int32
  @max_request_body_size : Int32
  @custom_handlers : Array(Handler)
  @positioned_handlers : Array(Tuple(Int32, Handler))
  @shutdown_message : Bool
  @show_exceptions : Bool?
  @max_file_uploads : Int32
  @max_multipart_form_field_size : Int32
  @max_ranges : Int32
  @static_dir_index : Bool
  @static_dir_listing : Bool
  @static_gzip : Bool
  @static_headers : StaticHeadersHook?

  def initialize
    @app_name = "iyi-web"
    @host = "0.0.0.0"
    @port = 3000
    env = Program.env("IYI_WEB_ENV")
    @env = env ? env : "development"
    port_env = Program.env("PORT")
    parsed = port_env ? port_env.to_i? : nil
    @port = parsed ? parsed : 3000
    @public_folder = "./public"
    @logging = true
    @logger = StdoutLogger.new
    @running = false
    @serve_static = true
    @powered_by_header = false
    @keepalive = true
    @max_keepalive_requests = 100
    @max_request_body_size = 8 * 1024 * 1024
    @custom_handlers = [] of Handler
    @positioned_handlers = [] of Tuple(Int32, Handler)
    @shutdown_message = true
    @show_exceptions = nil
    @max_file_uploads = 128
    @max_multipart_form_field_size = 8 * 1024 * 1024
    @max_ranges = 16
    @static_dir_index = true
    @static_dir_listing = false
    @static_gzip = true
    @static_headers = nil
  end

  pub def app_name : String
    @app_name
  end

  pub def app_name=(value : String) : String
    @app_name = value
  end

  pub def host : String
    @host
  end

  pub def host=(value : String) : String
    @host = value
  end

  pub def port : Int32
    @port
  end

  pub def port=(value : Int32) : Int32
    @port = value
  end

  pub def env : String
    @env
  end

  pub def env=(value : String) : String
    @env = value
  end

  pub def public_folder : String
    @public_folder
  end

  pub def public_folder=(value : String) : String
    @public_folder = value
  end

  pub def logging : Bool
    @logging
  end

  pub def logging=(value : Bool) : Bool
    @logging = value
  end

  # Where request lines and `log` messages go while `logging` is on.
  pub def logger : Logger
    @logger
  end

  pub def logger=(value : Logger) : Logger
    @logger = value
  end

  pub def running : Bool
    @running
  end

  pub def running=(value : Bool) : Bool
    @running = value
  end

  pub def serve_static : Bool
    @serve_static
  end

  pub def serve_static=(value : Bool) : Bool
    @serve_static = value
  end

  pub def powered_by_header : Bool
    @powered_by_header
  end

  pub def powered_by_header=(value : Bool) : Bool
    @powered_by_header = value
  end

  pub def keepalive : Bool
    @keepalive
  end

  pub def keepalive=(value : Bool) : Bool
    @keepalive = value
  end

  pub def max_keepalive_requests : Int32
    @max_keepalive_requests
  end

  pub def max_keepalive_requests=(value : Int32) : Int32
    @max_keepalive_requests = value
  end

  pub def max_request_body_size : Int32
    @max_request_body_size
  end

  pub def max_request_body_size=(value : Int32) : Int32
    @max_request_body_size = value
  end

  pub def shutdown_message : Bool
    @shutdown_message
  end

  pub def custom_handlers : Array(Handler)
    @custom_handlers
  end

  pub def add_handler(handler : Handler) : Nil
    @custom_handlers << handler
  end

  # *position* is the handler's index in the final chain, counted before
  # the router, which always stays last.
  pub def add_handler(handler : Handler, position : Int32) : Nil
    @positioned_handlers << {position, handler}
  end

  pub def positioned_handlers : Array(Tuple(Int32, Handler))
    @positioned_handlers
  end

  pub def max_file_uploads : Int32
    @max_file_uploads
  end

  pub def max_file_uploads=(value : Int32) : Int32
    @max_file_uploads = value
  end

  pub def max_multipart_form_field_size : Int32
    @max_multipart_form_field_size
  end

  pub def max_multipart_form_field_size=(value : Int32) : Int32
    @max_multipart_form_field_size = value
  end

  # 0 turns `Range` support off.
  pub def max_ranges : Int32
    @max_ranges
  end

  pub def max_ranges=(value : Int32) : Int32
    @max_ranges = value
  end

  pub def static_dir_index : Bool
    @static_dir_index
  end

  pub def static_dir_index=(value : Bool) : Bool
    @static_dir_index = value
  end

  pub def static_dir_listing : Bool
    @static_dir_listing
  end

  pub def static_dir_listing=(value : Bool) : Bool
    @static_dir_listing = value
  end

  pub def static_gzip : Bool
    @static_gzip
  end

  pub def static_gzip=(value : Bool) : Bool
    @static_gzip = value
  end

  pub def static_headers : StaticHeadersHook?
    @static_headers
  end

  pub def static_headers=(hook : StaticHeadersHook) : StaticHeadersHook
    @static_headers = hook
    hook
  end

  pub def development? : Bool
    @env == "development"
  end

  # Whether a panic's message reaches the client on the 500 page. Unset, it
  # follows the environment: shown in development, hidden everywhere else.
  pub def show_exceptions? : Bool
    explicit = @show_exceptions
    explicit.nil? ? development? : explicit
  end

  pub def show_exceptions=(value : Bool) : Bool
    @show_exceptions = value
    value
  end
end

INSTANCE = Config.new

pub def config : Config
  INSTANCE
end

pub def add_handler(handler : Handler) : Nil
  INSTANCE.add_handler(handler)
end
