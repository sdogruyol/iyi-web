# Request logging. One line per request, after the handler has run, so the
# status is the one that was actually sent.
module iyi_web/log

import iyi_web/handler
import iyi_web/context
import std/time

using iyi_web/handler::{Handler}
using iyi_web/context::{Context}
using std/time::{Time, Span}

pub class LogHandler < Handler
  pub def call(ctx : Context) : Nil
    started = Time.monotonic
    call_next(ctx)
    puts request_log_line(ctx.request.method, ctx.request.path, ctx.response.status_code, Time.monotonic - started)
  end
end

# The one line format, shared with the server's own line for a request
# whose handler panicked before `LogHandler` could write it.
pub def request_log_line(method : String, path : String, status : Int32, elapsed : Span) : String
  method + " " + path + " " + status.to_s + " " + elapsed.total_milliseconds.to_s + "ms"
end
