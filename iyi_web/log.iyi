# Request logging. One line per request, after the handler has run, so the
# status is the one that was actually sent.
module iyi_web/log

import iyi_web/handler
import iyi_web/context
import std/time

using iyi_web/handler::{Handler}
using iyi_web/context::{Context}
using std/time::{Time}

pub class LogHandler < Handler
  pub def call(ctx : Context) : Nil
    started = Time.monotonic
    call_next(ctx)
    elapsed = Time.monotonic - started
    puts ctx.request.method + " " + ctx.request.path + " " + ctx.response.status_code.to_s + " " + elapsed.total_milliseconds.to_s + "ms"
  end
end
