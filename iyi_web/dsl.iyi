# iyi-web's DSL, and the reason an import names what it brings into scope.
#
# The original's first line is the whole problem: "Kemal DSL is defined here
# and it's baked into global scope." `require "kemal"` injects `get` and
# `before_all` into the importing program. `import iyi_web/dsl::{get}` moves that decision to
# the consumer: the library exports names, the program says which ones it
# wants unqualified.
module iyi_web/dsl

import std/file::{File}
import std/kernel::{abort}
import iyi_web/body::{IntoBody}
import iyi_web/context::{Context}
import iyi_web/router::{Router, RouteHandler}
import iyi_web/handler::{Handler, chain}
import iyi_web/config::*
import iyi_web/log::{LogHandler}
import iyi_web/server::{Server}
import iyi_web/static::{StaticHandler}
import iyi_web/path::{PathHandler}
import iyi_web/compress::{CompressHandler}
import iyi_web/event_stream::{EventStream}
import iyi_web/cli::{CLIParser, cli_parser}
import iyi_web/templates

# Templates from `iyi_web/templates`, so `import iyi_web/dsl::*` is enough. A
# template path is relative to the file that calls `render`.
pub macro render(filename)
  ::IyiWeb::Templates.render({{ filename }})
end

pub macro render(filename, layout)
  ::IyiWeb::Templates.render({{ filename }}, {{ layout }})
end

pub macro content_for(key)
  ::IyiWeb::Templates.content_for({{ key }}) do
    {{ yield }}
  end
end

pub macro yield_content(key)
  ::IyiWeb::Templates.yield_content({{ key }})
end

HTTP_METHODS   = %w(get post put patch delete options head query)
FILTER_METHODS = %w(get post put patch delete options query)

APP = Router.new

{% for method in HTTP_METHODS %}
  pub def {{ method.id }}(path : String, &block : Context -> B) : Nil forall B : IntoBody
    APP.{{ method.id }}(path, &block)
  end
{% end %}

pub def before_all(path : String = "*", &block : Context -> B) : Nil forall B : IntoBody
  APP.before(path, &block)
end

pub def after_all(path : String = "*", &block : Context -> B) : Nil forall B : IntoBody
  APP.after(path, &block)
end

pub def before_all(paths : Array(String), &block : Context -> B) : Nil forall B : IntoBody
  APP.before(paths, &block)
end

pub def after_all(paths : Array(String), &block : Context -> B) : Nil forall B : IntoBody
  APP.after(paths, &block)
end

{% for method in FILTER_METHODS %}
  pub def before_{{ method.id }}(path : String = "*", &block : Context -> B) : Nil forall B : IntoBody
    APP.before_{{ method.id }}(path, &block)
  end

  pub def after_{{ method.id }}(path : String = "*", &block : Context -> B) : Nil forall B : IntoBody
    APP.after_{{ method.id }}(path, &block)
  end

  pub def before_{{ method.id }}(paths : Array(String), &block : Context -> B) : Nil forall B : IntoBody
    APP.before_{{ method.id }}(paths, &block)
  end

  pub def after_{{ method.id }}(paths : Array(String), &block : Context -> B) : Nil forall B : IntoBody
    APP.after_{{ method.id }}(paths, &block)
  end
{% end %}

# A GET route answering with server-sent events; see `EventStream`.
pub def sse(path : String, &block : EventStream, Context -> Nil) : Nil
  APP.sse(path, &block)
end

pub def error(status_code : Int32, &block : Context -> B) : Nil forall B : IntoBody
  APP.error(status_code, &block)
end

pub def mount(path : String, router : Router) : Nil
  APP.mount(path, router)
end

pub def mount(router : Router) : Nil
  APP.mount(router)
end

pub def app : Router
  APP
end

pub def use(handler : Handler) : Nil
  add_handler(handler)
end

# *position* is the index the handler takes in the finished chain: 0 puts
# it before request logging. The router always stays last.
pub def use(handler : Handler, position : Int32) : Nil
  config.add_handler(handler, position)
end

pub def use(path : String, handler : Handler) : Nil
  add_handler(PathHandler.new(path, handler))
end

pub def use(path : String, handlers : Array(H)) : Nil forall H
  handlers.each { |handler| add_handler(PathHandler.new(path, handler)) }
end

# `gzip true` compresses every textual response the client accepts
# compressed; see `CompressHandler`.
pub def gzip(enabled : Bool = false) : Nil
  add_handler(CompressHandler.new) if enabled
end

# Ends the request with *status_code* and *response*. The rest of the
# block still runs, but its return value is discarded.
pub def halt(env : Context, status_code : Int32 = 200, response : String = "") : Nil
  env.halt(status_code, response)
end

pub def headers(env : Context, values : Hash(String, String)) : Nil
  values.each { |name, value| env.response.headers[name] = value }
end

pub def host(value : String) : Nil
  config.host = value
end

pub def powered_by(status : Bool) : Nil
  config.powered_by_header = status
end

pub def logging(status : Bool) : Nil
  config.logging = status
end

pub def serve_static(status : Bool) : Nil
  config.serve_static = status
end

# The static handler's options, `"gzip"`, `"dir_listing"` and
# `"dir_index"`. A key left out counts as false.
pub def serve_static(options : Hash(String, Bool)) : Nil
  cfg = config
  cfg.serve_static = true
  cfg.static_gzip = options["gzip"]? || false
  cfg.static_dir_listing = options["dir_listing"]? || false
  cfg.static_dir_index = options["dir_index"]? || false
end

# Runs for every file the static handler serves, before its body is
# written: add caching or CORS headers here.
pub def static_headers(&block : Context, String, File::Info -> Nil) : Nil
  config.static_headers = block
end

pub def public_folder(path : String) : Nil
  config.public_folder = path
end

class Holder
  property server : Server?
  property extra_options : Proc(CLIParser, Nil)?

  def initialize
    @server = nil
    @extra_options = nil
  end
end

HOLDER = Holder.new

# Adds the application's own flags to the ones `run` understands.
pub def extra_options(&block : CLIParser -> Nil) : Nil
  HOLDER.extra_options = block
end

# Reads the command line (`-b HOST`, `-p PORT`, `-h` and any
# `extra_options`), then serves. A *port* given here wins over `-p`;
# `args: nil` skips the command line.
pub def run(port : Int32? = nil, args : Array(String)? = Program.args) : Nil
  if list = args
    read_arguments(list)
  end
  start(port)
end

private def read_arguments(args : Array(String)) : Nil
  parser = cli_parser(config)
  if extra = HOLDER.extra_options
    extra.call(parser)
  end
  if problem = parser.parse(args)
    abort(problem + "\n\n" + parser.usage)
  end
  if parser.help?
    puts parser.usage
    STDOUT.flush
    abort(nil, 0)
  end
end

pub def stop : Nil
  current = HOLDER.server
  raise "#{config.app_name} is already stopped" unless current
  config.running = false
  current.close
  HOLDER.server = nil
end

pub def running? : Bool
  config.running
end

# The chain `run` serves: request logging, static files, the middleware
# added with `use`, then the router. Built fresh on every call, which is
# also how a test drives the whole application without a socket.
pub def handler_chain : Handler
  cfg = config
  handlers = [] of Handler
  handlers << LogHandler.new if cfg.logging
  if cfg.serve_static
    handlers << StaticHandler.new(cfg.public_folder, cfg.static_dir_index, cfg.static_dir_listing, cfg.static_gzip, cfg.max_ranges, cfg.static_headers)
  end
  cfg.custom_handlers.each { |handler| handlers << handler }
  cfg.positioned_handlers.each { |entry| handlers = insert_at(handlers, entry[0], entry[1]) }
  handlers << RouteHandler.new(app)
  chain(handlers)
end

private def start(port : Int32 | Nil) : Nil
  cfg = config
  cfg.port = port if port

  server = Server.new(handler_chain, cfg, app.error_handlers)
  bound = server.bind(cfg.host, cfg.port)
  cfg.port = bound
  HOLDER.server = server
  cfg.running = true

  unless cfg.env == "test"
    puts "[" + cfg.env + "] " + cfg.app_name + " is ready to lead at http://" + display_host(cfg.host) + ":" + bound.to_s
    server.listen
  end
end

private def insert_at(handlers : Array(Handler), at : Int32, handler : Handler) : Array(Handler)
  index = at < 0 ? 0 : at
  placed = [] of Handler
  handlers.each_with_index do |existing, position|
    placed << handler if position == index
    placed << existing
  end
  placed << handler if index >= handlers.size
  placed
end

private def display_host(host : String) : String
  host == "0.0.0.0" ? "localhost" : host
end
