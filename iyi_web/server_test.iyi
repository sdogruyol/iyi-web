# A real TCP round-trip. Assertions read the status line, headers and body
# as frames, not as a bag of substrings. `IyiSocket` parks, so a read waits
# without `wait_readable`; closing the listener answers `Cancelled` on
# `accept` and the group ends.
module iyi_web/server_test

import std/list::{List}
import std/mutex::{Mutex}
import std/socket::{IyiSocket}
import std/http::{HTTP, HTTPClient}
import std/zstd::{Zstd}
import std/compress::{Gzip}
import iyi_web/router::{Router, RouteHandler}
import iyi_web/handler::{Handler, chain}
import iyi_web/context::{Context}
import iyi_web/server::{Server}
import iyi_web/config::*
import iyi_web/log::{Logger}
import iyi_web/harness::*
import iyi_web/spec::*

def exchange(port : Int32, request : String) : String
  client = IyiSocket.connect("127.0.0.1", port).or_panic
  client.write(request).or_panic
  buffer = ""
  loop do
    chunk = client.read(4096).or_panic
    break if chunk.empty?
    buffer = buffer + chunk
  end
  client.close
  buffer
end

def read_frame(client : IyiSocket) : String
  buffer = ""
  loop do
    size = http_frame_size(buffer)
    break if size && buffer.bytesize >= size
    chunk = client.read(4096).or_panic
    break if chunk.empty?
    buffer = buffer + chunk
  end
  size = http_frame_size(buffer)
  size && size <= buffer.bytesize ? buffer[0, size] : buffer
end

# A logger every worker may write through: its lines behind a lock.
class Collected < Logger
  @lines : Mutex(Array(String))

  def initialize
    @lines = Mutex.new { [] of String }
  end

  pub def write(message : String) : Nil
    @lines.lock { |lines| lines << message }
  end

  def lines : List(String)
    held = @lines.get { |lines| List.new(lines) }
    held.is_a?(List(String)) ? held : List.new([] of String)
  end
end

def close_request(method : String, path : String, extra : String = "") : String
  "#{method} #{path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n#{extra}\r\n"
end

# Refuses a POST it applies to, as a CSRF check refuses one without a token.
class Guard < Handler
  pub def call(ctx : Context) : Nil
    ctx.request.method == "POST" && applies?(ctx) ? ctx.halt(403, "guarded") : call_next(ctx)
  end
end

router = Router.new
router.get "/" do |env|
  "home"
end
router.get "/hello/:name" do |env|
  "Hello, #{env.params.url["name"]}!"
end
router.get "/json" do |env|
  env.response.content_type = "application/json"
  "{}"
end
router.post "/echo" do |env|
  env.request.body
end
router.post "/form" do |env|
  env.params.body["name"]
end
router.put "/item" do |env|
  "put"
end
router.get "/go" do |env|
  env.redirect("/there")
  ""
end
router.get "/go-to" do |env|
  env.redirect(env.params.query["to"]? || "/")
  ""
end
router.error 404 do |env|
  "nope"
end
router.get "/boom" do |env|
  raise "kaboom <b>" if env.request.path == "/boom"
  "unreachable"
end
router.get "/boom-twice" do |env|
  raise "handler failed" if env.request.path == "/boom-twice"
  "unreachable"
end
router.get "/boom-json" do |env|
  raise "handler failed" if env.request.path == "/boom-json"
  "unreachable"
end
router.get "/boom-cause" do |env|
  raise "kaboom" if env.request.path == "/boom-cause"
  "unreachable"
end
router.sse "/events" do |stream, env|
  stream.send("one", event: "tick")
  stream.send("two", event: "tick")
end
router.get "/stream" do |env|
  env.response.print("one")
  env.response.flush
  env.response.print("two")
  ""
end
router.post "/upload" do |env|
  upload = env.params.files["file"]?
  upload ? upload.path + "|" + upload.read : "none"
end
router.get "/peer" do |env|
  (env.request.remote_address || "nil") + " tls=" + env.request.tls?.to_s
end
router.get "/version" do |env|
  env.request.version
end
router.error 500 do |env, err|
  raise "page failed" if env.request.path == "/boom-twice"
  if env.request.path == "/boom-json"
    # Written by the helper; the block's own answer is empty.
    env.json({"error" => "sorry"})
    ""
  elsif env.request.path == "/boom-cause"
    (err.is_a?(Panicked) ? "panicked: " : "other: ") + err.message
  else
    "sorry: " + env.request.path
  end
end

cfg = config
cfg.logging = false
cfg.serve_static = false
cfg.powered_by_header = true

server = Server.new(chain([RouteHandler.new(router)]), cfg, router.error_handlers, router.error_type_handlers)
port = server.bind("127.0.0.1", 0)

# A page for `Panicked` takes every panic, so it gets a server of its own.
typed = Router.new
typed.get "/panic" do |env|
  raise "typed <kaboom>" if env.request.path == "/panic"
  "unreachable"
end
typed.get "/teapot" do |env|
  raise "short and stout" if env.request.path == "/teapot"
  "unreachable"
end
typed.get "/page-panics" do |env|
  raise "first" if env.request.path == "/page-panics"
  "unreachable"
end
typed.error Panicked do |env, err|
  raise "page failed" if env.request.path == "/page-panics"
  env.response.status_code = 418 if env.request.path == "/teapot"
  "caught: " + err.message
end
typed.error 500 do |env, err|
  "fallback: " + err.message
end
typed_server = Server.new(chain([RouteHandler.new(typed)]), cfg, typed.error_handlers, typed.error_type_handlers)
typed_port = typed_server.bind("127.0.0.1", 0)

# Routes on the path as sent, with a guard that exempts `/hooks/*`.
raw = Router.new
raw.get "/files/:name" do |env|
  env.params.url["name"]
end
raw.post "/:org/delete" do |env|
  "deleted " + env.params.url["org"]
end
raw.post "/hooks/:name" do |env|
  "hook " + env.params.url["name"]
end
raw_cfg = Config.new
raw_cfg.logging = false
raw_cfg.serve_static = false
raw_cfg.route_on_raw_path = true
raw_guard = Guard.new
raw_guard.exclude ["/hooks/*"], "*"
raw_server = Server.new(chain([raw_guard, RouteHandler.new(raw, raw_cfg)] of Handler), raw_cfg)
raw_port = raw_server.bind("127.0.0.1", 0)

# Bodies left on the connection (`stream_bodies`) and answers compressed
# by std/http (`compress`), under a limit small enough to pass.
streaming = Router.new
streaming.post "/count" do |env|
  body = env.request.body_io
  total = 0
  pieces = 0
  while true
    piece = body.read
    break unless piece.is_a?(String)
    break if piece.empty?
    total = total + piece.bytesize
    pieces = pieces + 1
  end
  failed = env.request.body_failure
  failed ? "failed #{failed.status}" : "read #{total} in #{pieces > 1 ? "pieces" : "one"}"
end
streaming.post "/ignore" do |env|
  "ignored"
end
streaming.post "/json" do |env|
  env.params.json["a"]?.to_s
end
streaming.get "/text" do |env|
  env.response.content_type = "text/plain; charset=utf-8"
  "compressible " * 400
end
stream_cfg = Config.new
stream_cfg.logging = false
stream_cfg.serve_static = false
stream_cfg.stream_bodies = true
stream_cfg.compress = true
stream_cfg.max_request_body_size = 1000000
stream_server = Server.new(chain([RouteHandler.new(streaming, stream_cfg)]), stream_cfg)
stream_port = stream_server.bind("127.0.0.1", 0)

# *size* bytes of body as chunks of *each*, then the last chunk.
def chunked_body(size : Int32, each : Int32) : String
  builder = String::Builder.new
  left = size
  while left > 0
    piece = left < each ? left : each
    builder << piece.to_s(16) << "\r\n" << "z" * piece << "\r\n"
    left = left - piece
  end
  builder << "0\r\n\r\n"
  builder.to_s
end

group do |g|
  g.spawn do
    describe "Server" do
      it "serves GET with Date, powered-by and Connection: close" do
        home = exchange(port, close_request("GET", "/"))
        assert status_line(home) == "HTTP/1.1 200 OK"
        assert http_header(home, "X-Powered-By") == "iyi-web"
        assert http_header(home, "Connection") == "close"
        assert http_body(home) == "home"
        date = http_header(home, "Date")
        assert !date.nil?
        if dated = date
          assert dated.includes?("GMT")
        end
      end

      it "gives the request the client's address, the same on every request of a connection" do
        peer = exchange(port, close_request("GET", "/peer"))
        assert http_body(peer) == "127.0.0.1 tls=false"

        client = IyiSocket.connect("127.0.0.1", port).or_panic
        client.write("GET /peer HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        first = read_frame(client)
        client.write(close_request("GET", "/peer")).or_panic
        second = read_frame(client)
        client.close
        assert http_body(first) == "127.0.0.1 tls=false"
        assert http_body(second) == "127.0.0.1 tls=false"
      end

      it "percent-decodes a url param over TCP" do
        named = exchange(port, close_request("GET", "/hello/dunya"))
        assert http_body(named) == "Hello, dunya!"
        spaced = exchange(port, close_request("GET", "/hello/a%20b"))
        assert http_body(spaced) == "Hello, a b!"
      end

      it "preserves Content-Type set by the route" do
        json = exchange(port, close_request("GET", "/json"))
        assert http_header(json, "Content-Type") == "application/json"
        assert http_body(json) == "{}"
      end

      it "echoes a POST body, including an empty one and a body larger than one read" do
        echoed = exchange(port, close_request("POST", "/echo", "Content-Length: 5\r\n") + "hello")
        assert http_body(echoed) == "hello"

        empty = exchange(port, close_request("POST", "/echo", "Content-Length: 0\r\n"))
        assert http_body(empty) == ""

        payload = "x" * 5000
        bulky = exchange(port, close_request("POST", "/echo", "Content-Length: 5000\r\n") + payload)
        assert http_body(bulky) == payload
      end

      it "answers Expect: 100-continue before the body, then the request" do
        client = IyiSocket.connect("127.0.0.1", port).or_panic
        client.write(close_request("POST", "/echo", "Expect: 100-continue\r\nContent-Length: 5\r\n")).or_panic
        interim = ""
        while interim.bytesize < 25
          chunk = client.read(25 - interim.bytesize).or_panic
          break if chunk.empty?
          interim = interim + chunk
        end
        assert interim == "HTTP/1.1 100 Continue\r\n\r\n"
        client.write("hello").or_panic
        final = read_frame(client)
        client.close
        assert status_line(final) == "HTTP/1.1 200 OK"
        assert http_body(final) == "hello"
      end

      it "decodes a chunked POST body" do
        chunked = exchange(port, close_request("POST", "/echo", "Transfer-Encoding: chunked\r\n") + "3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n")
        assert http_body(chunked) == "abcde"
      end

      it "parses a form body" do
        form = exchange(port, close_request("POST", "/form", "Content-Type: application/x-www-form-urlencoded\r\nContent-Length: 8\r\n") + "name=iyi")
        assert http_body(form) == "iyi"
      end

      it "dispatches PUT" do
        put = exchange(port, close_request("PUT", "/item"))
        assert http_body(put) == "put"
      end

      it "omits the body on HEAD and keeps Content-Length" do
        headed = exchange(port, close_request("HEAD", "/"))
        assert status_line(headed) == "HTTP/1.1 200 OK"
        assert http_header(headed, "Content-Length") == "4"
        assert http_body(headed) == ""
      end

      it "redirects with Location" do
        go = exchange(port, close_request("GET", "/go"))
        assert status_line(go) == "HTTP/1.1 302 Found"
        assert http_header(go, "Location") == "/there"
      end

      it "serves a custom 404 over TCP" do
        missing = exchange(port, close_request("GET", "/nope"))
        assert status_line(missing) == "HTTP/1.1 404 Not Found"
        assert http_body(missing) == "nope"
      end

      it "rejects a lowercase method as 405" do
        low = exchange(port, close_request("get", "/"))
        assert status_line(low) == "HTTP/1.1 405 Method Not Allowed"
      end

      it "answers a malformed request with 400" do
        bad = exchange(port, "GET / HTTP/1.1\r\nNotAHeader\r\n\r\n")
        assert status_line(bad) == "HTTP/1.1 400 Bad Request"
        assert http_header(bad, "Connection") == "close"
        short = exchange(port, "GET\r\n\r\n")
        assert status_line(short) == "HTTP/1.1 400 Bad Request"
      end

      it "answers a Content-Length above the cap with 413 before reading the body" do
        cfg.max_request_body_size = 8
        huge = exchange(port, close_request("POST", "/echo", "Content-Length: 20\r\n") + "xxxxxxxxxxxxxxxxxxxx")
        assert status_line(huge) == "HTTP/1.1 413 Content Too Large"
        assert http_header(huge, "Connection") == "close"
        early = exchange(port, close_request("POST", "/echo", "Content-Length: 5000000\r\n"))
        assert status_line(early) == "HTTP/1.1 413 Content Too Large"
        cfg.max_request_body_size = 8 * 1024 * 1024
      end

      it "serves a second request on a keep-alive connection" do
        alive = IyiSocket.connect("127.0.0.1", port).or_panic
        alive.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        first = read_frame(alive)
        assert status_line(first) == "HTTP/1.1 200 OK"
        assert http_header(first, "Connection") == "keep-alive"
        assert http_body(first) == "home"
        alive.write("GET /json HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_panic
        second = ""
        loop do
          chunk = alive.read(4096).or_panic
          break if chunk.empty?
          second = second + chunk
        end
        alive.close
        assert http_body(second) == "{}"
        assert http_header(second, "Connection") == "close"
      end

      it "sends server-sent events as they are written" do
        events = exchange(port, close_request("GET", "/events"))
        assert status_line(events) == "HTTP/1.1 200 OK"
        assert http_header(events, "Content-Type") == "text/event-stream; charset=utf-8"
        assert http_header(events, "Transfer-Encoding") == "chunked"
        assert http_body(events) == "17\r\nevent: tick\ndata: one\n\n\r\n17\r\nevent: tick\ndata: two\n\n\r\n0\r\n\r\n"
      end

      it "streams a flushed response in chunks and keeps the connection" do
        streamed = exchange(port, close_request("GET", "/stream"))
        assert status_line(streamed) == "HTTP/1.1 200 OK"
        assert http_header(streamed, "Transfer-Encoding") == "chunked"
        assert http_body(streamed) == "3\r\none\r\n3\r\ntwo\r\n0\r\n\r\n"

        alive = IyiSocket.connect("127.0.0.1", port).or_panic
        alive.write("GET /stream HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        first = ""
        until first.ends_with?("0\r\n\r\n")
          first = first + alive.read(4096).or_panic
        end
        assert http_header(first, "Connection") == "keep-alive"
        alive.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").or_panic
        second = ""
        loop do
          chunk = alive.read(4096).or_panic
          break if chunk.empty?
          second = second + chunk
        end
        alive.close
        assert http_body(second) == "home"
      end

      it "receives a multipart upload and deletes its file after responding" do
        body = "--XyZ\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.bin\"\r\n\r\nbytes\u0000\r\nhere\r\n--XyZ--\r\n"
        sent = exchange(port, close_request("POST", "/upload", "Content-Type: multipart/form-data; boundary=XyZ\r\nContent-Length: #{body.bytesize}\r\n") + body)
        assert status_line(sent) == "HTTP/1.1 200 OK"
        parts = http_body(sent).split('|')
        assert parts.size == 2
        assert parts[1] == "bytes\u0000\r\nhere"
        assert !File.exists?(parts[0])
      end

      it "answers a panicking route with the error 500 page and closes" do
        boom = exchange(port, "GET /boom HTTP/1.1\r\nHost: localhost\r\n\r\n")
        assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"
        assert http_header(boom, "Connection") == "close"
        assert http_body(boom) == "sorry: /boom"
      end

      it "sends the error 500 page a helper wrote" do
        boom = exchange(port, close_request("GET", "/boom-json"))
        assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"
        assert http_header(boom, "Content-Type") == "application/json; charset=utf-8"
        assert http_body(boom) == "{\"error\":\"sorry\"}"
      end

      it "tells the error 500 page the panic it answers" do
        boom = exchange(port, close_request("GET", "/boom-cause"))
        assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"
        assert http_body(boom) == "panicked: kaboom"
      end

      it "falls back to the built-in 500 page when the error page panics" do
        cfg.show_exceptions = true
        shown = exchange(port, close_request("GET", "/boom-twice"))
        assert status_line(shown) == "HTTP/1.1 500 Internal Server Error"
        assert http_body(shown).includes?("handler failed")
        assert http_header(shown, "Content-Security-Policy") == "default-src 'none'; style-src 'unsafe-inline'"

        cfg.show_exceptions = false
        hidden = exchange(port, close_request("GET", "/boom-twice"))
        assert status_line(hidden) == "HTTP/1.1 500 Internal Server Error"
        assert !http_body(hidden).includes?("handler failed")
      end

      it "logs the 500 a panicking route gets through the configured logger" do
        previous = cfg.logger
        collected = Collected.new
        cfg.logger = collected
        cfg.logging = true
        exchange(port, close_request("GET", "/boom"))
        assert collected.lines.size == 1
        assert collected.lines[0].starts_with?("GET /boom 500 ")
        assert collected.lines[0].ends_with?("ms")

        cfg.logging = false
        exchange(port, close_request("GET", "/boom"))
        assert collected.lines.size == 1
        cfg.logger = previous
      end

      it "keeps other connections open when one request panics" do
        alive = IyiSocket.connect("127.0.0.1", port).or_panic
        alive.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        assert http_body(read_frame(alive)) == "home"

        boom = exchange(port, close_request("GET", "/boom"))
        assert status_line(boom) == "HTTP/1.1 500 Internal Server Error"

        alive.write("GET /json HTTP/1.1\r\nHost: localhost\r\n\r\n").or_panic
        again = read_frame(alive)
        alive.close
        assert status_line(again) == "HTTP/1.1 200 OK"
        assert http_body(again) == "{}"
      end

      it "refuses a redirect to a location carrying CR and LF" do
        forged = exchange(port, close_request("GET", "/go-to?to=/next%0d%0aSet-Cookie:%20injected=1"))
        assert status_line(forged) == "HTTP/1.1 500 Internal Server Error"
        assert http_header(forged, "Set-Cookie").nil?
      end

      it "gives a route's panic to the `error Panicked` page before the 500 page" do
        caught = exchange(typed_port, "GET /panic HTTP/1.1\r\nHost: localhost\r\n\r\n")
        assert status_line(caught) == "HTTP/1.1 500 Internal Server Error"
        assert http_header(caught, "Connection") == "close"
        assert http_body(caught) == "caught: typed <kaboom>"

        teapot = exchange(typed_port, close_request("GET", "/teapot"))
        assert status_line(teapot) == "HTTP/1.1 418 I'm a teapot"
        assert http_body(teapot) == "caught: short and stout"

        fallback = exchange(typed_port, close_request("GET", "/page-panics"))
        assert status_line(fallback) == "HTTP/1.1 500 Internal Server Error"
        assert http_body(fallback) == "fallback: first"
      end

      it "routes on the path as sent under route_on_raw_path, and guards by it too" do
        file = exchange(raw_port, close_request("GET", "/files/a%2Fb%20c"))
        assert status_line(file) == "HTTP/1.1 200 OK"
        assert http_body(file) == "a/b c"

        forged = exchange(raw_port, close_request("POST", "/hooks%2Fx/delete", "Content-Length: 0\r\n"))
        assert status_line(forged) == "HTTP/1.1 403 Forbidden"
        hook = exchange(raw_port, close_request("POST", "/hooks/x", "Content-Length: 0\r\n"))
        assert http_body(hook) == "hook x"
      end

      it "speaks HTTP/2 to a client with prior knowledge, beside HTTP/1.1 on the same port" do
        client = HTTPClient.new(prior_knowledge: true)
        version = client.get("http://127.0.0.1:#{port}/version").or_panic
        assert version.status == 200
        assert version.body == "HTTP/2"
        echoed = client.post("http://127.0.0.1:#{port}/echo", "over h2").or_panic
        assert echoed.body == "over h2"
        missing = client.get("http://127.0.0.1:#{port}/nope").or_panic
        assert missing.status == 404
        assert missing.body == "nope"
        client.close
        assert http_body(exchange(port, close_request("GET", "/version"))) == "HTTP/1.1"
      end

      it "sends a flushed body to an HTTP/1.0 client unchunked, up to the close" do
        old = exchange(port, "GET /stream HTTP/1.0\r\n\r\n")
        assert status_line(old).ends_with?(" 200 OK")
        assert http_header(old, "Transfer-Encoding").nil?
        assert http_header(old, "Connection") == "close"
        assert http_body(old) == "onetwo"
      end

      it "holds the request line to 8 KiB with 414 and the fields to 16 KiB with 431" do
        long = exchange(port, close_request("GET", "/" + "a" * 8200))
        assert status_line(long) == "HTTP/1.1 414 URI Too Long"
        assert http_header(long, "Connection") == "close"
        within = exchange(port, close_request("GET", "/" + "a" * 8000))
        assert status_line(within) == "HTTP/1.1 404 Not Found"

        fat = exchange(port, close_request("GET", "/", "X-Fat: " + "b" * 16400 + "\r\n"))
        assert status_line(fat) == "HTTP/1.1 431 Request Header Fields Too Large"
        many = ""
        200.times { |index| many = many + "X-Field-#{index}: " + "c" * 80 + "\r\n" }
        assert status_line(exchange(port, close_request("GET", "/", many))) == "HTTP/1.1 431 Request Header Fields Too Large"
        slim = exchange(port, close_request("GET", "/", "X-Fat: " + "b" * 16000 + "\r\n"))
        assert status_line(slim) == "HTTP/1.1 200 OK"
      end

      it "refuses a chunked body past the cap with 413" do
        cfg.max_request_body_size = 8
        chunked = exchange(port, close_request("POST", "/echo", "Transfer-Encoding: chunked\r\n") + "5\r\nabcde\r\n5\r\nfghij\r\n0\r\n\r\n")
        assert status_line(chunked) == "HTTP/1.1 413 Content Too Large"
        assert http_header(chunked, "Connection") == "close"
        within = exchange(port, close_request("POST", "/echo", "Transfer-Encoding: chunked\r\n") + "4\r\nabcd\r\n4\r\nefgh\r\n0\r\n\r\n")
        assert http_body(within) == "abcdefgh"
        cfg.max_request_body_size = 8 * 1024 * 1024
      end

      it "lets a route read its body as it arrives under stream_bodies" do
        counted = exchange(stream_port, close_request("POST", "/count", "Transfer-Encoding: chunked\r\n") + chunked_body(900000, 70000))
        assert http_body(counted) == "read 900000 in pieces"
        sized = exchange(stream_port, close_request("POST", "/count", "Content-Length: 5\r\n") + "hello")
        assert http_body(sized) == "read 5 in one"
      end

      it "stops a streamed body at max_request_body_size with 413 as its failure" do
        counted = exchange(stream_port, close_request("POST", "/count", "Transfer-Encoding: chunked\r\n") + chunked_body(1200000, 100000))
        assert http_body(counted) == "failed 413"
        # The JSON body a pre-route check reads is refused before the route.
        json = exchange(stream_port, close_request("POST", "/json", "Content-Type: application/json\r\nTransfer-Encoding: chunked\r\n") + chunked_body(1200000, 100000))
        assert status_line(json) == "HTTP/1.1 413 Content Too Large"
        small = exchange(stream_port, close_request("POST", "/json", "Content-Type: application/json\r\nContent-Length: 7\r\n") + "{\"a\":1}")
        assert http_body(small) == "1"
      end

      it "reads past a body no route read, and serves the next request on the connection" do
        alive = IyiSocket.connect("127.0.0.1", stream_port).or_panic
        alive.write("POST /ignore HTTP/1.1\r\nHost: localhost\r\nContent-Length: 10\r\n\r\n0123456789").or_panic
        first = read_frame(alive)
        assert http_body(first) == "ignored"
        assert http_header(first, "Connection") == "keep-alive"
        alive.write(close_request("POST", "/count", "Content-Length: 3\r\n") + "abc").or_panic
        second = read_frame(alive)
        alive.close
        assert http_body(second) == "read 3 in one"
      end

      it "compresses an answer zstd or gzip, as the client takes them, under compress" do
        text = "compressible " * 400
        zstd = exchange(stream_port, close_request("GET", "/text", "Accept-Encoding: zstd, gzip\r\n"))
        assert http_header(zstd, "Content-Encoding") == "zstd"
        assert http_header(zstd, "Vary") == "Accept-Encoding"
        assert Zstd.decompress(http_body(zstd)) == text
        gzip = exchange(stream_port, close_request("GET", "/text", "Accept-Encoding: gzip\r\n"))
        assert http_header(gzip, "Content-Encoding") == "gzip"
        assert Gzip.decompress(http_body(gzip)) == text
        plain = exchange(stream_port, close_request("GET", "/text"))
        assert http_header(plain, "Content-Encoding").nil?
        assert http_body(plain) == text
        # Off, the default: the same client gets the body as it is.
        assert http_header(exchange(port, close_request("GET", "/", "Accept-Encoding: zstd, gzip\r\n")), "Content-Encoding").nil?
      end
    end

    server.close
    typed_server.close
    raw_server.close
    stream_server.close
    0
  end

  g.spawn do
    stream_server.listen
    0
  end

  g.spawn do
    server.listen
    0
  end

  g.spawn do
    typed_server.listen
    0
  end

  g.spawn do
    raw_server.listen
    0
  end
end
