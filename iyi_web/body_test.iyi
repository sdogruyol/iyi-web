# IntoBody is the compile-time stand-in for Kemal's runtime `is_a?(String)`.
module iyi_web/body_test

import iyi_web/body::{IntoBody}
import iyi_web/spec::*

describe "IntoBody" do
  it "keeps a String" do
    assert "hello".into_body == "hello"
  end

  it "turns Nil into an empty body" do
    assert nil.into_body == ""
  end

  it "stringifies integers" do
    assert 42.into_body == "42"
    assert 99_i64.into_body == "99"
  end

  it "stringifies booleans" do
    assert true.into_body == "true"
    assert false.into_body == "false"
  end
end
