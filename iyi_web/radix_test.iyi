# Segment tree: static wins over a param, :name captures one segment,
# *name the rest, and a failed static walk falls back to the param.
module iyi_web/radix_test

import iyi_web/radix
import iyi_web/spec

using iyi_web/radix::{Tree}
using iyi_web/spec

def sample_tree : Tree(String)
  tree = Tree(String).new
  tree.add("/GET/", "home")
  tree.add("/GET/users/:id", "user")
  tree.add("/GET/users/new", "new-user")
  tree.add("/GET/files/*path", "file")
  tree.add("/POST/users", "create")
  tree.add("/GET/:x/c", "xc")
  tree.add("/GET/a/b", "ab")
  tree
end

def payload(tree : Tree(String), path : String) : String
  match = tree.find(path)
  if found = match
    return found.payload
  end
  assert false, "missing " + path
  ""
end

def params(tree : Tree(String), path : String) : Hash(String, String)
  match = tree.find(path)
  if found = match
    return found.params
  end
  assert false, "missing " + path
  {} of String => String
end

describe "Tree" do
  it "finds a static root" do
    tree = sample_tree
    assert payload(tree, "/GET/") == "home"
    assert params(tree, "/GET/").empty?
  end

  it "captures a named segment" do
    tree = sample_tree
    assert payload(tree, "/GET/users/7") == "user"
    assert params(tree, "/GET/users/7")["id"] == "7"
  end

  it "prefers a static segment over a parameter on the same node" do
    tree = sample_tree
    assert payload(tree, "/GET/users/new") == "new-user"
  end

  it "captures the rest of the path as a glob" do
    tree = sample_tree
    assert payload(tree, "/GET/files/a/b/c.txt") == "file"
    assert params(tree, "/GET/files/a/b/c.txt")["path"] == "a/b/c.txt"
    assert params(tree, "/GET/files")["path"] == ""
  end

  it "keys the walk on the HTTP method" do
    tree = sample_tree
    assert payload(tree, "/POST/users") == "create"
  end

  it "backtracks onto a parameter when a static walk fails" do
    tree = sample_tree
    assert payload(tree, "/GET/a/b") == "ab"
    assert payload(tree, "/GET/a/c") == "xc"
    assert params(tree, "/GET/a/c")["x"] == "a"
  end

  it "returns nil for a path, method or extra segment that is not routed" do
    tree = sample_tree
    assert tree.find("/GET/missing").nil?
    assert tree.find("/DELETE/users").nil?
    assert tree.find("/GET/users/7/extra").nil?
  end

  it "marks a successful Match as found?" do
    hit = sample_tree.find("/GET/")
    if found = hit
      assert found.found?
    else
      assert false, "expected a match"
    end
  end

  it "matches a path with or without a trailing slash" do
    tree = sample_tree
    assert payload(tree, "/GET/a/b/") == "ab"
    assert payload(tree, "/GET/users/7/") == "user"
    slashed = Tree(String).new
    slashed.add("/GET/about/", "about")
    assert payload(slashed, "/GET/about") == "about"
  end
end
