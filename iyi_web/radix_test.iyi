# Segment tree: static wins over a param, :name captures one segment,
# *name the rest, and a failed static walk falls back to the param.
module iyi_web/radix_test

import iyi_web/radix

using iyi_web/radix::{Tree}

def payload(tree : Tree(String), path : String) : String
  match = tree.find(path)
  if found = match
    return found.payload
  end
  assert false, "missing " + path
  ""
end

def params(tree : Tree(String), path : String) : Hash(String, String)
  match = tree.find(path)
  if found = match
    return found.params
  end
  assert false, "missing " + path
  {} of String => String
end

tree = Tree(String).new
tree.add("/GET/", "home")
tree.add("/GET/users/:id", "user")
tree.add("/GET/users/new", "new-user")
tree.add("/GET/files/*path", "file")
tree.add("/POST/users", "create")
tree.add("/GET/:x/c", "xc")
tree.add("/GET/a/b", "ab")

assert payload(tree, "/GET/") == "home", "GET /"
assert params(tree, "/GET/").empty?, "GET / no params"

assert payload(tree, "/GET/users/7") == "user", "param payload"
assert params(tree, "/GET/users/7")["id"] == "7", "param id"

assert payload(tree, "/GET/users/new") == "new-user", "static wins over :id"

assert payload(tree, "/GET/files/a/b/c.txt") == "file", "glob payload"
assert params(tree, "/GET/files/a/b/c.txt")["path"] == "a/b/c.txt", "glob rest"
assert params(tree, "/GET/files")["path"] == "", "empty glob tail"

assert payload(tree, "/POST/users") == "create", "POST"

assert payload(tree, "/GET/a/b") == "ab", "static /a/b"
assert payload(tree, "/GET/a/c") == "xc", "static miss backtracks onto :x"
assert params(tree, "/GET/a/c")["x"] == "a", "backtrack param"

assert tree.find("/GET/missing").nil?, "unknown path"
assert tree.find("/DELETE/users").nil?, "unknown method"
assert tree.find("/GET/users/7/extra").nil?, "param does not swallow extra"

hit = tree.find("/GET/")
if found = hit
  assert found.found?, "Match.found? is the success flag"
end

puts "radix_test ok"
