# Writable response: status, headers, body, and the exact bytes a socket is owed.
module iyi_web/response_test

import iyi_web/response

using iyi_web/response::{Response}

res = Response.new
assert res.status_code == 200, "default status"
assert res.body == "", "default body"
assert !res.closed?, "open"
assert res.content_type == "text/html; charset=utf-8", "default type"

res.status_code = 201
res.content_type = "application/json"
res.print("{")
res.write("}")
assert res.body == "{}", "print concatenates"
assert res.headers["content-type"] == "application/json", "setter writes header"

res.set_body("ok")
assert res.body == "ok", "set_body replaces"

res.close
assert res.closed?, "closed"

http = res.to_http("HTTP/1.1")
assert http == "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\nok", "frame is status, headers, blank, body"

plain = Response.new
plain.set_body("ok")
wired = plain.to_http("HTTP/1.1")
assert wired == "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 2\r\n\r\nok", "default type and length"

forced = Response.new
forced.headers["Content-Length"] = "99"
forced.set_body("x")
kept = forced.to_http("HTTP/1.1")
assert kept.includes?("Content-Length: 99\r\n"), "existing content-length left alone"
assert kept.includes?("\r\n\r\nx"), "body still written"

unknown = Response.new
unknown.status_code = 599
unknown.set_body("")
assert unknown.to_http("HTTP/1.1").starts_with?("HTTP/1.1 599 Unknown\r\n"), "unnamed status still serialises"

headless = Response.new
headless.set_body("ok")
assert headless.to_http("HTTP/1.1", false) == "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 2\r\n\r\n", "HEAD omits the body and keeps the length"

empty = Response.new
empty.status_code = 204
empty.set_body("nope")
assert empty.to_http("HTTP/1.1") == "HTTP/1.1 204 No Content\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 0\r\n\r\n", "204 has no entity"

puts "response_test ok"
