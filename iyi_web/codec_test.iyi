# Byte-level helpers: percent-coding, query tables, path joining.
# Request and header types have their own tests.
module iyi_web/codec_test

import iyi_web/codec

using iyi_web/codec

assert decode_form("hello+world") == "hello world", "plus is space in forms"
assert decode_form("a%2Bb") == "a+b", "form percent-plus"
assert decode_path("%2Ftmp") == "/tmp", "percent-decode path"
assert decode_path("%2ftmp") == "/tmp", "lowercase hex"
assert decode_path("a+b") == "a+b", "plus stays in a path"
assert decode("%GG") == "%GG", "invalid percent is left written"
assert decode("%2") == "%2", "truncated percent is left written"
assert decode_path("%20") == " ", "space from percent"
assert decode("%4A") == "J", "uppercase hex"
assert decode("%C3%A7") == "ç", "utf-8 percent sequence"

assert parse_query("q=iyi&n=1")["q"] == "iyi", "query q"
assert parse_query("q=iyi&n=1")["n"] == "1", "query n"
assert parse_query("a=1&a=2")["a"] == "2", "query last-wins"
assert parse_query("flag=")["flag"] == "", "empty value is present"
assert parse_query("flag")["flag"] == "", "bare key is empty value"
assert parse_query("").empty?, "empty query"
assert parse_query("=x").empty?, "empty name dropped"
assert parse_query("a%20b=c%2Bd")["a b"] == "c+d", "encoded name and value"
assert parse_query("msg=hello+world")["msg"] == "hello world", "plus in value"

assert join_paths("/api", "/users") == "/api/users", "join"
assert join_paths("", "users") == "/users", "join empty left"
assert join_paths("/api/", "") == "/api", "join empty right"
assert join_paths("/api/", "/users") == "/api/users", "join strips extra slashes"
assert join_paths("/", "x") == "/x", "join under root"

assert matches_path_prefix?("/api", "/api/users"), "prefix hit"
assert matches_path_prefix?("/api", "/api"), "prefix exact"
assert matches_path_prefix?("/", "/anywhere"), "root prefix"
assert matches_path_prefix?("", "/x"), "empty prefix"
assert !matches_path_prefix?("/api", "/apiv2"), "prefix miss"
assert !matches_path_prefix?("/api/users", "/api"), "prefix is not a suffix"

assert extension_of("/public/app.js") == "js", "extension"
assert extension_of("/a.B") == "b", "extension downcased"
assert extension_of("Makefile") == "", "no extension"
assert extension_of("/.hidden") == "", "dotfile is not an extension"
assert extension_of("/dir/") == "", "trailing slash"

assert path_starts_with_slash?("/x"), "slash start"
assert !path_starts_with_slash?("x"), "no slash"

assert find_substring("abcdef", "cd") == 2, "substring hit"
assert find_substring("abcdef", "ab") == 0, "substring at start"
assert find_substring("abcdef", "ef") == 4, "substring at end"
assert find_substring("abcdef", "xyz").nil?, "substring miss"
assert find_substring("abc", "") == 0, "empty needle"
assert find_substring("ab", "abc").nil?, "needle longer than haystack"

assert rindex_char("a.b.c", '.') == 3, "last dot"
assert rindex_char("abc", '.').nil?, "char absent"

puts "codec_test ok"
