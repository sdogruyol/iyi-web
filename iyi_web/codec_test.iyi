# Byte-level helpers: percent-coding, query tables, path joining.
# Request and header types have their own tests.
module iyi_web/codec_test

import iyi_web/codec::*
import iyi_web/spec::*

describe "decode" do
  it "leaves an invalid or truncated percent sequence written" do
    assert decode("%GG") == "%GG"
    assert decode("%2") == "%2"
  end

  it "accepts upper-case hex" do
    assert decode("%4A") == "J"
  end

  it "decodes a multi-byte UTF-8 sequence" do
    assert decode("%C3%A7") == "ç"
  end
end

describe "decode_form" do
  it "treats plus as space" do
    assert decode_form("hello+world") == "hello world"
  end

  it "still percent-decodes" do
    assert decode_form("a%2Bb") == "a+b"
  end
end

describe "decode_path" do
  it "percent-decodes" do
    assert decode_path("%2Ftmp") == "/tmp"
    assert decode_path("%2ftmp") == "/tmp"
    assert decode_path("%20") == " "
  end

  it "leaves plus as plus" do
    assert decode_path("a+b") == "a+b"
  end
end

describe "parse_query" do
  it "splits name/value pairs" do
    query = parse_query("q=iyi&n=1")
    assert query["q"] == "iyi"
    assert query["n"] == "1"
  end

  it "keeps the last value when a name repeats" do
    assert parse_query("a=1&a=2")["a"] == "2"
  end

  it "treats a missing or empty value as an empty string" do
    assert parse_query("flag=")["flag"] == ""
    assert parse_query("flag")["flag"] == ""
  end

  it "drops an empty name" do
    assert parse_query("=x").empty?
  end

  it "returns an empty table for an empty query" do
    assert parse_query("").empty?
  end

  it "percent-decodes names and values, and treats plus as space" do
    assert parse_query("a%20b=c%2Bd")["a b"] == "c+d"
    assert parse_query("msg=hello+world")["msg"] == "hello world"
  end
end

describe "parse_query_pairs" do
  it "keeps every pair in the order sent" do
    pairs = parse_query_pairs("tag=a&x=1&tag=b&tag=")
    assert pairs.size == 4
    assert pairs[0] == {"tag", "a"}
    assert pairs[1] == {"x", "1"}
    assert pairs[2] == {"tag", "b"}
    assert pairs[3] == {"tag", ""}
  end

  it "decodes bracketed names and drops empty names and pairs" do
    pairs = parse_query_pairs("tag%5B%5D=a&&=x&tag[]=b+c")
    assert pairs.size == 2
    assert pairs[0] == {"tag[]", "a"}
    assert pairs[1] == {"tag[]", "b c"}
    assert parse_query_pairs("").empty?
  end
end

describe "join_paths" do
  it "joins and strips extra slashes" do
    assert join_paths("/api", "/users") == "/api/users"
    assert join_paths("/api/", "/users") == "/api/users"
    assert join_paths("/", "x") == "/x"
  end

  it "treats an empty side as the other, rooted" do
    assert join_paths("", "users") == "/users"
    assert join_paths("/api/", "") == "/api"
  end
end

describe "matches_path_prefix?" do
  it "matches a prefix or the exact path" do
    assert matches_path_prefix?("/api", "/api/users")
    assert matches_path_prefix?("/api", "/api")
    assert matches_path_prefix?("/", "/anywhere")
    assert matches_path_prefix?("", "/x")
  end

  it "does not match a longer sibling or a suffix" do
    assert !matches_path_prefix?("/api", "/apiv2")
    assert !matches_path_prefix?("/api/users", "/api")
  end
end

describe "extension_of" do
  it "returns the downcased suffix after the last dot" do
    assert extension_of("/public/app.js") == "js"
    assert extension_of("/a.B") == "b"
  end

  it "returns empty when there is no extension" do
    assert extension_of("Makefile") == ""
    assert extension_of("/.hidden") == ""
    assert extension_of("/dir/") == ""
  end
end
