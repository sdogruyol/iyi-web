# The value a handler is handed: the request, a writable response, parsed
# params, and the `halt` flag that stops the rest of the chain.
#
# Crystal's Kemal reopens `HTTP::Server::Context`. That is the open-class
# move R-3 exists to forbid, so this type lives here and is the whole of
# what a handler sees.
module iyi_web/context

import iyi_web/request
import iyi_web/response
import iyi_web/params

using iyi_web/request::{Request}
using iyi_web/response::{Response}
using iyi_web/params::{Params}

pub class Context
  @request : Request
  @response : Response
  @params : Params
  @halted : Bool
  @store : Hash(String, String)

  def initialize(@request : Request, @response : Response, @params : Params)
    @halted = false
    @store = {} of String => String
  end

  def self.for(request : Request) : Context
    Context.new(request, Response.new, Params.from(request, {} of String => String))
  end

  def self.for(request : Request, url : Hash(String, String)) : Context
    Context.new(request, Response.new, Params.from(request, url))
  end

  pub def request : Request
    @request
  end

  pub def response : Response
    @response
  end

  pub def params : Params
    @params
  end

  pub def halted? : Bool
    @halted
  end

  pub def halt(status_code : Int32 = 200, body : String = "") : Nil
    @response.status_code = status_code
    @response.set_body(body)
    @response.close
    @halted = true
  end

  pub def redirect(url : String, status_code : Int32 = 302) : Nil
    @response.headers["Location"] = url
    @response.status_code = status_code
    @response.close
    @halted = true
  end

  pub def []=(key : String, value : String) : String
    @store[key] = value
  end

  pub def []?(key : String) : String?
    @store[key]?
  end

  pub def [](key : String) : String
    @store[key]
  end
end
