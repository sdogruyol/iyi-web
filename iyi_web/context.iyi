# The value a handler is handed: the request, a writable response, parsed
# params, and the `halt` flag that stops the rest of the chain.
#
# Crystal's Kemal reopens `HTTP::Server::Context`. That is the open-class
# move R-3 exists to forbid, so this type lives here and is the whole of
# what a handler sees.
module iyi_web/context

import std/file
import std/json
import std/time
import iyi_web/request
import iyi_web/response
import iyi_web/params
import iyi_web/cookies
import iyi_web/headers
import iyi_web/http_date
import iyi_web/mime

using std/file::{File}
using std/json::{JSON}
using std/time::{Time}
using iyi_web/request::{Request}
using iyi_web/response::{Response}
using iyi_web/params::{Params}
using iyi_web/cookies::{CookieJar, encode_cookie_value}
using iyi_web/headers::{Headers}
using iyi_web/http_date
using iyi_web/mime

# What `set` stores for later filters, middleware and the route.
pub alias StoreValue = Nil | String | Int32 | Int64 | Float64 | Bool

pub class Context
  @request : Request
  @response : Response
  @params : Params
  @halted : Bool
  @store : Hash(String, StoreValue)
  @cookies : CookieJar?

  def initialize(@request : Request, @response : Response, @params : Params)
    @halted = false
    @store = {} of String => StoreValue
    @cookies = nil
  end

  def self.for(request : Request) : Context
    Context.new(request, Response.new, Params.from(request, {} of String => String))
  end

  def self.for(request : Request, url : Hash(String, String)) : Context
    Context.new(request, Response.new, Params.from(request, url))
  end

  pub def request : Request
    @request
  end

  pub def response : Response
    @response
  end

  pub def params : Params
    @params
  end

  pub def halted? : Bool
    @halted
  end

  pub def halt(status_code : Int32 = 200, body : String = "") : Nil
    @response.status_code = status_code
    @response.set_body(body)
    @response.close
    @halted = true
  end

  # `close: false` sets the redirect and lets the rest of the chain run.
  pub def redirect(url : String, status_code : Int32 = 302, body : String = "", close : Bool = true) : Nil
    @response.headers["Location"] = url
    @response.status_code = status_code
    @response.set_body(body) unless body.empty?
    if close
      @response.close
      @halted = true
    end
  end

  pub def cookies : CookieJar
    current = @cookies
    return current if current
    header = @request.headers["cookie"]? || ""
    jar = CookieJar.parse(header)
    @cookies = jar
    jar
  end

  # The value is percent-encoded where RFC 6265 does not allow it, and
  # `cookies` decodes it, so any string round-trips. `max_age` 0 and no
  # `expires` make a session cookie.
  pub def set_cookie(name : String, value : String, path : String = "/", http_only : Bool = false, secure : Bool = false, max_age : Int32 = 0, same_site : String = "", domain : String = "", expires : Time? = nil) : Nil
    raise "invalid cookie name #{name.inspect}" unless Headers.valid_name?(name)
    cookie = name + "=" + encode_cookie_value(value) + "; Path=" + path
    cookie = cookie + "; Domain=" + domain unless domain.empty?
    if at = expires
      cookie = cookie + "; Expires=" + http_date(at)
    end
    cookie = cookie + "; Max-Age=" + max_age.to_s if max_age > 0
    cookie = cookie + "; HttpOnly" if http_only
    cookie = cookie + "; Secure" if secure
    cookie = cookie + "; SameSite=" + same_site unless same_site.empty?
    @response.headers.add("Set-Cookie", cookie)
  end

  # Tells the client to drop a cookie. *path* and *domain* must match the
  # ones it was set with.
  pub def delete_cookie(name : String, path : String = "/", domain : String = "") : Nil
    raise "invalid cookie name #{name.inspect}" unless Headers.valid_name?(name)
    cookie = name + "=; Path=" + path
    cookie = cookie + "; Domain=" + domain unless domain.empty?
    @response.headers.add("Set-Cookie", cookie + "; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT")
  end

  pub def status(code : Int32) : Context
    @response.status_code = code
    self
  end

  pub def text(content : String, content_type : String = "text/plain; charset=utf-8") : Nil
    @response.content_type = content_type
    @response.set_body(content)
  end

  pub def html(content : String, content_type : String = "text/html; charset=utf-8") : Nil
    @response.content_type = content_type
    @response.set_body(content)
  end

  pub def xml(content : String, content_type : String = "application/xml; charset=utf-8") : Nil
    @response.content_type = content_type
    @response.set_body(content)
  end

  # A String is sent as it is: it is taken to be JSON already.
  pub def json(content : String, content_type : String = "application/json; charset=utf-8") : Nil
    @response.content_type = content_type
    @response.set_body(content)
  end

  # Anything else `JSON.to_json` can write: hashes, arrays, scalars,
  # `JSON::Any`, and types that implement `ToJSON`.
  pub def json(data : T, content_type : String = "application/json; charset=utf-8") : Nil forall T
    @response.content_type = content_type
    @response.set_body(JSON.to_json(data))
  end

  # Whole-file send. Missing paths and directories 404 rather than panicking
  # inside File.read; MIME follows the extension unless the caller names one.
  # A *filename* makes the response a download (`disposition` defaults to
  # "attachment"); the name is encoded per RFC 6266 and RFC 8187.
  pub def send_file(path : String, mime_type : String = "", filename : String = "", disposition : String = "") : Nil
    if !File.exists?(path) || File.directory?(path)
      halt(404, "404 Not Found")
      return
    end

    type = mime_type.empty? ? mime_type_of(path) : mime_type
    @response.content_type = type
    @response.headers["X-Content-Type-Options"] = "nosniff"
    unless filename.empty?
      @response.headers["Content-Disposition"] = content_disposition(disposition.empty? ? "attachment" : disposition, filename)
    end
    @response.set_body(File.read(path))
  end

  pub def set(name : String, value : StoreValue) : Nil
    @store[name] = value
  end

  # Panics when nothing was stored under *name*.
  pub def get(name : String) : StoreValue
    raise "nothing stored under #{name.inspect}" unless @store.has_key?(name)
    @store[name]?
  end

  pub def get?(name : String) : StoreValue
    @store[name]?
  end

  pub def []=(key : String, value : String) : String
    @store[key] = value
    value
  end

  # The value under *key* when it is a String.
  pub def []?(key : String) : String?
    value = @store[key]?
    value.is_a?(String) ? value : nil
  end

  pub def [](key : String) : String
    self[key]? || raise "no string stored under #{key.inspect}"
  end
end

# `attachment; filename="report.pdf"`. A name that is not printable ASCII
# gets an ASCII fallback with `_` in place of each such character, and the
# exact name as `filename*` (RFC 8187), so neither a quote nor a line break
# can leave the parameter.
pub def content_disposition(disposition : String, filename : String) : String
  slash = filename.rindex("/")
  base = slash ? filename[slash + 1, filename.bytesize - slash - 1] : filename
  fallback = ""
  lossy = false
  base.each_char do |char|
    code = char.ord
    if code >= 0x20 && code < 0x7f
      fallback = fallback + "\\" if char == '"' || char == '\\'
      fallback = fallback + char.to_s
    else
      fallback = fallback + "_"
      lossy = true
    end
  end
  header = disposition + "; filename=\"" + fallback + "\""
  return header unless lossy
  header + "; filename*=UTF-8''" + encode_rfc8187(base)
end

private def encode_rfc8187(text : String) : String
  hex = "0123456789ABCDEF"
  encoded = ""
  bytes = text.to_unsafe
  index = 0
  while index < text.bytesize
    byte = bytes[index]
    if attr_char?(byte)
      encoded = encoded + byte.unsafe_chr.to_s
    else
      encoded = encoded + "%" + hex[byte.to_i32 >> 4, 1] + hex[byte.to_i32 % 16, 1]
    end
    index = index + 1
  end
  encoded
end

private def attr_char?(byte : UInt8) : Bool
  return true if byte >= 48_u8 && byte <= 57_u8
  return true if byte >= 65_u8 && byte <= 90_u8
  return true if byte >= 97_u8 && byte <= 122_u8
  case byte
  when 33_u8, 35_u8, 36_u8, 38_u8, 43_u8, 45_u8, 46_u8, 94_u8, 95_u8, 96_u8, 124_u8, 126_u8
    true
  else
    false
  end
end
