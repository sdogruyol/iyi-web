# Request-line parsing via `std/http`, content-type chopping, keep-alive,
# and the errors a bad header block must produce rather than guess through.
module iyi_web/request_test

import iyi_web/request::{Request, ParseError, parse_head, with_body, split_target}
import iyi_web/headers::{Headers}
import iyi_web/spec::*

def parsed(block : String) : Request
  case parse_head(block)
  in ParseError
    assert false, "parse_head failed"
    Request.new("GET", "/", "", "HTTP/1.1", Headers.new, "")
  in Request
    it
  end
end

def assert_error(block : String) : Nil
  case parse_head(block)
  in ParseError
  in Request
    assert false, "expected ParseError"
  end
end

describe "split_target" do
  it "splits path and query and leaves the query encoded" do
    target = split_target("/search?q=one&n=2")
    assert target[0] == "/search"
    assert target[1] == "q=one&n=2"
  end

  it "percent-decodes the path and leaves the query encoded" do
    space = split_target("/a%20b")
    assert space[0] == "/a b"
    assert space[1] == ""

    encoded = split_target("/a%20b?x=1%20y")
    assert encoded[0] == "/a b"
    assert encoded[1] == "x=1%20y"
  end

  it "normalizes empty and root targets" do
    assert split_target("/")[0] == "/"
    assert split_target("/?")[0] == "/"
    assert split_target("/?")[1] == ""
    assert split_target("")[0] == "/"
  end
end

describe "parse_head" do
  it "keeps the path as sent next to the decoded one" do
    req = parsed("GET /files/a%2Fb%20c?x=1 HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert req.path == "/files/a/b c"
    assert req.raw_path == "/files/a%2Fb%20c"
    assert with_body(req, "x").raw_path == "/files/a%2Fb%20c"

    built = Request.new("GET", "/files/a b", "", "HTTP/1.1", Headers.new, "")
    assert built.raw_path == "/files/a b"
  end

  it "reads method, path, version and well-known headers" do
    req = parsed("POST /echo HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
    assert req.method == "POST"
    assert req.path == "/echo"
    assert req.version == "HTTP/1.1"
    assert req.host == "localhost"
    assert req.content_type == "application/json"
    assert req.content_length == 2
    assert req.body == "{}"
    assert !req.keep_alive?
    assert with_body(req, "xx").body == "xx"
  end

  it "has no client address or TLS until the server says so, and with_body keeps both" do
    req = parsed("GET / HTTP/1.1\r\nHost: localhost")
    assert req.remote_address.nil?
    assert !req.tls?
    req.remote_address = "192.0.2.7"
    req.tls = true
    copy = with_body(req, "body")
    assert copy.remote_address == "192.0.2.7"
    assert copy.tls?
  end

  it "defaults keep-alive from the HTTP version" do
    assert parsed("GET / HTTP/1.1\r\nHost: localhost").keep_alive?
    assert !parsed("GET / HTTP/1.0\r\nHost: localhost").keep_alive?
  end

  it "honours an explicit Connection header, case-insensitively" do
    assert parsed("GET / HTTP/1.0\r\nHost: localhost\r\nConnection: keep-alive").keep_alive?
    assert !parsed("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: Close").keep_alive?
  end

  it "turns an asterisk target into /" do
    star = parsed("OPTIONS * HTTP/1.1\r\nHost: localhost")
    assert star.method == "OPTIONS"
    assert star.path == "/"
  end

  it "refuses a Content-Length that is not a number" do
    assert_error("GET / HTTP/1.1\r\nHost: localhost\r\nContent-Length: nope")
  end

  it "never reads the first of two Host lines" do
    # `std/http` refuses two (RFC 9112 §3.2).
    case parse_head("GET / HTTP/1.1\r\nHost: first\r\nHost: second")
    in ParseError
    in Request
      assert it.host == "second"
    end
  end

  it "leaves missing Host and Content-Type empty" do
    # HTTP/1.0: an HTTP/1.1 request without Host is refused.
    req = parsed("GET / HTTP/1.0")
    assert req.host == ""
    assert req.content_type == ""
  end

  it "rejects a request that is not a well-formed header block" do
    assert_error("")
    assert_error("GET")
    assert_error("GET / HTTP/1.1\r\nNotAHeader")
    assert_error("GET / HTTP/1.1\r\n: no-name")
  end

  it "rejects a header value carrying a control character" do
    assert_error("GET / HTTP/1.1\r\nHost: localhost\r\nX-A: a\u0001b")
  end
end
