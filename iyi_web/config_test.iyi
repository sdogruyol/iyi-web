# Process-wide config is one object, not a pile of class variables.
module iyi_web/config_test

import std/file::{File}
import std/dir::{Dir}
import std/tls::{TlsServerConfig}
import std/autocert::{AutocertManager, AutocertDirCache}
import iyi_web/config::*
import iyi_web/context::{Context}
import iyi_web/handler::{Handler}
import iyi_web/kept::{Kept}
import iyi_web/spec::*

import iyi_web/config::{Config}

describe "Config" do
  it "starts with the framework defaults" do
    fresh = Config.new
    assert fresh.app_name == "iyi-web"
    assert fresh.host == "0.0.0.0"
    assert fresh.public_folder == "./public"
    assert fresh.logging
    assert !fresh.running
    assert fresh.serve_static
    assert !fresh.powered_by_header
    assert fresh.max_request_body_size == 8 * 1024 * 1024
    assert fresh.keepalive
    assert fresh.max_keepalive_requests == 100
    assert fresh.shutdown_timeout == 30
    assert fresh.read_timeout == 60
    assert fresh.write_timeout == 60
    assert fresh.idle_timeout == 75
    assert fresh.unix_socket.nil?
    assert fresh.custom_handlers.empty?
    assert !fresh.stream_bodies
    assert !fresh.compress
    assert fresh.ssl.nil?
    assert fresh.autocert.nil?
    assert fresh.tls_config.nil?
  end

  it "serves TLS from ssl, else from the autocert manager, offering HTTP/2 and ACME's challenge" do
    cache_dir = File.join(Dir.tempdir, "iyi-web-autocert-config-test")
    fresh = Config.new
    manager = AutocertManager.new(LETS_ENCRYPT_STAGING, AutocertDirCache.new(cache_dir), ["example.com"])
    fresh.autocert = manager
    if made = fresh.tls_config
      assert made.alpn == ["h2", "http/1.1", "acme-tls/1"]
      assert !made.identity_source.nil?
    else
      assert false
    end
    ssl = TlsServerConfig.from_pem(File.read(__DIR__ + "/testdata/localhost.crt"), File.read(__DIR__ + "/testdata/localhost.key")).or_panic
    fresh.ssl = ssl
    # `ssl` itself, not the manager's: it offers nothing until the server
    # binds it.
    chosen = fresh.tls_config
    assert !chosen.nil? && chosen.alpn.empty? && chosen.identity_source.nil?
    # Settings carry the transport options to every worker.
    fresh.stream_bodies = true
    fresh.compress = true
    copied = Settings.new(fresh, fresh.log_requests.shared || raise "the default logger is shared")
    assert copied.stream_bodies
    assert copied.compress
  end

  it "accepts assignment and reports development?" do
    fresh = Config.new
    fresh.app_name = "demo"
    fresh.port = 4000
    fresh.env = "production"
    fresh.logging = false
    fresh.serve_static = false
    fresh.powered_by_header = true

    assert fresh.app_name == "demo"
    assert fresh.port == 4000
    assert fresh.env == "production"
    assert !fresh.development?
    assert !fresh.logging
    assert !fresh.serve_static
    assert fresh.powered_by_header

    fresh.env = "development"
    assert fresh.development?
  end

  it "collects custom handlers" do
    fresh = Config.new
    fresh.add_handler(Handler.new)
    assert fresh.custom_handlers.size == 1
    assert fresh.serial_label.nil?
  end

  it "says which step registered with workers: 1 keeps it on one thread" do
    fresh = Config.new
    fresh.add_step(KeptStep.new(->(ctx : Context) { ctx.call_next }, "use Counter"), 0)
    assert fresh.serial_label == "use Counter"

    hooked = Config.new
    hooked.static_headers = KeptStaticHeaders.new(->(args : {Context, String, File::Info}) { nil }, "static_headers")
    assert hooked.serial_label == "static_headers"
  end

  it "is the process singleton behind config()" do
    shared = config
    shared.env = "test"
    assert config.env == "test"
  end
end
