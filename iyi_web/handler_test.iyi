# Middleware is a subclass. The chain runs in order; halt skips the rest.
module iyi_web/handler_test

import iyi_web/handler
import iyi_web/router
import iyi_web/harness
import iyi_web/context

using iyi_web/handler::{Handler, chain}
using iyi_web/router::{Router, RouteHandler}
using iyi_web/harness
using iyi_web/context::{Context}

class StampHandler < Handler
  pub def call(ctx : Context) : Nil
    ctx["via"] = "stamp"
    call_next(ctx)
  end
end

class HaltHandler < Handler
  pub def call(ctx : Context) : Nil
    ctx.halt(401, "stopped")
    call_next(ctx)
  end
end

class AppendHandler < Handler
  @tag : String

  def initialize(@tag : String)
    super()
  end

  pub def call(ctx : Context) : Nil
    prev = ctx["order"]?
    ctx["order"] = prev ? prev + "," + @tag : @tag
    call_next(ctx)
  end
end

router = Router.new
router.get "/" do |env|
  via = env["via"]?
  via ? "ok:#{via}" : "ok"
end
router.get "/secret" do |env|
  "leaked"
end
router.get "/order" do |env|
  env["order"]? || ""
end

stamped = chain([StampHandler.new, RouteHandler.new(router)])
ctx = dispatch(stamped, "GET", "/")
assert ctx.response.body == "ok:stamp", "middleware runs before the route"
assert ctx["via"] == "stamp", "store visible to the route"

halted = chain([HaltHandler.new, RouteHandler.new(router)])
denied = dispatch(halted, "GET", "/secret")
assert denied.response.status_code == 401, "halt status"
assert denied.response.body == "stopped", "halt body, route skipped"

ordered = chain([AppendHandler.new("a"), AppendHandler.new("b"), RouteHandler.new(router)])
walked = dispatch(ordered, "GET", "/order")
assert walked.response.body == "a,b", "handlers run left to right"

passthrough = Handler.new
passthrough.next_handler = RouteHandler.new(router)
plain = dispatch(passthrough, "GET", "/")
assert plain.response.body == "ok", "base Handler is call_next"

puts "handler_test ok"
