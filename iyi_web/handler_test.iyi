# Middleware is a subclass. The chain runs in order; halt skips the rest.
module iyi_web/handler_test

import iyi_web/handler
import iyi_web/harness
import iyi_web/context
import iyi_web/spec

using iyi_web/handler::{Handler, chain}
using iyi_web/harness
using iyi_web/context::{Context}
using iyi_web/spec

class StampHandler < Handler
  pub def call(ctx : Context) : Nil
    ctx["via"] = "stamp"
    call_next(ctx)
  end
end

class HaltHandler < Handler
  pub def call(ctx : Context) : Nil
    ctx.halt(401, "stopped")
    call_next(ctx)
  end
end

class AppendHandler < Handler
  @tag : String

  def initialize(@tag : String)
    super()
  end

  pub def call(ctx : Context) : Nil
    prev = ctx["order"]?
    ctx["order"] = prev ? prev + "," + @tag : @tag
    call_next(ctx)
  end
end

describe "Handler" do
  it "runs middleware before the route" do
    handler = chain([StampHandler.new, routes { |r|
      r.get "/" do |env|
        via = env["via"]?
        via ? "ok:#{via}" : "ok"
      end
    }])
    ctx = dispatch(handler, "GET", "/")
    assert ctx.response.body == "ok:stamp"
    assert ctx["via"] == "stamp"
  end

  it "skips the route after a halt" do
    handler = chain([HaltHandler.new, routes { |r|
      r.get "/secret" do |env|
        "leaked"
      end
    }])
    denied = dispatch(handler, "GET", "/secret")
    assert denied.response.status_code == 401
    assert denied.response.body == "stopped"
  end

  it "walks the chain left to right" do
    handler = chain([AppendHandler.new("a"), AppendHandler.new("b"), routes { |r|
      r.get "/order" do |env|
        env["order"]? || ""
      end
    }])
    assert dispatch(handler, "GET", "/order").response.body == "a,b"
  end

  it "treats the base Handler as call_next" do
    passthrough = Handler.new
    passthrough.next_handler = routes { |r|
      r.get "/" do |env|
        "ok"
      end
    }
    assert dispatch(passthrough, "GET", "/").response.body == "ok"
  end
end
