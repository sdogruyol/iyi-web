# Modular routing, ported from Kemal's `Router` and then actually dispatched
# rather than flattened into Crystal globals.
#
# Registration returns a value. `Kemal::RouteHandler::INSTANCE` and the
# three singletons beside it are gone: they were the workaround a clean
# sheet is the moment to stop writing.
#
# **Checked where it is written.** A server with more than one worker runs
# every route on whichever core is free, several at once, so every block a
# `Router` keeps is checked by the compiler where the application writes
# it, as a parallel task's is (SPEC.md III.4.4, III.4.13): a route that
# captures an `Array` or a `Hash`, or assigns a local it captured, is
# refused, naming the variable and the field that fails, and the two ways
# past it: shared state behind a `Mutex` or in an `Atomic`, or `workers:
# 1` on the registration, which keeps its block unchecked and serves the
# application on one thread (`iyi_web/kept`).
module iyi_web/router

import std/list::{List}
import std/shared_proc::{SharedProc}
import iyi_web/body::{IntoBody}
import iyi_web/codec::*
import iyi_web/context::{Context}
import iyi_web/radix::{Tree, FrozenTree, Match}
import iyi_web/handler::{Handler}
import iyi_web/kept::{Kept, kept_serial?}
import iyi_web/status::*
import iyi_web/event_stream::{EventStream}
import iyi_web/websocket::{WebSocket}
import iyi_web/config::{Config, config}
import iyi_web/failure::{StatusError, render_error_type_page, render_failure_page, render_client_error_page}
import iyi_web/validation::{BodyError}

alias HandlerProc = Context -> String

# A route answers its body, or the error it failed with.
alias RouteProc = Proc(Context, String | Error)

# An `error` page for a status, told what caused it.
alias ErrorPage = Proc(Context, Error, String)

# An `error` page for an error type: nil when the error is not its type.
alias ErrorTypePage = Proc(Context, Error, String?)

# What the router keeps of a route or a filter, of an `error` page, and of
# a `ws` block: one call each, a page's and a socket's arguments a tuple,
# so a `Proc` and a `SharedProc` are called alike.
alias KeptRoute = Kept(Context, String | Error)
alias KeptPage = Kept({Context, Error}, String?)
alias KeptSocket = Kept({WebSocket, Context}, Nil)

HTTP_METHODS   = %w(get post put patch delete options head query)
FILTER_METHODS = %w(get post put patch delete options query)

pub struct Route
  def initialize(@method : String, @path : String, @handler : RouteProc)
  end

  pub def method : String
    @method
  end

  pub def path : String
    @path
  end

  pub def handler : RouteProc
    @handler
  end
end

# A `ws` route: the path as declared, prefixes included, and its block.
pub struct SocketRoute
  def initialize(@path : String, @handler : Proc(WebSocket, Context, Nil))
  end

  pub def path : String
    @path
  end

  pub def handler : Proc(WebSocket, Context, Nil)
    @handler
  end
end

private record RouteDefinition,
  method : String,
  path : String,
  handler : KeptRoute

private record FilterDefinition,
  kind : Symbol,
  method : String,
  path : String,
  handler : KeptRoute

private record SubRouter,
  path : String,
  router : Router

private record SocketDefinition,
  path : String,
  handler : KeptSocket

pub class Router
  @routes : Array(RouteDefinition)
  @filters : Array(FilterDefinition)
  @sub_routers : Array(SubRouter)
  @sockets : Array(SocketDefinition)
  @error_handlers : Hash(Int32, KeptPage)
  @error_types : Hash(String, KeptPage)

  def initialize(@prefix : String = "")
    @routes = [] of RouteDefinition
    @filters = [] of FilterDefinition
    @sub_routers = [] of SubRouter
    @sockets = [] of SocketDefinition
    @error_handlers = {} of Int32 => KeptPage
    @error_types = {} of String => KeptPage
  end

  pub def prefix : String
    @prefix
  end

  # A route's block answers an `IntoBody`, or a union of one with error
  # members: `String | NotFound` where `NotFound` implements `Error`. An
  # error it answers goes to the `error` page for its type.
  #
  # Every registration is marked `@[Share(serial: workers)]`: its block is
  # checked where the application writes it, and a refusal names both
  # ways out - a lock, or `workers: 1`. A call that passes the literal 1
  # is not checked, and its block is kept as the `Proc` it is
  # (`iyi_web/kept`).
  {% for method in HTTP_METHODS %}
    @[Share(serial: workers)]
    pub def {{ method.id }}(path : String, *, workers : Int32? = nil, &block : Context -> B) : Nil forall B
      what = {{ method.upcase }} + " " + path
      add_route({{ method.upcase }}, path, kept_serial?(workers, what) ? KeptRoute.new(->(ctx : Context) : String | Error { route_answer(block.call(ctx)) }, what) : KeptRoute.new(SharedProc(Context, String | Error).of { |ctx| route_answer(block.call(ctx)) }))
    end
  {% end %}

  # A GET route that answers with a server-sent event stream. The block
  # gets the stream and the context; the stream ends when it returns.
  @[Share(serial: workers)]
  pub def sse(path : String, *, workers : Int32? = nil, &block : EventStream, Context -> Nil) : Nil
    get(path, workers: workers) do |env|
      EventStream.serve(env) { |stream| block.call(stream, env) }
      nil
    end
  end

  # A WebSocket endpoint. A GET asking to upgrade gets the handshake; once
  # its 101 is out, the block gets the socket and the context to set the
  # callbacks, and the connection's task then reads frames until the
  # socket closes. Before and after filters run for the handshake as for
  # any GET. See `WebSocket`.
  @[Share(serial: workers)]
  pub def ws(path : String, *, workers : Int32? = nil, &block : WebSocket, Context -> Nil) : Nil
    what = "ws " + path
    add_socket(path, kept_serial?(workers, what) ? KeptSocket.new(->(pair : {WebSocket, Context}) { block.call(pair[0], pair[1]) }, what) : KeptSocket.new(SharedProc({WebSocket, Context}, Nil).of { |pair| block.call(pair[0], pair[1]) }))
  end

  # `before` and `after` for every method, then per method; each for one
  # path, or one block for several paths, registered once per path. One
  # def takes both: as two overloads, a `String` with a default and an
  # `Array(String)`, each with `workers:` after the `*`, iyi master
  # (befaa8bc4) kept only the later, and `before do ... end` found no
  # def to call.
  {% for filter in [{"before", "ALL"}, {"after", "ALL"}] + FILTER_METHODS.map { |m| {"before_" + m, m.upcase} } + FILTER_METHODS.map { |m| {"after_" + m, m.upcase} } %}
    {% name = filter[0]; method = filter[1]; kind = name.starts_with?("before") ? :before : :after %}
    @[Share(serial: workers)]
    pub def {{ name.id }}(path : String | Array(String) = "*", *, workers : Int32? = nil, &block : Context -> B) : Nil forall B : IntoBody
      paths = path.is_a?(String) ? [path] : path
      what = {{ name }} + " " + paths.join(", ")
      kept = kept_serial?(workers, what) ? KeptRoute.new(->(ctx : Context) : String | Error { block.call(ctx).into_body }, what) : KeptRoute.new(SharedProc(Context, String | Error).of { |ctx| block.call(ctx).into_body.as(String | Error) })
      paths.each { |one| add_filter({{ kind }}, {{ method }}, one, kept) }
    end
  {% end %}

  # The sub-router arrives as a block parameter. Kemal's original used
  # `with sub_router yield`, which changes the block's `self` — a shape
  # no `& : Router -> Nil` annotation can describe (SPEC.md IV.2). One
  # extra `|r|` is the rule being paid rather than avoided.
  pub def namespace(path : String, & : Router -> Nil) : Nil
    sub_router = Router.new
    yield sub_router
    @sub_routers << SubRouter.new(path: path, router: sub_router)
  end

  pub def mount(path : String, router : Router) : Nil
    @sub_routers << SubRouter.new(path: path, router: router)
  end

  pub def mount(router : Router) : Nil
    mount("", router)
  end

  # The page for *status_code*. The block may take the cause as a second
  # parameter: the `Panicked` a route's panic was caught as, for a 500;
  # the error a route answered, when no `error` for its type caught it;
  # otherwise a `StatusError` for the status.
  @[Share(serial: workers)]
  pub def error(status_code : Int32, *, workers : Int32? = nil, &block : Context, Error -> B) : Nil forall B : IntoBody
    what = "error " + status_code.to_s
    @error_handlers[status_code] = kept_serial?(workers, what) ? KeptPage.new(->(pair : {Context, Error}) : String? { block.call(pair[0], pair[1]).into_body }, what) : KeptPage.new(SharedProc({Context, Error}, String?).of { |pair| block.call(pair[0], pair[1]).into_body.as(String?) })
  end

  # The page for an error of type *type*, or of a subclass of it: Kemal's
  # `error MyException`. It takes an error a route answers, and a panic in
  # a route as `Panicked` (or `Error`). The response has the error's status,
  # 500 unless it is an `HttpError`, unless the block sets another. Pages
  # for types are tried in the order they were registered, and the first
  # that matches renders, before any `error` page for the status.
  @[Share(serial: workers)]
  pub def error(type : E.class, *, workers : Int32? = nil, &block : Context, E -> B) : Nil forall E : Error, B : IntoBody
    what = "error " + E.to_s
    @error_types[E.to_s] = kept_serial?(workers, what) ? KeptPage.new(->(pair : {Context, Error}) : String? {
      failure = pair[1]
      failure.is_a?(E) ? block.call(pair[0], failure).into_body : nil
    }, what) : KeptPage.new(SharedProc({Context, Error}, String?).of { |pair|
      failure = pair[1]
      failure.is_a?(E) ? block.call(pair[0], failure).into_body.as(String?) : nil
    })
  end

  pub def error_handler(status_code : Int32) : ErrorPage?
    error_handlers[status_code]?
  end

  # Parent first, then each mount, so a nested `error 404` replaces the
  # parent's for the same code. Routes and filters already flatten this way.
  pub def error_handlers : Hash(Int32, ErrorPage)
    collected = {} of Int32 => ErrorPage
    kept_error_pages.each do |code, kept|
      page = kept.serial
      collected[code] = ->(ctx : Context, cause : Error) { page.call({ctx, cause}) || "" }
    end
    collected
  end

  # Flattened like `error_handlers`: a mount's page for a type replaces
  # the parent's in the parent's place in the order. `Server` takes these
  # for a panic, beside `error_handlers`.
  pub def error_type_handlers : Hash(String, ErrorTypePage)
    collected = {} of String => ErrorTypePage
    kept_error_types.each do |name, kept|
      page = kept.serial
      collected[name] = ->(ctx : Context, failure : Error) { page.call({ctx, failure}) }
    end
    collected
  end

  pub def kept_error_pages : Hash(Int32, KeptPage)
    collected = {} of Int32 => KeptPage
    @error_handlers.each { |code, page| collected[code] = page }
    @sub_routers.each do |sub|
      sub.router.kept_error_pages.each { |code, page| collected[code] = page }
    end
    collected
  end

  pub def kept_error_types : Hash(String, KeptPage)
    collected = {} of String => KeptPage
    @error_types.each { |name, page| collected[name] = page }
    @sub_routers.each do |sub|
      sub.router.kept_error_types.each { |name, page| collected[name] = page }
    end
    collected
  end

  pub def routes(base_prefix : String = "") : Array(Route)
    kept_routes(base_prefix).map { |route| Route.new(route[0], route[1], route[2].serial) }
  end

  # Method, full path and block of every route, mounts included.
  pub def kept_routes(base_prefix : String = "") : Array(Tuple(String, String, KeptRoute))
    full_prefix = join_paths(base_prefix, @prefix)
    collected = [] of Tuple(String, String, KeptRoute)
    @routes.each do |route|
      collected << {route.method, join_paths(full_prefix, route.path), route.handler}
    end
    @sub_routers.each do |sub|
      collected.concat(sub.router.kept_routes(join_paths(full_prefix, sub.path)))
    end
    collected
  end

  pub def ws_routes(base_prefix : String = "") : Array(SocketRoute)
    kept_sockets(base_prefix).map do |socket|
      block = socket[1].serial
      SocketRoute.new(socket[0], ->(ws : WebSocket, ctx : Context) { block.call({ws, ctx}) })
    end
  end

  pub def kept_sockets(base_prefix : String = "") : Array(Tuple(String, KeptSocket))
    full_prefix = join_paths(base_prefix, @prefix)
    collected = [] of Tuple(String, KeptSocket)
    @sockets.each do |socket|
      collected << {join_paths(full_prefix, socket.path), socket.handler}
    end
    @sub_routers.each do |sub|
      collected.concat(sub.router.kept_sockets(join_paths(full_prefix, sub.path)))
    end
    collected
  end

  pub def filters(base_prefix : String = "") : Array(Tuple(Symbol, String, String, HandlerProc))
    kept_filters(base_prefix).map do |filter|
      block = filter[3].serial
      {filter[0], filter[1], filter[2], ->(ctx : Context) { answer = block.call(ctx); answer.is_a?(String) ? answer : "" }}
    end
  end

  pub def kept_filters(base_prefix : String = "") : Array(Tuple(Symbol, String, String, KeptRoute))
    full_prefix = join_paths(base_prefix, @prefix)
    collected = [] of Tuple(Symbol, String, String, KeptRoute)
    @filters.each do |filter|
      collected << {filter.kind, filter.method, join_paths(full_prefix, filter.path), filter.handler}
    end
    @sub_routers.each do |sub|
      collected.concat(sub.router.kept_filters(join_paths(full_prefix, sub.path)))
    end
    collected
  end

  # What a block registered with `workers: 1` was registered as, here or
  # in a mount: the reason this router cannot be served on more than one
  # thread. Nil when every block was checked.
  pub def serial_label : String?
    @routes.each { |route| return route.handler.label unless route.handler.shared? }
    @filters.each { |filter| return filter.handler.label unless filter.handler.shared? }
    @sockets.each { |socket| return socket.handler.label unless socket.handler.shared? }
    @error_handlers.each_value { |page| return page.label unless page.shared? }
    @error_types.each_value { |page| return page.label unless page.shared? }
    @sub_routers.each do |sub|
      if label = sub.router.serial_label
        return label
      end
    end
    nil
  end

  private def add_route(method : String, path : String, kept : KeptRoute) : Nil
    raise "path must start with /" unless path.starts_with?('/')
    @routes << RouteDefinition.new(method: method, path: path, handler: kept)
  end

  private def add_filter(kind : Symbol, method : String, path : String, kept : KeptRoute) : Nil
    @filters << FilterDefinition.new(kind: kind, method: method, path: path, handler: kept)
  end

  private def add_socket(path : String, kept : KeptSocket) : Nil
    raise "path must start with /" unless path.starts_with?('/')
    @sockets << SocketDefinition.new(path: path, handler: kept)
  end
end

# What a route's block answered, as the router keeps it: an error as it
# is, anything else as its body. Where a route answering something that is
# not an `IntoBody` is refused, naming the member that is not. A function
# rather than a method, so a kept block calling it reaches no router.
private def route_answer(result : R) : String | Error forall R
  result.is_a?(::Error) ? result.as(Error) : body_of(result)
end

private def body_of(value : IntoBody) : String
  value.into_body
end

# A route in the tree: its method, its path as declared, and its block.
pub struct RouteEntry(B)
  getter method : String
  getter path : String
  getter block : B

  def initialize(@method : String, @path : String, @block : B)
  end
end

# A filter: before or after, the method it is for ("ALL" for every one),
# its path, and its block.
pub struct FilterEntry(B)
  getter kind : Symbol
  getter method : String
  getter path : String
  getter block : B

  def initialize(@kind : Symbol, @method : String, @path : String, @block : B)
  end
end

# A router's routes, filters and pages, made once and only read after: the
# last handler of a chain. Look the route up, run before-filters, call the
# block, run after-filters, and render 404/405 when nothing matched. HEAD
# falls back to GET the way RFC 9110 §9.3.1 asks.
#
# `before_all` filters also run for a request no route matched, before
# its 404 or 405, so an authentication or logging filter sees it too.
# Per-method before filters and every after filter run only for a match.
#
# A `ws` route takes a request whose `Upgrade` names `websocket`: a GET
# runs the before filters for GET, then the handshake, which answers 101
# or refuses with 400, 403 or 426 and closes the connection, then the
# after filters. A before filter that halts or leaves an error status
# refuses the upgrade too. Another method is left to an HTTP route that
# serves it, or is refused with 405. A request that does not ask to
# upgrade is routed as usual; a GET only a `ws` route serves gets 426
# with `Upgrade: websocket`.
#
# Generic over the blocks it calls - `Proc`s for a server on one thread,
# `SharedProc`s for one on every worker, where it is `Share` - and over
# where it reads its settings: the live `Config` on one thread, the copy a
# server on every worker took when it started (`Settings`).
pub class Routing(R, E, W, S)
  @tree : FrozenTree(RouteEntry(R))
  @filters : List(FilterEntry(R))
  @pages : List(Tuple(Int32, E))
  @type_pages : List(E)
  @methods : List(String)
  @sockets : FrozenTree(RouteEntry(W))
  @settings : S

  def initialize(routes : Array(Tuple(String, String, R)), filters : Array(FilterEntry(R)), pages : Array(Tuple(Int32, E)), type_pages : Array(E), sockets : Array(Tuple(String, W)), @settings : S)
    tree = Tree(RouteEntry(R)).new
    methods = [] of String
    routes.each do |route|
      unless tree.add("/" + route[0] + route[1], RouteEntry(R).new(route[0], route[1], route[2]))
        raise "route #{route[0]} #{route[1]} is defined twice"
      end
      methods << route[0] unless methods.includes?(route[0])
    end
    socket_tree = Tree(RouteEntry(W)).new
    sockets.each do |socket|
      raise "ws #{socket[0]} is defined twice" unless socket_tree.add(socket[0], RouteEntry(W).new("GET", socket[0], socket[1]))
    end
    @tree = tree.frozen
    @filters = List.new(filters)
    @pages = List.new(pages)
    @type_pages = List.new(type_pages)
    @methods = List.new(methods)
    @sockets = socket_tree.frozen
  end

  pub def call(ctx : Context) : Nil
    return if ctx.halted?

    method = ctx.request.method
    path = ctx.routing_path

    if method == "QUERY" && !ctx.request.body.empty? && ctx.request.content_type.empty?
      render_error(ctx, 400)
      drop_head_body(ctx)
      return
    end

    if WebSocket.upgrade_request?(ctx.request)
      if socket = @sockets.find(path)
        return if serve_socket(ctx, socket)
      end
    end

    match = lookup(method, path)

    unless match
      run_filters(ctx, :before, "ALL", path, true)
      if ctx.halted?
        drop_head_body(ctx)
        return
      end
      allowed = allowed_methods(path)
      if !allowed.empty? && !allowed.includes?(method)
        ctx.response.headers["Allow"] = allowed.join(", ")
        render_error(ctx, 405)
        drop_head_body(ctx)
        return
      end
      if method == "GET" && @sockets.find(path)
        # RFC 9110 §15.5.22: the path speaks WebSocket and nothing else.
        ctx.response.headers["Upgrade"] = "websocket"
        render_error(ctx, 426)
        return
      end
      render_error(ctx, 404)
      drop_head_body(ctx)
      return
    end

    route = match.payload
    ctx.params.update_url(captured(ctx, match.params))
    ctx.matched(route.method, route.path)

    run_filters(ctx, :before, route.method, path)
    if ctx.halted?
      drop_head_body(ctx)
      return
    end

    # A before filter that left an error status with a page of its own
    # gets that page, and the route does not run.
    if ctx.response.status_code >= 400
      if custom = page_for(ctx.response.status_code)
        render_page(ctx, custom, StatusError.new(ctx.response.status_code))
        drop_head_body(ctx)
        return
      end
    end

    # The `BodyError` `env.params.json_as` would answer, so a page for that
    # type, or for 400, takes it.
    if @settings.reject_unreadable_body && !ctx.params.json_valid?
      render_failure(ctx, BodyError.new(400, "malformed JSON: " + (ctx.params.json_error || "")))
      drop_head_body(ctx)
      return
    end

    if @settings.reject_unreadable_body && (unreadable = ctx.params.body_error)
      render_error(ctx, unreadable)
      drop_head_body(ctx)
      return
    end

    answer = route.block.call(ctx)
    if ctx.halted?
      drop_head_body(ctx)
      return
    end

    case answer
    in Error
      # An error the route answered ends it the way a panic does: the after
      # filters do not run, and its page replaces whatever was written.
      render_failure(ctx, answer)
      drop_head_body(ctx)
      return
    in String
      # A helper like `env.text` already wrote the body and returned nil.
      # Replacing that with the empty IntoBody would wipe it.
      ctx.response.set_body(answer) unless answer.empty? && !ctx.response.body.empty?
    end

    run_filters(ctx, :after, route.method, path)

    if custom = page_for(ctx.response.status_code)
      if ctx.response.status_code >= 400
        render_page(ctx, custom, StatusError.new(ctx.response.status_code))
      end
    end

    drop_head_body(ctx)
  end

  # The route *method* and *path* take, HEAD falling back to GET.
  pub def lookup(method : String, path : String) : Match(RouteEntry(R))?
    found = @tree.find("/" + method + path)
    return found if found
    return @tree.find("/GET" + path) if method == "HEAD"
    nil
  end

  # The `error` page for *status*, if there is one.
  private def page_for(status : Int32) : E?
    @pages.each { |entry| return entry[1] if entry[0] == status }
    nil
  end

  private def drop_head_body(ctx : Context) : Nil
    return unless ctx.request.method == "HEAD"
    status = ctx.response.status_code
    bodiless = status == 204 || status == 304 || (status >= 100 && status < 200)
    unless ctx.response.headers.has_key?("Content-Length") || bodiless
      ctx.response.headers["Content-Length"] = ctx.response.body.bytesize.to_s
    end
    ctx.response.set_body("")
  end

  private def allowed_methods(path : String) : Array(String)
    allowed = [] of String
    @methods.each do |method|
      if @tree.find("/" + method + path)
        allowed << method
      end
    end
    if allowed.includes?("GET") && !allowed.includes?("HEAD")
      allowed << "HEAD"
    end
    # The handshake is a GET, and a `ws` route serves nothing else, so it
    # adds GET but no HEAD.
    return allowed if allowed.includes?("GET") || @sockets.find(path).nil?
    ["GET"] + allowed
  end

  # A match's segments as the route reads them: decoded either way.
  private def captured(ctx : Context, params : Hash(String, String)) : Hash(String, String)
    ctx.route_on_raw_path? ? params.transform_values { |value| decode_path(value) } : params
  end

  # An upgrade request on a `ws` route. False when it is not the route's to
  # answer: a method other than GET that an HTTP route on the path serves.
  private def serve_socket(ctx : Context, found : Match(RouteEntry(W))) : Bool
    method = ctx.request.method
    path = ctx.routing_path
    unless method == "GET"
      return false if lookup(method, path)
      run_filters(ctx, :before, "ALL", path, true)
      unless ctx.halted?
        ctx.response.headers["Allow"] = allowed_methods(path).join(", ")
        refuse_upgrade(ctx, 405)
      end
      drop_head_body(ctx)
      return true
    end

    socket = found.payload
    ctx.params.update_url(captured(ctx, found.params))
    ctx.matched("GET", socket.path)
    run_filters(ctx, :before, "GET", path)
    return true if ctx.halted?
    if ctx.response.status_code >= 400
      # A filter that answered with an error refused the upgrade.
      if custom = page_for(ctx.response.status_code)
        ctx.response.set_body(custom.call({ctx, StatusError.new(ctx.response.status_code).as(Error)}) || "")
      end
      ctx.response.headers["Connection"] = "close"
      return true
    end

    if status = WebSocket.refusal(ctx.request, @settings.websocket_allowed_origins)
      refuse_upgrade(ctx, status)
    else
      block = socket.block
      WebSocket.accept(ctx, @settings.websocket_max_message_size, ->(ws : WebSocket, env : Context) { block.call({ws, env}) })
    end
    run_filters(ctx, :after, "GET", path)
    true
  end

  # A refused handshake also closes the connection, so nothing pipelined
  # behind it is read as the next request: Kemal's guard against
  # smuggling a request past a proxy that took the upgrade as done.
  private def refuse_upgrade(ctx : Context, status : Int32) : Nil
    render_error(ctx, status)
    ctx.response.headers["Sec-WebSocket-Version"] = "13" if status == 426
    ctx.response.headers["Connection"] = "close"
  end

  # *only_all* limits the run to filters registered for every method: what
  # an unmatched request gets.
  private def run_filters(ctx : Context, kind : Symbol, method : String, path : String, only_all : Bool = false) : Nil
    @filters.each do |filter|
      next unless filter.kind == kind
      if only_all
        next unless filter.method == "ALL"
      else
        next unless filter.method.in?("ALL", method)
      end
      next unless pattern_matches?(filter.path, path)
      filter.block.call(ctx)
      return if ctx.halted?
    end
  end

  private def render_error(ctx : Context, status : Int32) : Nil
    ctx.response.status_code = status
    if handler = page_for(status)
      render_page(ctx, handler, StatusError.new(status))
    else
      ctx.response.content_type = "text/html; charset=utf-8"
      ctx.response.set_body(status.to_s + " " + phrase(status))
    end
  end

  # An error a route answered gets the first page registered for its
  # type, with its status: an `HttpError`'s own, else 500, unless that
  # page sets another. With none, it gets the page for that status, told
  # the error. Without one either, the built-in page: an `HttpError` below
  # 500 is the client's and shows its message; any other shows it only
  # under `show_exceptions`, as for a panic.
  private def render_failure(ctx : Context, failure : Error) : Nil
    status = failure.is_a?(HttpError) ? failure.status : 500
    ctx.response.status_code = status
    ctx.response.set_body("")
    return if render_error_type_page(ctx, failure, @type_pages)
    if page = page_for(status)
      render_page(ctx, page, failure)
    elsif failure.is_a?(HttpError) && status < 500
      render_client_error_page(ctx, failure)
    else
      render_failure_page(ctx, failure.message, @settings.show_exceptions?, status)
    end
  end

  # An error page answers its body, or writes it with a helper such as
  # `env.json` and answers nil. What the response held before - a route's
  # own body, a halt's message - is not the page, so it goes first.
  private def render_page(ctx : Context, page : E, cause : Error) : Nil
    ctx.response.set_body("")
    body = page.call({ctx, cause.as(Error)}) || ""
    ctx.response.set_body(body) unless body.empty?
  end
end

# The routing for a server on one thread: every block a `Proc`, settings
# read from *settings* as they stand at each request.
alias SerialRouting = Routing(RouteProc, Proc({Context, Error}, String?), Proc({WebSocket, Context}, Nil), Config)

pub def serial_routing(router : Router, settings : Config) : SerialRouting
  routes = router.kept_routes.map { |route| {route[0], route[1], route[2].serial} }
  filters = router.kept_filters.map { |filter| FilterEntry(RouteProc).new(filter[0], filter[1], filter[2], filter[3].serial) }
  pages = router.kept_error_pages.map { |code, page| {code, page.serial} }
  type_pages = router.kept_error_types.values.map(&.serial)
  sockets = router.kept_sockets.map { |socket| {socket[0], socket[1].serial} }
  SerialRouting.new(routes, filters, pages, type_pages, sockets, settings)
end

# The routing for a server on every worker: every block a `SharedProc`,
# so the whole of it is `Share`. Only for a router whose `serial_label` is
# nil; one that holds a block registered with `workers: 1` is refused.
pub def shared_routing(router : Router, settings : S) : Routing(SharedProc(Context, String | Error), SharedProc({Context, Error}, String?), SharedProc({WebSocket, Context}, Nil), S) forall S
  routes = router.kept_routes.map { |route| {route[0], route[1], shared_of(route[2])} }
  filters = router.kept_filters.map { |filter| FilterEntry(SharedProc(Context, String | Error)).new(filter[0], filter[1], filter[2], shared_of(filter[3])) }
  pages = router.kept_error_pages.map { |code, page| {code, shared_of(page)} }
  type_pages = router.kept_error_types.values.map { |page| shared_of(page) }
  sockets = router.kept_sockets.map { |socket| {socket[0], shared_of(socket[1])} }
  Routing(SharedProc(Context, String | Error), SharedProc({Context, Error}, String?), SharedProc({WebSocket, Context}, Nil), S).new(routes, filters, pages, type_pages, sockets, settings)
end

private def shared_of(kept : Kept(A, R)) : SharedProc(A, R) forall A, R
  kept.shared || raise "#{kept.label} was registered with workers: 1, and a server on more than one worker cannot run it"
end

# The last handler in the chain a test or a server on one thread runs: a
# router's routing, with *settings* (the process config unless another is
# given) read at each request for the WebSocket origin list and message
# limit and whether the 500 page shows an error's message.
pub class RouteHandler < Handler
  @routing : SerialRouting

  def initialize(router : Router, settings : Config = config)
    super()
    @routing = serial_routing(router, settings)
  end

  pub def call(ctx : Context) : Nil
    @routing.call(ctx)
  end

  # The route *method* and *path* take, HEAD falling back to GET.
  pub def lookup(method : String, path : String) : Match(RouteEntry(RouteProc))?
    @routing.lookup(method, path)
  end
end
