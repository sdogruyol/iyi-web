# URL, query, form and JSON params, each their own table, and a combined
# lookup that prefers the most specific: url, then query, then body.
# `env.params.url["id"]` without Crystal's `HTTP::Params`. The tables keep
# the last value of a repeated name; `query_all` and `body_all` keep them
# all, in order.
#
# A JSON body (`application/json`, or any `application/*+json`) and a
# `multipart/form-data` body are parsed once, on first use. The router
# asks `json_valid?` and `body_error` before the route runs, so a request
# whose body cannot be read gets a 400 (or a 413 for a breached upload
# limit) rather than a route reading empty tables. Uploaded files live in
# temporary files until `cleanup`, which the server calls once the
# response is written.
module iyi_web/params

import std/json::{JSON, Any}
import iyi_web/codec::*
import iyi_web/request::{Request}
import iyi_web/multipart::{FileUpload, Multipart, MultipartError, multipart_boundary, parse_multipart}

pub class Params
  @url : Hash(String, String)
  @query : Hash(String, String)
  @body : Hash(String, String)
  @query_pairs : Array(Tuple(String, String))
  @body_pairs : Array(Tuple(String, String))
  @raw_body : String
  @media_type : String
  @content_type : String
  @json : Hash(String, Any)
  @json_state : Int32
  @files : Hash(String, FileUpload)
  @all_files : Hash(String, Array(FileUpload))
  @uploads : Array(FileUpload)
  @body_state : Int32
  @max_files : Int32
  @max_field_size : Int32

  # *query_pairs* and *body_pairs* are every value in the order sent; left
  # out, each is the table's one value per key.
  def initialize(@url : Hash(String, String), @query : Hash(String, String), @body : Hash(String, String), @raw_body : String = "", @media_type : String = "", @content_type : String = "", query_pairs : Array(Tuple(String, String))? = nil, body_pairs : Array(Tuple(String, String))? = nil)
    @query_pairs = query_pairs || pairs_of(@query)
    @body_pairs = body_pairs || pairs_of(@body)
    @json = {} of String => Any
    @json_state = 0
    @files = {} of String => FileUpload
    @all_files = {} of String => Array(FileUpload)
    @uploads = [] of FileUpload
    @body_state = 0
    @max_files = 128
    @max_field_size = 8 * 1024 * 1024
  end

  def self.empty : Params
    Params.new({} of String => String, {} of String => String, {} of String => String)
  end

  def self.from(request : Request, url : Hash(String, String)) : Params
    query = parse_query_pairs(request.query_string)
    body = parse_body(request)
    Params.new(url, table_of(query), table_of(body), request.body, request.content_type.downcase, request.headers["content-type"]? || "", query, body)
  end

  pub def url : Hash(String, String)
    @url
  end

  pub def query : Hash(String, String)
    @query
  end

  # Every value sent for *key* in the query string, in order; empty when
  # there is none. `?tag=a&tag=b` gives `["a", "b"]` where `query["tag"]`
  # is `"b"`. A name is matched as sent: `tag[]` is not `tag`.
  pub def query_all(key : String) : Array(String)
    values_of(@query_pairs, key)
  end

  # Form fields: an `application/x-www-form-urlencoded` body, or the text
  # parts of a `multipart/form-data` one.
  pub def body : Hash(String, String)
    parse_multipart_body
    @body
  end

  # Every value of the form field *key*, in order; empty when there is none.
  # Covers the same fields as `body`.
  pub def body_all(key : String) : Array(String)
    parse_multipart_body
    values_of(@body_pairs, key)
  end

  # The request body as it arrived, whatever its type.
  pub def raw_body : String
    @raw_body
  end

  # A JSON object body's members. A top-level array is under `"_json"`; a
  # scalar, an empty body or a body of another type gives an empty table.
  pub def json : Hash(String, Any)
    parse_json
    @json
  end

  # False only when the request declares a JSON body that does not parse.
  pub def json_valid? : Bool
    parse_json
    @json_state != 2
  end

  # Uploaded files by field name. A later file under the same name
  # replaces an earlier one; names ending in `[]` are in `all_files`.
  pub def files : Hash(String, FileUpload)
    parse_multipart_body
    @files
  end

  # Every file sent under a name ending in `[]`, keyed with the brackets.
  pub def all_files : Hash(String, Array(FileUpload))
    parse_multipart_body
    @all_files
  end

  # The status a multipart body that could not be read earns: 400 when it
  # is malformed, 413 when it breaks an upload limit. Nil otherwise.
  pub def body_error : Int32?
    parse_multipart_body
    @body_state > 1 ? @body_state : nil
  end

  # Most file parts, and largest text field in bytes, a multipart body may
  # carry. The server sets them from the configuration.
  pub def limit_uploads(max_files : Int32, max_field_size : Int32) : Nil
    @max_files = max_files
    @max_field_size = max_field_size
  end

  # Deletes every uploaded file's temporary copy.
  pub def cleanup : Nil
    @uploads.each(&.delete)
  end

  pub def []?(key : String) : String?
    @url[key]? || @query[key]? || body[key]?
  end

  pub def [](key : String) : String
    self[key]? || raise "no such param #{key.inspect}"
  end

  pub def has_key?(key : String) : Bool
    !self[key]?.nil?
  end

  pub def update_url(url : Hash(String, String)) : Nil
    @url = url
  end

  private def parse_json : Nil
    return unless @json_state == 0
    @json_state = 1
    return unless json_media_type?(@media_type)
    return if @raw_body.empty?
    parsed = JSON.parse?(@raw_body)
    unless parsed
      @json_state = 2
      return
    end
    if members = parsed.as_h?
      @json = members
    elsif parsed.as_a?
      table = {} of String => Any
      table["_json"] = parsed
      @json = table
    end
  end

  private def parse_multipart_body : Nil
    return unless @body_state == 0
    @body_state = 1
    return unless @media_type == "multipart/form-data"
    boundary = multipart_boundary(@content_type)
    unless boundary
      @body_state = 400
      return
    end
    case result = parse_multipart(@raw_body, boundary, @max_files, @max_field_size)
    in MultipartError
      @body_state = result.status
    in Multipart
      result.fields.each do |field|
        @body[field[0]] = field[1]
        @body_pairs << field
      end
      result.files.each { |upload| keep(upload) }
    end
  end

  private def keep(upload : FileUpload) : Nil
    @uploads << upload
    if upload.name.ends_with?("[]")
      list = @all_files[upload.name]? || [] of FileUpload
      list << upload
      @all_files[upload.name] = list
    else
      if previous = @files[upload.name]?
        previous.delete
      end
      @files[upload.name] = upload
    end
  end
end

private def json_media_type?(type : String) : Bool
  return true if type == "application/json"
  type.starts_with?("application/") && type.ends_with?("+json")
end

private def parse_body(request : Request) : Array(Tuple(String, String))
  return [] of Tuple(String, String) if request.body.empty?

  type = request.content_type.downcase
  if type == "application/x-www-form-urlencoded"
    parse_query_pairs(request.body)
  else
    [] of Tuple(String, String)
  end
end

# Last wins, as in `parse_query`.
private def table_of(pairs : Array(Tuple(String, String))) : Hash(String, String)
  table = {} of String => String
  pairs.each { |pair| table[pair[0]] = pair[1] }
  table
end

private def pairs_of(table : Hash(String, String)) : Array(Tuple(String, String))
  pairs = [] of Tuple(String, String)
  table.each { |name, value| pairs << {name, value} }
  pairs
end

private def values_of(pairs : Array(Tuple(String, String)), key : String) : Array(String)
  values = [] of String
  pairs.each { |pair| values << pair[1] if pair[0] == key }
  values
end
