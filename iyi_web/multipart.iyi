# `multipart/form-data` bodies (RFC 7578): the text fields in the order
# they were sent, and every file part spooled to a temporary file in a
# directory of its own.
#
# A body is read as it arrives (`RequestBody`), so an upload streams from
# the socket to its file a read at a time and never sits whole in
# memory; a body already in a String is read the same way. Bytes, not
# text: a file's contents come out exactly as the client sent them, NUL,
# CR and LF included. A part is a file when its Content-Disposition
# carries a `filename` parameter, even an empty one.
#
# Field names and filenames are used as sent. Nothing is sanitised: a
# filename can be `../../etc/passwd` or contain any byte a header value may
# hold, so never join it to a directory without cleaning it first.
#
# Parsing is all or nothing. A malformed body is a 400 and a breached limit
# a 413 - a body that stopped arriving the 408 or 400 its read earned -
# and either way every temporary file already written is deleted before
# the error is returned. On success the caller owns the files and calls
# `delete` when the request is over.
@[Unsafe("header parameters are scanned through the string's buffer, and a quoted value is unescaped into a buffer it allocates and copies into the string")]
module iyi_web/multipart

import std/file::{File}
import std/dir::{Dir}
import std/text
import iyi_web/headers::{Headers}
import iyi_web/request::{RequestBody, BodyFailure}
import iyi_web/token::{random_hex}

TEMPFILE_PREFIX = "iyi-web-upload"

# One file part, spooled to disk under `path`.
pub class FileUpload
  @name : String
  @filename : String
  @path : String
  @headers : Headers
  @size : Int32
  @spool_dir : String?

  def initialize(@name : String, @filename : String, @path : String, @headers : Headers, @size : Int32, @spool_dir : String? = nil)
  end

  # The form field name, e.g. `avatar` or `photos[]`.
  pub def name : String
    @name
  end

  # The client's filename, unsanitised; may be empty.
  pub def filename : String
    @filename
  end

  # The temporary file holding the upload.
  pub def path : String
    @path
  end

  # The part's own headers (Content-Disposition, Content-Type, ...).
  pub def headers : Headers
    @headers
  end

  # The part's Content-Type as sent, or "" when it carried none.
  pub def content_type : String
    @headers["Content-Type"]? || ""
  end

  # Bytes written to the temporary file.
  pub def size : Int32
    @size
  end

  # The whole upload. Reads the file each time it is called.
  pub def read : String
    File.read(@path)
  end

  # Removes the temporary file, and the directory it was spooled into once
  # that is empty. Safe to call more than once.
  pub def delete : Nil
    File.delete(@path) if File.exists?(@path)
    if dir = @spool_dir
      Dir.delete?(dir)
    end
  end
end

# A parsed body: text fields in order, repeated names kept, and file parts.
pub class Multipart
  @fields : Array(Tuple(String, String))
  @files : Array(FileUpload)

  def initialize(@fields : Array(Tuple(String, String)), @files : Array(FileUpload))
  end

  pub def fields : Array(Tuple(String, String))
    @fields
  end

  pub def files : Array(FileUpload)
    @files
  end

  # Deletes every file part's temporary file.
  pub def delete : Nil
    @files.each { |upload| upload.delete }
  end
end

# Why a body was refused: 400 when it is malformed, 413 when it breaches a
# limit.
pub class MultipartError
  @status : Int32
  @message : String

  def initialize(@status : Int32, @message : String)
  end

  pub def status : Int32
    @status
  end

  pub def message : String
    @message
  end
end

impl Error for MultipartError
  def message : String
    @message
  end
end

# The `boundary` parameter of a `multipart/*` Content-Type, quoted or not.
# Nil when the media type is not multipart or the parameter is missing or
# empty.
pub def multipart_boundary(content_type : String) : String?
  parsed = parse_header_params(content_type)
  return nil unless parsed[0].downcase.starts_with?("multipart/")
  boundary = nil
  parsed[1].each do |param|
    boundary = param[1] if param[0] == "boundary"
  end
  return nil unless boundary
  return nil if boundary.empty?
  boundary
end

# Parses a whole `multipart/form-data` body held in a string: the
# streaming parser below, fed from it.
pub def parse_multipart(body : String, boundary : String, max_files : Int32, max_field_size : Int32) : Multipart | MultipartError
  parse_multipart(RequestBody.text(body), boundary, max_files, max_field_size)
end

# Parses a `multipart/form-data` body as it arrives from *source*, the
# request's body still on the connection: each file part is written to
# its temporary file a piece at a time as the pieces come, so an upload
# costs a read's worth of memory and not its size. At most *max_files*
# file parts are accepted and a text field may hold at most
# *max_field_size* bytes; past either limit the answer is a 413, and so is
# a body past the request's own limit (`max_request_body_size`, the
# source's). A body that stops arriving answers the source's status:
# 408 when it was too slow, 400 when it broke off. A body with no parts at
# all (`--boundary--`) is an empty form, not an error; what follows the
# closing boundary is read and dropped, so the connection's next request
# starts where it should.
# *piece* is the most read from *source* at once.
pub def parse_multipart(source : RequestBody, boundary : String, max_files : Int32, max_field_size : Int32, piece : Int32 = 65536) : Multipart | MultipartError
  return MultipartError.new(400, "multipart boundary is empty") if boundary.empty?
  fields = [] of Tuple(String, String)
  files = [] of FileUpload
  outcome = read_parts(PartReader.new(source, piece), boundary, fields, files, max_files, max_field_size)
  if outcome
    discard(files)
    return outcome
  end
  Multipart.new(fields, files)
end

# The longest part header block: past it the part's headers are refused
# as never ending rather than read for as long as the client sends.
MAX_PART_HEADERS = 65536

# Every part of the body into *fields* and *files*, or why not.
private def read_parts(reader : PartReader, boundary : String, fields : Array(Tuple(String, String)), files : Array(FileUpload), max_files : Int32, max_field_size : Int32) : MultipartError?
  dash = "--" + boundary
  delimiter = "\r\n" + dash
  # The first boundary opens the body or starts a line; anything before
  # it is preamble and dropped as it is read past.
  if failed = reader.want(dash.bytesize)
    return failed
  end
  if reader.starts_with?(dash)
    reader.skip(dash.bytesize)
  else
    found = reader.seek(delimiter)
    return found if found.is_a?(MultipartError)
    return MultipartError.new(400, "multipart body has no boundary") unless found
  end

  while true
    if failed = reader.want(2)
      return failed
    end
    if reader.starts_with?("--")
      # The closing boundary: the epilogue is read past, unkept.
      return reader.drain
    end
    # Optional spaces or tabs, then CRLF, open the next part.
    line = reader.line(1024)
    return line if line.is_a?(MultipartError)
    return MultipartError.new(400, "malformed multipart boundary line") unless line && padding?(line)
    if problem = read_part(reader, delimiter, fields, files, max_files, max_field_size)
      return problem
    end
  end
  nil
end

# One part: its headers, then its content up to the next delimiter, which
# is taken with it.
private def read_part(reader : PartReader, delimiter : String, fields : Array(Tuple(String, String)), files : Array(FileUpload), max_files : Int32, max_field_size : Int32) : MultipartError?
  if failed = reader.want(2)
    return failed
  end
  header_block = ""
  if reader.starts_with?("\r\n")
    reader.skip(2)
  else
    block = reader.head(delimiter, MAX_PART_HEADERS)
    return block if block.is_a?(MultipartError)
    header_block = block
  end

  headers = part_headers(header_block)
  return MultipartError.new(400, "malformed multipart part header") unless headers
  disposition = headers["Content-Disposition"]?
  return MultipartError.new(400, "multipart part has no Content-Disposition") unless disposition

  parsed = parse_header_params(disposition)
  return MultipartError.new(400, "multipart part is not form-data") unless parsed[0].downcase == "form-data"
  name = nil
  filename = nil
  parsed[1].each do |param|
    name = param[1] if param[0] == "name"
    filename = param[1] if param[0] == "filename"
  end
  return MultipartError.new(400, "multipart part has no name") unless name

  if filename
    # Counted before the part is spooled, so a refused body costs no
    # temporary file beyond the ones already accepted.
    return MultipartError.new(413, "Too many file parts (max #{max_files})") if files.size >= max_files
    dir = spool_dir
    path = File.join(dir, "upload")
    file = File.open(path, "w", 65536, 0o600)
    written = reader.content(delimiter, -1) { |piece| file.write(piece) }
    file.close
    if written.is_a?(MultipartError)
      FileUpload.new(name, filename, path, headers, 0, dir).delete
      return written
    end
    files << FileUpload.new(name, filename, path, headers, written, dir)
  else
    builder = String::Builder.new
    size = reader.content(delimiter, max_field_size) { |piece| builder << piece }
    return size if size.is_a?(MultipartError)
    fields << {name, builder.to_s}
  end
  nil
end

private def padding?(line : String) : Bool
  line.each_byte { |byte| return false unless byte == 32_u8 || byte == 9_u8 }
  true
end

# What has arrived of the body and not been taken, and the source the
# rest comes from.
private class PartReader
  @source : RequestBody
  @pending : String
  @ended : Bool
  @piece : Int32

  def initialize(@source : RequestBody, @piece : Int32)
    @pending = ""
    @ended = false
  end

  # Reads until *count* bytes are pending or the body ends.
  def want(count : Int32) : MultipartError?
    while @pending.bytesize < count
      got = fill
      return got if got.is_a?(MultipartError)
      return nil unless got
    end
    nil
  end

  def starts_with?(text : String) : Bool
    @pending.starts_with?(text)
  end

  def skip(count : Int32) : Nil
    @pending = @pending[count, @pending.bytesize - count]
  end

  # Reads past everything up to and including *needle*, dropping what it
  # passes over: true once taken, false when the body ends first.
  def seek(needle : String) : Bool | MultipartError
    while true
      if at = @pending.index(needle)
        skip(at + needle.bytesize)
        return true
      end
      keep = needle.bytesize - 1
      skip(@pending.bytesize - keep) if @pending.bytesize > keep
      got = fill
      return got if got.is_a?(MultipartError)
      return false unless got
    end
    false
  end

  # A line ended by CRLF, taken with it and answered without it: nil when
  # the body ends first or *limit* bytes pass without one.
  def line(limit : Int32) : String | MultipartError | Nil
    while true
      if at = @pending.index("\r\n")
        text = @pending[0, at]
        skip(at + 2)
        return text
      end
      return nil if @pending.bytesize > limit
      got = fill
      return got if got.is_a?(MultipartError)
      return nil unless got
    end
    nil
  end

  # A part's header block, up to the blank line that ends it, taken with
  # it. Refused when *delimiter* comes first, when *limit* bytes pass
  # without the blank line, or when the body ends.
  def head(delimiter : String, limit : Int32) : String | MultipartError
    while true
      at = @pending.index("\r\n\r\n")
      ends = @pending.index(delimiter)
      if at && (ends.nil? || at + 4 <= ends)
        text = @pending[0, at]
        skip(at + 4)
        return text
      end
      return MultipartError.new(400, "multipart part headers are not terminated") if ends || @pending.bytesize > limit
      got = fill
      return got if got.is_a?(MultipartError)
      return MultipartError.new(400, "multipart body has no closing boundary") unless got
    end
    MultipartError.new(400, "multipart part headers are not terminated")
  end

  # The part's content up to *delimiter*, handed to *block* a piece at a
  # time and the delimiter taken: how many bytes it held. Past *limit*
  # bytes (when it is not -1) a 413; a body that ends first a 400. The
  # last bytes that could begin the delimiter are held back until the
  # next read says whether they do.
  def content(delimiter : String, limit : Int32, & : String -> Nil) : Int32 | MultipartError
    size = 0
    while true
      if at = @pending.index(delimiter)
        size = size + at
        return MultipartError.new(413, "Payload Too Large") if limit >= 0 && size > limit
        yield @pending[0, at] if at > 0
        skip(at + delimiter.bytesize)
        return size
      end
      keep = delimiter.bytesize - 1
      if @pending.bytesize > keep
        ready = @pending.bytesize - keep
        size = size + ready
        return MultipartError.new(413, "Payload Too Large") if limit >= 0 && size > limit
        yield @pending[0, ready]
        skip(ready)
      end
      got = fill
      return got if got.is_a?(MultipartError)
      return MultipartError.new(400, "multipart body has no closing boundary") unless got
    end
    size
  end

  # The rest of the body read and dropped: nil once it has ended.
  def drain : MultipartError?
    @pending = ""
    while true
      got = fill
      return got if got.is_a?(MultipartError)
      return nil unless got
      @pending = ""
    end
    nil
  end

  # One more piece onto what is pending: false at the body's end, and the
  # source's failure as the refusal it earns.
  private def fill : Bool | MultipartError
    return false if @ended
    piece = @source.read(@piece)
    case piece
    in BodyFailure
      MultipartError.new(piece.status, piece.reason)
    in String
      if piece.empty?
        @ended = true
        return false
      end
      @pending = @pending.empty? ? piece : @pending + piece
      true
    end
  end
end

# A new directory for one upload, mode 0700, under a name nobody can guess.
# `File.tempfile` names its files after the pid and a counter and writes
# through whatever already sits at the path, so another account sharing
# the temporary directory could plant a symlink there and have the upload
# written wherever it points. `mkdir` refuses any existing entry, a symlink
# included, and nobody else can create one inside the new directory.
private def spool_dir : String
  dir = File.join(Dir.tempdir, TEMPFILE_PREFIX + "-" + random_hex(16))
  Dir.mkdir(dir, 0o700)
  dir
end

# `Name: value` lines separated by CRLF. Nil when a line is not a header,
# so a malformed part is a 400 rather than a panic in `Headers`.
private def part_headers(block : String) : Headers?
  headers = Headers.new
  return headers if block.empty?
  block.split("\r\n").each do |line|
    colon = line.index(':')
    return nil unless colon
    name = line[0, colon]
    value = line[colon + 1, line.bytesize - colon - 1].strip
    return nil unless Headers.valid_name?(name) && Headers.valid_value?(value)
    headers.add(name, value)
  end
  headers
end

private def discard(files : Array(FileUpload)) : Nil
  files.each { |upload| upload.delete }
end

# Splits `kind; key=value; key="quoted value"` into the leading token and
# its parameters, in order. Keys are lowercased; a `;` inside a quoted
# string belongs to the value, and `\"` and `\\` inside one are unescaped.
# Any other backslash is kept, so a Windows path sent as a filename
# survives.
private def parse_header_params(text : String) : Tuple(String, Array(Tuple(String, String)))
  bytes = text.to_unsafe
  size = text.bytesize
  index = 0
  while index < size && bytes[index] != 59_u8
    index = index + 1
  end
  kind = text[0, index].strip
  params = [] of Tuple(String, String)

  while index < size
    index = index + 1
    key_start = index
    while index < size && bytes[index] != 61_u8 && bytes[index] != 59_u8
      index = index + 1
    end
    key = text[key_start, index - key_start].strip.downcase
    value = ""
    if index < size && bytes[index] == 61_u8
      index = index + 1
      while index < size && (bytes[index] == 32_u8 || bytes[index] == 9_u8)
        index = index + 1
      end
      if index < size && bytes[index] == 34_u8
        index = index + 1
        buffer = Pointer(UInt8).malloc((size - index + 1).to_u64)
        written = 0
        while index < size && bytes[index] != 34_u8
          byte = bytes[index]
          if byte == 92_u8 && index + 1 < size && (bytes[index + 1] == 34_u8 || bytes[index + 1] == 92_u8)
            index = index + 1
            byte = bytes[index]
          end
          buffer[written] = byte
          written = written + 1
          index = index + 1
        end
        value = String.new(written) do |target|
          target.copy_from(buffer, written)
        end
        while index < size && bytes[index] != 59_u8
          index = index + 1
        end
      else
        value_start = index
        while index < size && bytes[index] != 59_u8
          index = index + 1
        end
        value = text[value_start, index - value_start].strip
      end
    end
    params << {key, value} unless key.empty?
  end
  {kind, params}
end
