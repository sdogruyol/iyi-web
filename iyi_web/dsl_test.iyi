# The DSL writes onto the process app. `using` is what makes `get` a
# bare word; this file is that consumer.
module iyi_web/dsl_test

import iyi_web/dsl
import iyi_web/router
import iyi_web/harness
import iyi_web/config
import iyi_web/spec

using iyi_web/dsl
using iyi_web/router::{Router, RouteHandler}
using iyi_web/harness
using iyi_web/config
using iyi_web/spec

get "/dsl" do |env|
  "from-dsl"
end

post "/dsl" do |env|
  "posted-dsl"
end

before_all "/gated" do |env|
  env.halt(401, "gated")
  ""
end

get "/gated" do |env|
  "open"
end

error 404 do |env|
  "dsl-missing"
end

mounted = Router.new
mounted.get "/in" do |env|
  "mounted-dsl"
end
mount "/sub", mounted

describe "iyi_web/dsl" do
  it "registers GET and POST on the process app" do
    handler = RouteHandler.new(app)
    assert dispatch(handler, "GET", "/dsl").response.body == "from-dsl"
    assert dispatch(handler, "POST", "/dsl").response.body == "posted-dsl"
  end

  it "registers error handlers" do
    handler = RouteHandler.new(app)
    assert dispatch(handler, "GET", "/nope").response.body == "dsl-missing"
  end

  it "registers before_all" do
    handler = RouteHandler.new(app)
    gated = dispatch(handler, "GET", "/gated")
    assert gated.response.status_code == 401
    assert gated.response.body == "gated"
  end

  it "mounts a sub-router" do
    handler = RouteHandler.new(app)
    assert dispatch(handler, "GET", "/sub/in").response.body == "mounted-dsl"
  end

  it "writes config through helpers" do
    logging(false)
    assert config.logging == false
    serve_static(false)
    assert config.serve_static == false
    public_folder("./assets")
    assert config.public_folder == "./assets"
  end
end
