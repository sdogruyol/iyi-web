# The DSL writes onto the process app. `using` is what makes `get` a
# bare word; this file is that consumer.
module iyi_web/dsl_test

import iyi_web/dsl
import iyi_web/router
import iyi_web/harness
import iyi_web/config

using iyi_web/dsl
using iyi_web/router::{Router, RouteHandler}
using iyi_web/harness
using iyi_web/config

get "/dsl" do |env|
  "from-dsl"
end

post "/dsl" do |env|
  "posted-dsl"
end

before_all "/gated" do |env|
  env.halt(401, "gated")
  ""
end

get "/gated" do |env|
  "open"
end

error 404 do |env|
  "dsl-missing"
end

mounted = Router.new
mounted.get "/in" do |env|
  "mounted-dsl"
end
mount "/sub", mounted

handler = RouteHandler.new(app)

assert dispatch(handler, "GET", "/dsl").response.body == "from-dsl", "DSL get"
assert dispatch(handler, "POST", "/dsl").response.body == "posted-dsl", "DSL post"
assert dispatch(handler, "GET", "/nope").response.body == "dsl-missing", "DSL error 404"

gated = dispatch(handler, "GET", "/gated")
assert gated.response.status_code == 401, "DSL before_all"
assert gated.response.body == "gated", "DSL before_all body"

assert dispatch(handler, "GET", "/sub/in").response.body == "mounted-dsl", "DSL mount"

logging(false)
assert config.logging == false, "DSL logging"
serve_static(false)
assert config.serve_static == false, "DSL serve_static"
public_folder("./assets")
assert config.public_folder == "./assets", "DSL public_folder"

puts "dsl_test ok"
