# Requests taken off a connection a few bytes at a time. Each wire is fed
# in several read sizes, since where a read ends is the client's choice.
module iyi_web/intake_test

import iyi_web/intake::{Intake, TooLarge, HeadTooLarge}
import iyi_web/request::{Request, ParseError}
import iyi_web/spec::*

STEPS = [1, 2, 3, 7, 64, 4096]

# Feeds *wire* to an intake *step* bytes at a time, as reads would bring it,
# and answers the first thing `take` gives back.
def feed(wire : String, step : Int32, max_body : Int32 = 1024) : Tuple(Request, String, Bool) | ParseError | TooLarge | HeadTooLarge | Nil
  intake = Intake.new("", max_body)
  at = 0
  while at < wire.bytesize
    size = step < wire.bytesize - at ? step : wire.bytesize - at
    intake.append(wire[at, size])
    at = at + size
    if taken = intake.take
      return taken
    end
  end
  nil
end

def taken(wire : String, step : Int32, max_body : Int32 = 1024) : Tuple(Request, String, Bool)
  case got = feed(wire, step, max_body)
  in Tuple(Request, String, Bool) then got
  in ParseError                   then raise "refused: #{got.message}"
  in TooLarge                     then raise "too large"
  in HeadTooLarge                 then raise "head too large: #{got.status}"
  in Nil                          then raise "incomplete"
  end
end

def refused?(wire : String, step : Int32, max_body : Int32 = 1024) : Bool
  feed(wire, step, max_body).is_a?(ParseError)
end

def too_large?(wire : String, step : Int32, max_body : Int32 = 1024) : Bool
  feed(wire, step, max_body).is_a?(TooLarge)
end

# The status a head past its bounds is answered with, or nil.
def head_refusal(wire : String, step : Int32) : Int32?
  got = feed(wire, step)
  got.is_a?(HeadTooLarge) ? got.status : nil
end

NEXT = "GET /next HTTP/1.1\r\nHost: x\r\n\r\n"

describe "Intake" do
  it "takes a request with no body as soon as its head is in, leaving the next one" do
    STEPS.each do |step|
      got = taken("GET /a?b=c HTTP/1.1\r\nHost: x\r\n\r\n" + NEXT, step)
      assert got[0].method == "GET"
      assert got[0].path == "/a"
      assert got[0].body == ""
      # A read may have brought part of the next request; what it brought is kept.
      assert NEXT.starts_with?(got[1])
    end
  end

  it "waits for Content-Length bytes and leaves what follows them" do
    STEPS.each do |step|
      got = taken("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 11\r\n\r\nhello world" + NEXT, step)
      assert got[0].body == "hello world"
      assert NEXT.starts_with?(got[1])
    end
    assert feed("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 11\r\n\r\nhello worl", 4096).nil?
  end

  it "decodes a chunked body with extensions and trailers" do
    wire = "POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5;name=v\r\nhello\r\n 1 \r\n \r\nA\r\n0123456789\r\n0\r\nX-Sum: 1\r\n\r\n"
    STEPS.each do |step|
      got = taken(wire + NEXT, step)
      assert got[0].body == "hello 0123456789"
      assert got[0].headers["transfer-encoding"]? == "chunked"
      assert NEXT.starts_with?(got[1])
    end
    assert feed(wire[0, wire.bytesize - 2], 4096).nil?
  end

  it "refuses a malformed chunked body" do
    head = "POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n"
    STEPS.each do |step|
      assert refused?(head + "zz\r\nhello\r\n0\r\n\r\n", step)
      assert refused?(head + "\r\n0\r\n\r\n", step)
      assert refused?(head + "5\r\nhelloXX0\r\n\r\n", step)
      assert refused?(head + "123456789\r\n", step)
    end
  end

  it "answers TooLarge before the body arrives" do
    assert too_large?("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 1025\r\n\r\n", 4096)
    assert taken("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\n\r\nabcd", 4096, 4)[0].body == "abcd"
    chunked = "POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n"
    STEPS.each do |step|
      # The second chunk's size line passes the bound; nothing ends the body yet.
      assert too_large?(chunked, step, 4)
      assert taken(chunked + "0\r\n\r\n", step, 5)[0].body == "abcde"
    end
  end

  it "refuses framing it cannot read one way" do
    STEPS.each do |step|
      assert refused?("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\ncontent-length: 4\r\n\r\nabcd", step)
      assert refused?("POST /e HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n", step)
      assert refused?("POST /e HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\n\r\n", step)
      assert refused?("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\n", step)
    end
    same = taken("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\nContent-Length: 3\r\n\r\nabc", 4096)
    assert same[0].body == "abc"
  end

  it "refuses a head that never ends" do
    wire = "GET / HTTP/1.1\r\nHost: x\r\nX-Filler: " + "a" * 1048576
    assert head_refusal(wire, 65536) == 431
    assert feed(wire[0, 8192], 8192).nil?
  end

  it "holds the request line to 8 KiB and the fields to 16 KiB" do
    long_target = "GET /" + "a" * 8192 + " HTTP/1.1\r\nHost: x\r\n\r\n"
    many_fields = "GET / HTTP/1.1\r\nHost: x\r\n" + "X-A: b\r\n" * 2400 + "\r\n"
    [7, 4096, 65536].each do |step|
      assert head_refusal(long_target, step) == 414
      assert head_refusal(many_fields, step) == 431
      # A line that never ends is refused once it passes the bound.
      assert head_refusal("GET /" + "a" * 9000, step) == 414
    end
    # Within the bounds, read to the last field. Repeated lines are joined
    # by `std/http` from iyi 0.16.1 on, and the last one kept before it.
    fits = "GET / HTTP/1.1\r\nHost: x\r\n" + "X-A: b\r\n" * 2000 + "X-Last: z\r\n\r\n"
    assert taken(fits, 4096)[0].headers["x-last"]? == "z"
  end

  it "skips empty lines before the request line, and keeps the body limit" do
    STEPS.each do |step|
      got = taken("\r\n\r\nPOST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\n\r\nabc" + NEXT, step)
      assert got[0].path == "/e"
      assert got[0].body == "abc"
      assert NEXT.starts_with?(got[1])
      # Led by empty lines, a body past the limit is refused from its
      # length, before it arrives, as any other.
      assert too_large?("\r\n\r\nPOST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 1025\r\n\r\n", step)
    end
    # A stream of empty lines is a request line that never ends.
    assert head_refusal("\r\n" * 5000, 4096) == 414
  end

  it "reads a repeated length on one line as std/http does" do
    STEPS.each do |step|
      assert taken("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 3, 3\r\n\r\nabc" + NEXT, step)[0].body == "abc"
      assert too_large?("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 1025, 1025\r\n\r\n", step)
      assert refused?("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 3, 4\r\n\r\nabcd", step)
      assert refused?("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: +3\r\n\r\nabc", step)
    end
  end

  it "asks for a body the client holds back for 100 Continue, once" do
    intake = Intake.new("", 1024)
    intake.append("POST /e HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 3\r\n\r\n")
    assert intake.take.nil?
    assert intake.continue_due?
    assert !intake.continue_due?
    intake.append("abc")
    assert intake.take.is_a?(Tuple(Request, String, Bool))

    old = Intake.new("POST /e HTTP/1.0\r\nExpect: 100-continue\r\nContent-Length: 3\r\n\r\n", 1024)
    assert old.take.nil?
    assert !old.continue_due?

    empty = Intake.new("POST /e HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 0\r\n\r\n", 1024)
    assert empty.take.is_a?(Tuple(Request, String, Bool))
    assert !empty.continue_due?

    refused = Intake.new("POST /e HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 2000\r\n\r\n", 1024)
    assert refused.take.is_a?(TooLarge)
    assert !refused.continue_due?
  end
end
