# Case-insensitive lookup, last-wins on add, replacement on assign,
# insertion order on write.
module iyi_web/headers_test

import iyi_web/headers
import iyi_web/spec

using iyi_web/headers::{Headers}
using iyi_web/spec

describe "Headers" do
  it "starts empty" do
    headers = Headers.new
    assert headers.empty?
    assert !headers.has_key?("Host")
    assert headers["Host"]?.nil?
    assert headers.to_s == ""
  end

  it "looks up a name without regard to case" do
    headers = Headers.new
    headers["Content-Type"] = "text/plain"
    assert headers["content-type"] == "text/plain"
    assert headers["CONTENT-TYPE"] == "text/plain"
    assert headers.has_key?("content-type")
  end

  it "replaces on assign and keeps a single pair" do
    headers = Headers.new
    headers["Content-Type"] = "text/plain"
    headers["content-type"] = "text/html"
    assert headers["Content-Type"] == "text/html"
    assert headers.to_s == "content-type: text/html\r\n"
  end

  it "keeps every added value and still looks up last-wins" do
    headers = Headers.new
    headers["content-type"] = "text/html"
    headers.add("X-A", "1")
    headers.add("X-A", "2")
    assert headers["x-a"] == "2"
    assert headers.to_s == "content-type: text/html\r\nX-A: 1\r\nX-A: 2\r\n"
  end

  it "yields pairs in insertion order" do
    headers = Headers.new
    headers["content-type"] = "text/html"
    headers.add("X-A", "1")
    headers.add("X-A", "2")

    names = [] of String
    headers.each do |name, value|
      names << name + "=" + value
    end
    assert names.size == 3
    assert names[0] == "content-type=text/html"
  end

  it "deletes every case-insensitive match for a name" do
    headers = Headers.new
    headers["content-type"] = "text/html"
    headers.add("X-A", "1")
    headers.add("X-A", "2")
    headers.delete("X-A")
    assert !headers.has_key?("x-a")
    assert headers.to_s == "content-type: text/html\r\n"
  end

  it "refuses a name that is not a token" do
    assert panics? { Headers.new["Bad Name"] = "x" }
    assert panics? { Headers.new.add("", "x") }
    assert panics? { Headers.new["X-A:"] = "x" }
  end

  it "refuses CR, LF and other control characters in a value" do
    assert panics? { Headers.new["Location"] = "/next\r\nSet-Cookie: injected=1" }
    assert panics? { Headers.new.add("X-A", "a\nb") }
    assert panics? { Headers.new["X-A"] = "a\u0000b" }
    assert panics? { Headers.new["X-A"] = "a\u007fb" }
  end

  it "accepts tab, space and bytes above ASCII in a value" do
    headers = Headers.new
    headers["X-A"] = "a\tb c"
    headers["X-B"] = "çay"
    assert headers["x-a"] == "a\tb c"
    assert headers["x-b"] == "çay"
  end
end
