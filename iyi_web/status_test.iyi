# RFC 9110 phrases: std/http's table plus the codes Kemal sends that it
# does not name.
module iyi_web/status_test

import iyi_web/status
import iyi_web/spec

using iyi_web/status
using iyi_web/spec

describe "phrase" do
  it "names the status codes the framework actually sends" do
    assert phrase(200) == "OK"
    assert phrase(201) == "Created"
    assert phrase(204) == "No Content"
    assert phrase(301) == "Moved Permanently"
    assert phrase(302) == "Found"
    assert phrase(400) == "Bad Request"
    assert phrase(401) == "Unauthorized"
    assert phrase(404) == "Not Found"
    assert phrase(405) == "Method Not Allowed"
    assert phrase(418) == "I'm a teapot"
    assert phrase(500) == "Internal Server Error"
  end

  it "falls back to the status class for an unnamed code" do
    assert phrase(599) == "Server Error"
  end
end
