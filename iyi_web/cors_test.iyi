# CORS: preflight is 204 here; a plain OPTIONS still reaches the router.
module iyi_web/cors_test

import iyi_web/cors::{CORSHandler}
import iyi_web/handler::{chain}
import iyi_web/harness::*
import iyi_web/spec::*

def cors_app
  chain([CORSHandler.new, routes { |r|
    r.get "/x" do |env|
      "ok"
    end
    r.options "/x" do |env|
      "opt"
    end
  }])
end

describe "CORSHandler" do
  it "lets GET through and adds Allow-Origin" do
    ctx = dispatch(cors_app, "GET", "/x")
    assert ctx.response.body == "ok"
    assert ctx.response.headers["access-control-allow-origin"] == "*"
  end

  it "leaves a plain OPTIONS to the route" do
    assert dispatch(cors_app, "OPTIONS", "/x").response.body == "opt"
  end

  it "answers a preflight with 204 and no body" do
    pre = http_request("OPTIONS", "/x")
    pre.headers["Access-Control-Request-Method"] = "POST"
    ctx = dispatch(cors_app, pre)
    assert ctx.response.status_code == 204
    assert ctx.response.body == ""
    assert ctx.response.headers["access-control-allow-methods"].includes?("POST")
  end
end
