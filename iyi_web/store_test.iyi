# Stores: no update lost when every worker changes one value at once, and
# the snapshot helpers' copies untouched by later changes.
module iyi_web/store_test

import iyi_web/store::{Store, HashStore, ArrayStore}
import iyi_web/spec::*

struct Item
  getter id : Int32
  getter name : String

  def initialize(@id : Int32, @name : String)
  end
end

describe "Store" do
  it "loses no update when parallel tasks change it at once" do
    counts = HashStore(String, Int32).new
    total = Store.new { 0 }
    group do |g|
      8.times do |worker|
        g.spawn(unit: :new) do
          1000.times do
            counts.update { |h| h["hits"] = (h["hits"]? || 0) + 1 }
            total.replace { |n| n + 1 }
          end
          counts.update { |h| h["worker"] = worker }
          0
        end
      end
    end
    assert_eq 8000, counts["hits"]?
    assert_eq 8000, total.get
    assert_eq 2, counts.size
  end

  it "hands out ids no two tasks share, in one critical section" do
    items = HashStore(Int32, Item).new
    group do |g|
      4.times do
        g.spawn(unit: :new) do
          250.times do
            items.update { |h| id = h.size + 1; h[id] = Item.new(id, "n"); id }
          end
          0
        end
      end
    end
    assert_eq 1000, items.size
    assert_eq (1..1000).to_a, items.keys.sorted
  end

  it "answers copies the store's later changes do not reach" do
    items = HashStore(Int32, Item).new
    items.update { |h| h[1] = Item.new(1, "one"); h[2] = Item.new(2, "two") }
    values = items.values
    copy = items.to_h
    items.update { |h| h.delete(1); h[3] = Item.new(3, "three") }
    assert_eq ["one", "two"], values.map(&.name)
    assert_eq [1, 2], copy.keys
    assert_eq [2, 3], items.keys
    three = items[3]?
    assert_eq "three", three ? three.name : ""
    assert_nil items[1]?
  end

  it "copies an array out with to_a" do
    log = ArrayStore(String).new
    log.update { |a| a << "a"; a << "b" }
    snapshot = log.to_a
    log.update { |a| a.delete("a"); a.delete("b") }
    assert_eq ["a", "b"], snapshot
    assert_eq 0, log.size
    assert_nil log[0]?
  end

  it "seeds a store with a value the block makes" do
    seeded = Store.new { {"a" => 1} }
    seeded.update { |h| h["b"] = 2 }
    assert_eq 2, seeded.size
    assert_eq 3, seeded.read { |h| h.values.sum }
  end

  it "reads and sets a plain value" do
    name = Store.new { "first" }
    name.set("second")
    assert_eq "second", name.get
    assert_eq 6, name.read { |s| s.bytesize }
  end
end
