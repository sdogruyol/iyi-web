# Prefix-scoped middleware: the inner handler runs only under the prefix.
module iyi_web/path_test

import iyi_web/path
import iyi_web/handler
import iyi_web/router
import iyi_web/harness
import iyi_web/context

using iyi_web/path::{PathHandler}
using iyi_web/handler::{Handler, chain}
using iyi_web/router::{Router, RouteHandler}
using iyi_web/harness
using iyi_web/context::{Context}

class GateHandler < Handler
  pub def call(ctx : Context) : Nil
    ctx.halt(401, "gated")
  end
end

router = Router.new
router.get "/" do |env|
  "home"
end
router.get "/api/x" do |env|
  "secret"
end

head = chain([PathHandler.new("/api", GateHandler.new), RouteHandler.new(router)])

assert dispatch(head, "GET", "/").response.body == "home", "outside the prefix skips the gate"
denied = dispatch(head, "GET", "/api/x")
assert denied.response.status_code == 401, "inside the prefix runs the gate"
assert denied.response.body == "gated", "gate body"
assert dispatch(head, "GET", "/apiv2").response.status_code == 404, "prefix is not a string prefix"

puts "path_test ok"
