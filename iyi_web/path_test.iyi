# Prefix-scoped middleware: the inner handler runs only under the prefix.
module iyi_web/path_test

import iyi_web/path::{PathHandler}
import iyi_web/handler::{Handler, chain}
import iyi_web/harness::*
import iyi_web/context::{Context}
import iyi_web/spec::*

class GateHandler < Handler
  pub def call(ctx : Context) : Nil
    ctx.halt(401, "gated")
  end
end

def gated
  chain([PathHandler.new("/api", GateHandler.new), routes { |r|
    r.get "/" do |env|
      "home"
    end
    r.get "/api/x" do |env|
      "secret"
    end
  }])
end

describe "PathHandler" do
  it "skips the inner handler outside the prefix" do
    assert dispatch(gated, "GET", "/").response.body == "home"
  end

  it "runs the inner handler under the prefix" do
    denied = dispatch(gated, "GET", "/api/x")
    assert denied.response.status_code == 401
    assert denied.response.body == "gated"
  end

  it "does not treat a string prefix as a path prefix" do
    assert dispatch(gated, "GET", "/apiv2").response.status_code == 404
  end
end
