# Templates: render with the caller's locals, layouts, content_for, the
# path rule, and autoescape. Every relative path here is beside this file
# or, inside a template, beside that template; iyi_web/templates.iyi has no
# views of its own, so a path read beside the macro's file would not be
# found.
module iyi_web/templates_test

import std/process::{Process, ProcessResult}
import iyi_web/templates::{render, content_for, yield_content, raw, SafeHTML, HTMLBuffer}
import iyi_web/harness::*
import iyi_web/spec::*

SCRIPT  = "<script>alert(\"x\" & 'y')</script>"
ESCAPED = "&lt;script&gt;alert(&quot;x&quot; &amp; &#39;y&#39;)&lt;/script&gt;"

# What `iyi check` says about *program*, a file in
# fixtures/refused_templates: whether it passed, and its report.
def check_refused(program : String) : {Bool, String}
  compiler = Program.env("IYI") || "iyi"
  ran = Process.run(compiler, ["check", "-f", "json", __DIR__ + "/fixtures/refused_templates/" + program])
  raise "#{compiler} did not start: #{ran.inspect}" unless ran.is_a?(ProcessResult)
  {ran.success?, ran.stderr}
end

# A render in a method, the way a controller renders: the macro expands in
# this file, which imports `iyi_web/templates` and not `std/eiy`.
def page_for(name : String) : String
  render "fixtures/views/page.eiy"
end

def framed_page_for(name : String) : String
  render "fixtures/views/with_content_for.eiy", "fixtures/views/layout_with_yield.eiy"
end

WITH_META = "<head><title>Page of world</title>\n</head>\n<body>Hello world\n</body>\n<aside>[]</aside>\n"

describe "render" do
  it "renders a view with the caller's locals" do
    name = "world"
    assert render("fixtures/views/page.eiy") == "Hello world\n"
  end

  it "renders inside a route with the route's locals" do
    handler = routes do |r|
      r.get "/view/:name" do |env|
        name = env.params.url["name"]
        render "fixtures/views/page.eiy"
      end
    end
    assert dispatch(handler, "GET", "/view/world").response.body == "Hello world\n"
  end

  it "reads a path inside a template beside that template" do
    name = "world"
    assert render("fixtures/views/with_partial.eiy", "fixtures/views/layout.eiy") == "<html><main><p>world</p>\n</main>\n</html>\n"
  end

  it "renders inside a method of a file that does not import std/eiy" do
    assert page_for("world") == "Hello world\n"
    assert framed_page_for("world") == WITH_META
  end

  it "reads an absolute path as itself" do
    name = "world"
    assert render("#{__DIR__}/fixtures/views/page.eiy") == "Hello world\n"
  end
end

describe "render with a layout" do
  it "prints the view where the layout prints content" do
    name = "world"
    assert render("fixtures/views/page.eiy", "fixtures/views/layout.eiy") == "<html>Hello world\n</html>\n"
  end

  it "shows the layout the caller's locals and the ones the view assigned" do
    name = "world"
    var1 = "first"
    var2 = "second"
    page = render "fixtures/views/with_heading.eiy", "fixtures/views/layout_with_vars.eiy"
    assert page == "<h1>Welcome, world</h1><p>world</p>\n<footer>first second</footer>\n"
  end

  it "leaves the caller's own content local alone" do
    name = "world"
    content = "mine"
    assert render("fixtures/views/page.eiy", "fixtures/views/layout.eiy") == "<html>Hello world\n</html>\n"
    assert content == "mine"
  end
end

describe "content_for and yield_content" do
  it "hands a block captured in the view to the layout" do
    name = "world"
    assert render("fixtures/views/with_content_for.eiy", "fixtures/views/layout_with_yield.eiy") == WITH_META
  end

  it "yields nothing for a key that was never captured" do
    name = "world"
    page = render "fixtures/views/page.eiy", "fixtures/views/layout_with_yield.eiy"
    assert page == "<head></head>\n<body>Hello world\n</body>\n<aside>[]</aside>\n"
  end

  it "does not print a captured block the layout never yields" do
    name = "world"
    assert render("fixtures/views/with_content_for.eiy", "fixtures/views/layout.eiy") == "<html>Hello world\n</html>\n"
  end

  it "captures a block from a partial the view renders" do
    name = "world"
    page = render "fixtures/views/with_partial.eiy", "fixtures/views/layout_with_yield.eiy"
    assert page == "<head><meta name=\"author\" content=\"world\">\n</head>\n<body><main><p>world</p>\n</main>\n</body>\n<aside>[]</aside>\n"
  end

  it "keeps two renders in one route apart" do
    handler = routes do |r|
      r.get "/two/:name" do |env|
        name = env.params.url["name"]
        first = render "fixtures/views/with_content_for.eiy", "fixtures/views/layout_with_yield.eiy"
        second = render "fixtures/views/page.eiy", "fixtures/views/layout_with_yield.eiy"
        first + "|" + second
      end
    end
    body = dispatch(handler, "GET", "/two/world").response.body
    assert body == WITH_META + "|" + "<head></head>\n<body>Hello world\n</body>\n<aside>[]</aside>\n"
  end

  it "keeps a render nested in a view or a layout apart from the outer one" do
    name = "world"
    page = render "fixtures/views/nested.eiy", "fixtures/views/nested_layout.eiy"
    view = "[" + WITH_META + "]\n"
    assert page == "outer|<html>Hello world\n</html>\n|" + view + "|outer\n"
  end
end

describe "autoescape" do
  it "escapes what <%= %> prints and leaves the template's own text alone" do
    name = SCRIPT
    markup = "<em>trusted</em>"
    count = 3
    nothing = nil
    page = render "fixtures/views/escaped.eiy"
    assert page == "<b>Hello</b> " + ESCAPED + "|<em>trusted</em>|3||<%= name %>\n"
  end

  it "escapes a request's text in a route" do
    handler = routes do |r|
      r.get "/view" do |env|
        name = env.params.query["name"]
        render "fixtures/views/page.eiy"
      end
    end
    request = http_request("GET", "/view", "name=%3Cb%3E%22hi%22")
    assert dispatch(handler, request).response.body == "Hello &lt;b&gt;&quot;hi&quot;\n"
  end

  it "prints raw(...) as is, and decides per value when a value may be either" do
    markup = "<em>trusted</em>"
    trusted = true
    assert render("fixtures/views/choice.eiy") == "<em>trusted</em>"
    trusted = false
    assert render("fixtures/views/choice.eiy") == "&lt;em&gt;trusted&lt;/em&gt;"
  end

  it "does not escape a partial rendered inside a template a second time" do
    name = SCRIPT
    item = "<li>" + ESCAPED + "</li>"
    # Rendered in iyi code, a page is a String: printed by a template, it is
    # text like any other String, and raw(...) is how it prints as markup.
    page = render "fixtures/views/escaped_item.eiy"
    assert page == item
    once_more = item.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
    assert render("fixtures/views/escaped_list.eiy") == "<ul>" + item + "</ul>|" + once_more + "|" + item + "\n"
  end

  it "does not escape the view in a layout's content, nor a yield_content, a second time" do
    name = SCRIPT
    page = render "fixtures/views/escaped_content_for.eiy", "fixtures/views/layout_with_yield.eiy"
    framed = "<head><title>" + ESCAPED + "</title></head>\n<body><p>" + ESCAPED + "</p>\n</body>\n<aside>[]</aside>\n"
    assert page == framed
    assert render("fixtures/views/escaped_nested.eiy") == "[" + framed + "]\n"
  end
end

describe "SafeHTML and HTMLBuffer" do
  it "prints text as written, values escaped, and SafeHTML as is" do
    buffer = HTMLBuffer.new
    buffer.print("<p>")
    buffer.output(SCRIPT)
    buffer.output(42)
    buffer.output(raw("<br>"))
    buffer.output(nil)
    buffer.print("</p>")
    assert buffer.to_s == "<p>" + ESCAPED + "42<br></p>"
    assert buffer.to_html == raw("<p>" + ESCAPED + "42<br></p>")
  end

  it "makes markup of any value's to_s" do
    assert raw(7).to_s == "7"
    assert raw("").empty?
    assert !(raw("<a>") == raw("&lt;a&gt;"))
  end
end

describe "a template the build refuses" do
  it "names an unclosed tag's line and column in the template" do
    passed, report = check_refused("unclosed_template.iyi")
    assert !passed
    assert report.includes?("unclosed.eiy: unterminated <%= tag at line 2, column 4")
  end

  it "puts an error inside a tag at the template's own line and column" do
    passed, report = check_refused("undefined_template.iyi")
    assert !passed
    assert report.includes?("undefined.eiy\",\"line\":2,\"column\":8")
    assert report.includes?("undefined local variable or method 'nonexistent_name'")
  end
end
