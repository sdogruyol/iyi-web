# Prefix-scoped middleware. `use "/api", AuthHandler.new` runs Auth only
# for `/api` and its descendants; everything else skips to the next handler.
# The prefix is matched against the path the router routes on
# (`Context#routing_path`).
#
# Generic over the handler it wraps, so it is `Share` exactly when that
# handler is: a field typed `Handler` could hold any subclass in the
# program, and the compiler would ask every one of them.
module iyi_web/path

import iyi_web/codec::*
import iyi_web/handler::{Handler}
import iyi_web/context::{Context}

pub class PathHandler(H) < Handler
  @prefix : String
  @inner : H

  def initialize(@prefix : String, @inner : H)
    super()
  end

  # The inner handler's `call_next` is this one's: the request's place in
  # the chain is this handler's while the inner one runs.
  pub def call(ctx : Context) : Nil
    call_under_prefix(@prefix, @inner, ctx)
  end
end

# What a `PathHandler` does, for a chain step that holds *prefix* and
# *inner* itself: the DSL's `use path, handler`, whose step captures the
# handler it was given, the one the compiler checked at the `use` line.
pub def call_under_prefix(prefix : String, inner : H, ctx : Context) : Nil forall H
  if matches_path_prefix?(prefix, ctx.routing_path)
    inner.call(ctx)
  else
    ctx.call_next
  end
end
