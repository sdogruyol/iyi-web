# An HTTP/1.1 server on iyi's own sockets and scheduler.
#
# `IyiSocket` is blocking. A blocking `accept` would stall every fiber, so
# the listen loop parks with `wait_readable` first and only then accepts.
# Each connection is a task in the same group; the group's end is the
# server shutting down.
module iyi_web/server

import std/socket
import iyi_web/codec
import iyi_web/handler
import iyi_web/context
import iyi_web/request
import iyi_web/config

using std/socket::{IyiSocket}
using iyi_web/codec
using iyi_web/handler::{Handler}
using iyi_web/context::{Context}
using iyi_web/request::{Request, ParseError, parse_head, with_body}
using iyi_web/config::{Config}

MAX_HEADER_SIZE = 64 * 1024

pub class Server
  @handler : Handler
  @config : Config
  @socket : IyiSocket?
  @in_flight : Int32
  @host : String
  @port : Int32

  def initialize(@handler : Handler, @config : Config)
    @socket = nil
    @in_flight = 0
    @host = "127.0.0.1"
    @port = 0
  end

  pub def bind(host : String, port : Int32) : Int32
    listener = IyiSocket.listen(host, port)
    @socket = listener
    @host = host
    @port = listener.local_port
    @port
  end

  pub def listen : Nil
    listener = @socket
    raise "server is not bound" unless listener

    group do |g|
      loop do
        break unless @socket
        case wait_readable(listener.fd)
        in Cancelled
          break
        in Nil
          break unless @socket
          client = accept_one(listener)
          next unless client
          unless @socket
            client.close
            break
          end
          g.spawn do
            serve_connection(client)
            0
          end
        end
      end
    end
  end

  # Closing the listen fd from another fiber does not wake `wait_readable`
  # (epoll has no event for a close it did not see). A loopback connect
  # produces the readable event the park is waiting for; the loop then
  # sees `@socket` gone and returns.
  pub def close : Nil
    listener = @socket
    @socket = nil
    return unless listener

    wake_host = @host == "0.0.0.0" ? "127.0.0.1" : @host
    waker = IyiSocket.connect(wake_host, @port)
    waker.close
    listener.close
  end

  pub def in_flight : Int32
    @in_flight
  end

  pub def bound_port : Int32
    @port
  end

  private def accept_one(listener : IyiSocket) : IyiSocket?
    listener.accept
  rescue
    nil
  end

  private def serve_connection(client : IyiSocket) : Nil
    defer client.close
    leftover = ""
    parsed = read_request(client, leftover)
    case parsed
    in Closed
      return
    in ParseError
      write_raw(client, "HTTP/1.1 400 Bad Request\r\nContent-Length: 11\r\nConnection: close\r\n\r\nBad Request")
    in Tuple(Request, String)
      dispatch(client, it[0], false)
    end
  end

  private def dispatch(client : IyiSocket, request : Request, keepalive : Bool) : Nil
    @in_flight = @in_flight + 1
    ctx = Context.for(request)
    if @config.powered_by_header
      ctx.response.headers["X-Powered-By"] = "iyi-web"
    end
    @handler.call(ctx)
    ctx.response.headers["Connection"] = "close"
    write_raw(client, ctx.response.to_http(request.version.empty? ? "HTTP/1.1" : request.version))
    @in_flight = @in_flight - 1
  end

  private def read_request(client : IyiSocket, leftover : String) : Tuple(Request, String) | ParseError | Closed
    buffer = leftover
    header_end = find_substring(buffer, "\r\n\r\n")
    while header_end.nil?
      chunk = read_available(client)
      return Closed.new if chunk.empty? && buffer.empty?
      return ParseError.new("connection closed mid-headers") if chunk.empty?
      buffer = buffer + chunk
      return ParseError.new("headers too large") if buffer.bytesize > MAX_HEADER_SIZE
      header_end = find_substring(buffer, "\r\n\r\n")
    end

    end_index = header_end
    return ParseError.new("headers too large") unless end_index

    block = buffer[0, end_index]
    rest = buffer[end_index + 4, buffer.bytesize - end_index - 4]

    head = parse_head(block)
    case head
    in ParseError
      it
    in Request
      length = it.content_length
      return ParseError.new("request body too large") if length > @config.max_request_body_size
      body, leftover_after = read_body(client, rest, length)
      {with_body(it, body), leftover_after}
    end
  end

  private def read_body(client : IyiSocket, already : String, length : Int32) : Tuple(String, String)
    if already.bytesize >= length
      body = already[0, length]
      leftover = already[length, already.bytesize - length]
      return {body, leftover}
    end

    parts = already
    while parts.bytesize < length
      chunk = read_available(client)
      break if chunk.empty?
      parts = parts + chunk
      if parts.bytesize > @config.max_request_body_size
        parts = parts[0, @config.max_request_body_size]
        break
      end
    end

    if parts.bytesize > length
      {parts[0, length], parts[length, parts.bytesize - length]}
    else
      {parts, ""}
    end
  end

  private def read_available(client : IyiSocket) : String
    case wait_readable(client.fd)
    in Cancelled
      ""
    in Nil
      client.read(4096)
    end
  rescue
    ""
  end

  private def write_raw(client : IyiSocket, bytes : String) : Nil
    client.write(bytes)
  rescue
  end
end

pub struct Closed
end
