# Server-side templates: `render` an `.eiy` file to a String, optionally
# inside a layout, and let a view hand markup to that layout with
# `content_for` / `yield_content`.
#
# The template language is std/eiy's, and so is the moment it is read: at
# compile time, into iyi source spliced where `render` is written. A
# rendered page is compiled code, and a missing template or an unclosed tag
# stops the build instead of a request. The template's code reads that
# scope's locals: a route's `name` is `<%= name %>` in the view.
#
# What differs from std/eiy is escaping. `<%= expr %>` prints `expr.to_s`
# HTML-escaped, the five characters `HTML.escape` escapes (& < > " '), so a
# value a request brought in prints as text and never as markup; the text
# written in the template itself is printed as written. A value that already
# is markup says so by its type, `SafeHTML`, and prints as is: `raw(html)`
# makes one, and so are what a template is handed by the render around it,
# a layout's `content`, `yield_content` and a `render` written inside a
# template, so markup is escaped once, where its values were printed. The
# translation that tells text from values is iyi_web/templates/process.iyi,
# a program `render` runs at compile time, as std/eiy runs its own.
#
# Paths are resolved at compile time. A relative path is read beside the
# file the `render` is written in: the route's source file, or, for a partial
# rendered inside a template, that template. An absolute path, including
# `"#{__DIR__}/..."`, is read as itself. The working directory never counts.
#
# Macros paste text, so every name a render introduces is a block parameter:
# `content` (the layout's view), `__iyi_web_io__` (the buffer the template
# prints to) and `__iyi_web_blocks__` (its captured blocks) exist only inside
# the render that made them. A render nested in a view or a layout shadows
# them, and the outer render's are intact when it returns; a caller's own
# `content` local is not overwritten.
module iyi_web/templates

import std/html::{HTML}

# Text that is HTML already, printed by `<%= %>` as it is. A distinct type
# rather than a flag on a String, so whether a value is escaped is decided
# by the compiler from what the value is: a `String` is text, always, and
# only a value someone made a `SafeHTML` skips the escape.
pub struct SafeHTML
  @html : String

  def initialize(@html : String)
  end

  # The markup.
  pub def to_s : String
    @html
  end

  # `print`, the verb a std/eiy target has, so a `SafeHTML` prints into one.
  pub def to_s(io) : Nil
    io.print(@html)
  end

  pub def empty? : Bool
    @html.empty?
  end

  pub def ==(other : SafeHTML) : Bool
    @html == other.to_s
  end
end

# *value*'s `to_s`, marked as markup: `<%= raw(html) %>` prints it without
# escaping. Only for text that is trusted to be HTML - markup the program
# built, never a request's text - since this is the one way past autoescape.
pub def raw(value : T) : SafeHTML forall T
  SafeHTML.new(value.to_s)
end

# What a template prints to. The processor writes the template's own text
# as `print` and every `<%= %>` as `output`, and the difference between the
# two calls is the whole of autoescape.
pub class HTMLBuffer
  @text : String::Builder

  def initialize
    @text = String::Builder.new
  end

  # The template's text, as written.
  pub def print(text : String) : Nil
    @text << text
  end

  # A `<%= %>` whose value is markup already: as is.
  pub def output(value : SafeHTML) : Nil
    @text << value.to_s
  end

  # Any other `<%= %>`: its `to_s`, escaped.
  pub def output(value : T) : Nil forall T
    @text << HTML.escape(value.to_s)
  end

  pub def to_s : String
    @text.to_s
  end

  # What was printed, as the markup it is: a layout's `content`.
  pub def to_html : SafeHTML
    SafeHTML.new(@text.to_s)
  end
end

# The `content_for` blocks of one `render(view, layout)`, by key. Each render
# makes its own, so two renders never see each other's blocks.
pub class ContentBlocks
  @blocks : Hash(String, String)

  def initialize
    @blocks = {} of String => String
  end

  # Runs the block against a fresh buffer and keeps what it printed under
  # *key*. A later capture of the same key replaces the earlier one.
  pub def capture(key : String, & : HTMLBuffer -> Nil) : Nil
    buffer = HTMLBuffer.new
    yield buffer
    @blocks[key] = buffer.to_s
  end

  # What was captured under *key*, or nothing when nothing was. Markup: the
  # block's values were escaped as it printed them.
  pub def [](key : String) : SafeHTML
    SafeHTML.new(@blocks[key]? || "")
  end
end

# The scopes the macros render in. Each yields fresh values as block
# parameters, which is what keeps a nested render from reaching the outer
# render's buffer, blocks or `content`.
pub struct Templates
  # A buffer for one template, and the text it collected.
  pub def self.partial(& : HTMLBuffer -> Nil) : String
    buffer = HTMLBuffer.new
    yield buffer
    buffer.to_s
  end

  # The view's buffer and the render's blocks; the block answers the page.
  pub def self.page(& : HTMLBuffer, ContentBlocks -> String) : String
    yield HTMLBuffer.new, ContentBlocks.new
  end

  # The rendered view as `content`, and a buffer for the layout.
  pub def self.layout(content : SafeHTML, & : SafeHTML, HTMLBuffer -> Nil) : String
    buffer = HTMLBuffer.new
    yield content, buffer
    buffer.to_s
  end

  # A render's text as what it is when the render is written inside a
  # template: markup, which the template's `<%= %>` prints as is.
  pub def self.markup(html : String) : SafeHTML
    SafeHTML.new(html)
  end
end

# The template at *filename*, rendered with the caller's locals in scope.
#
# Written in iyi code it answers a `String`, the page a route returns.
# Written inside a template (any file the caller's location names that is not
# an `.iyi` source, which is where a template's code is located) it answers
# `SafeHTML`, so `<%= render "_row.eiy" %>` prints the partial's markup and
# does not escape it a second time.
pub macro render(filename)
  {% caller = @caller.first.filename || "" %}
  {% in_template = caller != "" && !caller.ends_with?(".iyi") %}
  {% if in_template %}::IyiWeb::Templates::Templates.markup({% end %}
  ::IyiWeb::Templates::Templates.partial do |__iyi_web_io__|
    {{ run("./templates/process", caller, filename, "__iyi_web_io__") }}
  end
  {% if in_template %}){% end %}
end

# The view at *filename* rendered first, then the layout at *layout* with
# the view's markup as `content`; answers the layout's text, a `String` or,
# inside a template, `SafeHTML`, as `render(filename)` does. The layout sees
# the caller's locals and the ones the view assigned.
pub macro render(filename, layout)
  {% caller = @caller.first.filename || "" %}
  {% in_template = caller != "" && !caller.ends_with?(".iyi") %}
  {% if in_template %}::IyiWeb::Templates::Templates.markup({% end %}
  ::IyiWeb::Templates::Templates.page do |__iyi_web_io__, __iyi_web_blocks__|
    {{ run("./templates/process", caller, filename, "__iyi_web_io__") }}
    ::IyiWeb::Templates::Templates.layout(__iyi_web_io__.to_html) do |content, __iyi_web_io__|
      {{ run("./templates/process", caller, layout, "__iyi_web_io__") }}
    end
  end
  {% if in_template %}){% end %}
end

# Captures what the block prints under *key* instead of printing it. Only
# inside `render(view, layout)`: in the view, the layout, or a partial one
# of them renders. The block runs here, once.
pub macro content_for(key)
  __iyi_web_blocks__.capture({{ key }}) do |__iyi_web_io__|
    {{ yield }}
  end
end

# The markup captured under *key* by `content_for` in this render, or an
# empty `SafeHTML`; `<%= yield_content "title" %>` prints it as is.
pub macro yield_content(key)
  __iyi_web_blocks__[{{ key }}]
end
