# Grouping for tests, not a runner.
#
# `iyi test` is still a program: assert, panic, exit. Crystal's `describe` /
# `it` are macros that register a suite; these are ordinary functions that
# yield now, so a group is a name around examples rather than a script of
# bare asserts. Failure still names the file and line. The strings are for
# the reader, the way a spec's example name is.
module iyi_web/spec

class Nesting
  @path : String

  def initialize
    @path = ""
  end

  pub def path : String
    @path
  end

  pub def path=(value : String) : String
    @path = value
  end
end

NESTING = Nesting.new

def around(name : String, & : -> Nil) : Nil
  previous = NESTING.path
  NESTING.path = previous.empty? ? name : previous + " " + name
  yield
  NESTING.path = previous
end

pub def describe(name : String, & : -> Nil) : Nil
  around(name) { yield }
end

pub def context(name : String, & : -> Nil) : Nil
  around(name) { yield }
end

pub def it(name : String, & : -> Nil) : Nil
  around(name) { yield }
end

# True when *block* panics. A panic can only be caught at a task boundary,
# so the block runs as its own task and reading the task's value is the
# catch. The runtime still prints the panic line to standard error.
pub def panics?(&block : -> Nil) : Bool
  outcome = group do |g|
    task = g.spawn do
      block.call
      0
    end
    task.value
  end
  outcome.is_a?(Panicked)
end
