# Static files from a public folder. Whole-file reads, MIME from the
# extension table, and a `..` refusal so a request cannot walk out of the
# folder. Directory listing is not served: Kemal's default is the same.
module iyi_web/static

import std/file
import iyi_web/codec
import iyi_web/mime
import iyi_web/handler
import iyi_web/context

using std/file::{File}
using iyi_web/codec
using iyi_web/mime
using iyi_web/handler::{Handler}
using iyi_web/context::{Context}

pub class StaticHandler < Handler
  @root : String

  def initialize(@root : String)
    super()
  end

  pub def call(ctx : Context) : Nil
    return call_next(ctx) unless ctx.request.method.in?("GET", "HEAD")

    relative = ctx.request.path
    return call_next(ctx) if relative.empty? || !relative.starts_with?('/')
    return call_next(ctx) if contains_dotdot?(relative)

    path = join_paths(@root, relative)
    path = join_paths(path, "index.html") if File.exists?(join_paths(path, "index.html"))
    return call_next(ctx) unless File.exists?(path)
    return call_next(ctx) if File.directory?(path)

    body = File.read(path)
    ctx.response.content_type = mime_type_of(path)
    if ctx.request.method == "HEAD"
      ctx.response.headers["Content-Length"] = body.bytesize.to_s
      ctx.response.set_body("")
    else
      ctx.response.set_body(body)
    end
  end
end

private def contains_dotdot?(path : String) : Bool
  path.split('/').any? { |part| part == ".." }
end
