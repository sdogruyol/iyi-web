# Static files from a public folder, served before routing.
#
# Every file carries `ETag` (weak, from its modification time) and
# `Last-Modified`, and a matching `If-None-Match` or `If-Modified-Since`
# gets a 304. Media types come from `std/mime` by extension. A file of a
# type `MIME.compressible?` takes and of at least `COMPRESS_MIN_SIZE` bytes
# is sent gzip- or deflate-encoded when the client accepts it, compressed
# as it is read, whatever its size. A GET with `Range` gets 206 or 416, of
# the file as it is stored. Everything is read from disk as it is sent
# (`iyi_web/file_body`), so a large file or a range of one costs a chunk
# of memory and a HEAD does not read a file it would send as it is. A `..`
# segment or a NUL byte is refused, so a request cannot walk out of the
# folder; on Windows so is any `\` or `:`, which the file system reads as
# a separator, a drive or a stream.
#
# A precompressed copy beside a file - `app.js.gz` next to `app.js`, a
# regular file no older than it - is sent in its place, with
# `Content-Encoding: gzip` and `app.js`'s media type, to a client that
# accepts gzip whenever gzip is the coding the request gets, even with the
# `gzip` option off or for a type not compressed on the fly. A `Range` is
# always answered from the file itself: a client resuming a download it
# took whole gets the bytes it asked for, not bytes of whichever encoded
# copy is on disk now.
#
# A directory serves its `index.html` (`dir_index`) or an HTML listing of
# its entries (`dir_listing`); a directory path without a trailing slash
# is first redirected to one, so relative links in the page resolve.
module iyi_web/static

import std/list::{List}
import std/shared_proc::{SharedProc}
import std/file::{File}
import std/dir::{Dir}
import std/html::{HTML}
import std/mime::{MIME}
import std/time::{Time}
import std/uri::{URI}
import iyi_web/codec::*
import iyi_web/handler::{Handler}
import iyi_web/context::{Context}
import iyi_web/config::{StaticHeadersHook}
import iyi_web/http_date::*
import iyi_web/content_coding::{select_content_coding, compressible_file?, append_vary, etag_with_coding}
import iyi_web/range::*
import iyi_web/file_body::{respond_file, respond_file_encoded}

# What `select_content_coding` is asked for a file with a precompressed
# copy: whether the request takes gzip at all. A `List`, which every
# worker may read (SPEC.md III.4.4), made once.
GZIP_ONLY = List.new(["gzip"])

pub class StaticHandler < Handler
  @root : String
  @dir_index : Bool
  @dir_listing : Bool
  @gzip : Bool
  @max_ranges : Int32
  @headers_hook : StaticHeadersHook?

  def initialize(@root : String, @dir_index : Bool = true, @dir_listing : Bool = false, @gzip : Bool = true, @max_ranges : Int32 = 16, @headers_hook : StaticHeadersHook? = nil)
    super()
  end

  pub def call(ctx : Context) : Nil
    serve(ctx, @headers_hook)
  end

  # `call` with *hook* run for each file before its body is written: this
  # handler's own, or, on a server on one thread, the `Proc` of a
  # `static_headers` registered with `workers: 1`, which a handler every
  # worker may call cannot hold.
  pub def serve(ctx : Context, hook : K) : Nil forall K
    return call_next(ctx) unless ctx.request.method.in?("GET", "HEAD")

    relative = ctx.request.path
    return call_next(ctx) if relative.empty? || !relative.starts_with?('/')
    return call_next(ctx) if escapes_root?(relative)

    path = join_paths(@root, relative)
    info = File.info?(path)
    return call_next(ctx) unless info

    if info.directory?
      serve_directory(ctx, path, relative, hook)
    elsif info.file?
      serve_file(ctx, path, info, hook)
    else
      call_next(ctx)
    end
  end

  private def serve_directory(ctx : Context, dir : String, relative : String, hook : K) : Nil forall K
    index = join_paths(dir, "index.html")
    index_info = @dir_index ? File.info?(index) : nil
    has_index = index_info ? index_info.file? : false
    return call_next(ctx) unless has_index || @dir_listing

    unless relative.ends_with?('/')
      query = ctx.request.query_string
      ctx.redirect(query.empty? ? relative + "/" : relative + "/?" + query)
      return
    end

    if found = index_info
      if has_index
        serve_file(ctx, index, found, hook)
        return
      end
    end
    list_directory(ctx, dir, relative)
  end

  private def serve_file(ctx : Context, path : String, info : File::Info, hook : K) : Nil forall K
    headers = ctx.response.headers
    type = MIME.with_charset(MIME.from_extension(path))
    size = info.size
    etag = "W/\"" + info.modification_time.to_s + "\""
    headers["Last-Modified"] = http_date(Time.from_unix(info.modification_time))
    headers["X-Content-Type-Options"] = "nosniff"
    headers["Accept-Ranges"] = @max_ranges > 0 ? "bytes" : "none"

    range_header = ctx.request.method == "GET" && @max_ranges > 0 ? ctx.request.headers["Range"]? : nil
    ranged = range_header ? parse_ranges(range_header, size, @max_ranges) : nil

    # A file compressed on the fly, or one with a precompressed copy, has
    # an encoded and an identity form, and says so even to a request that
    # gets the identity one: a range, which is always of the stored bytes,
    # or a client that accepts no coding. The ETag names what this request
    # receives.
    compressed = @gzip && compressible_file?(type, size)
    precompressed = precompressed_copy(path, info)
    append_vary(headers, "Accept-Encoding") if compressed || precompressed
    coding = nil
    if ranged.nil?
      if accept = ctx.request.headers["Accept-Encoding"]?
        coding = select_content_coding(accept) if compressed
        if precompressed && coding.nil? && select_content_coding(accept, GZIP_ONLY)
          coding = "gzip"
        end
      end
    end
    tag = coding ? etag_with_coding(etag, coding) : etag
    headers["ETag"] = tag

    if not_modified?(ctx, tag, info.modification_time)
      ctx.response.status_code = 304
      ctx.response.set_body("")
      return
    end

    if hook
      hook.call({ctx, path, info})
    end

    head = ctx.request.method == "HEAD"
    if encoding = coding
      if copy = precompressed
        if encoding == "gzip"
          headers["Content-Encoding"] = "gzip"
          respond_file(ctx.response, path + ".gz", copy.size, nil, type, head)
          return
        end
      end
      respond_file_encoded(ctx.response, path, size, type, encoding, head)
      return
    end
    respond_file(ctx.response, path, size, ranged, type, head)
  end

  # The `.gz` copy of the file at *path* that can stand in for it: a
  # regular file no older than the one it compresses, so a file edited
  # after it was compressed is not answered with its old contents.
  private def precompressed_copy(path : String, info : File::Info) : File::Info?
    copy = File.info?(path + ".gz")
    return nil unless copy
    return nil unless copy.file? && copy.modification_time >= info.modification_time
    copy
  end

  # `If-None-Match` wins when present (weak comparison, `*` matches any);
  # otherwise `If-Modified-Since`, to the second.
  private def not_modified?(ctx : Context, tag : String, modified : Int64) : Bool
    if candidates = ctx.request.headers["If-None-Match"]?
      candidates.split(',').each do |candidate|
        wanted = candidate.strip
        return true if wanted == "*" || opaque_tag(wanted) == opaque_tag(tag)
      end
      return false
    end
    if since = ctx.request.headers["If-Modified-Since"]?
      if at = parse_http_date(since)
        return modified <= at.to_unix
      end
    end
    false
  end

  private def list_directory(ctx : Context, dir : String, relative : String) : Nil
    items = [] of String
    Dir.children(dir).sorted.each do |name|
      nested = File.directory?(join_paths(dir, name))
      shown = nested ? name + "/" : name
      href = relative + URI.encode_path_segment(name) + (nested ? "/" : "")
      items << "<li><a href=\"" + HTML.escape(href) + "\">" + HTML.escape(shown) + "</a></li>"
    end
    title = "Directory listing for " + HTML.escape(relative)
    ctx.response.content_type = "text/html; charset=utf-8"
    send_body(ctx, "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>" + title + "</title></head><body><h2>" + title + "</h2><ul>" + items.join + "</ul></body></html>\n")
  end

  private def send_body(ctx : Context, body : String) : Nil
    if ctx.request.method == "HEAD"
      ctx.response.headers["Content-Length"] = body.bytesize.to_s
      ctx.response.set_body("")
    else
      ctx.response.set_body(body)
    end
  end
end

# Whether the decoded request path could name something outside the
# folder. On Windows `\` separates as `/` does, so `/..%5C..%5Cx` walks out
# unless it is split on too; a `:` names a drive (`C:`) or an alternate
# stream (`a.txt::$DATA`), neither of which a URL path means.
private def escapes_root?(path : String) : Bool
  return true if path.includes?("\u0000")
  if {{ flag?(:win32) }}
    return true if path.includes?("\\") || path.includes?(":")
  end
  path.split('/').any? { |part| part == ".." }
end

private def opaque_tag(tag : String) : String
  tag.starts_with?("W/") ? tag[2, tag.bytesize - 2] : tag
end
