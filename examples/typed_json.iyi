# Typed JSON: a request body read into a type of the application's own and
# checked by that type's rules, and responses written from such types. Run
# from the repository root with `iyi run examples/typed_json.iyi`.
#
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":"Groceries","body":"eggs, milk","tags":["home"]}'
#   curl localhost:3000/notes
#   curl localhost:3000/notes/1
#
# And the refusals, each answered as JSON:
#
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":"Groceries",}'           # 400, line and column
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":7,"tags":"home"}'         # 422, title and tags
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":" ","priority":9}'        # 422, validation
#   curl -X POST localhost:3000/notes -H 'Accept: application/json' -d 'title=Groceries'                        # 415
#   curl localhost:3000/notes/9                                                                                # 404
module examples/typed_json

import std/json::{serializable}
import iyi_web/dsl::*
import iyi_web/failure::{StatusError}
import iyi_web/validation::{BodyError, Validate, Validator}

# What a client sends. A field with a default may be left out; `title`
# may not.
struct NoteInput
  getter title : String
  getter body : String = ""
  getter priority : Int32 = 3
  getter tags : Array(String) = [] of String
  derive serializable
end

# Run by `json_as` once the body has been read: every failing field is
# reported, in one 422.
impl Validate for NoteInput
  def validate(v : Validator) : Nil
    v.required("title", title)
    v.length("title", title, max: 80)
    v.range("priority", priority, min: 1, max: 5)
    v.length("tags", tags, max: 5)
  end
end

# What the API answers with. `derive serializable` is also what lets
# `env.json` write it.
struct Note
  getter id : Int32
  getter title : String
  getter body : String
  getter priority : Int32
  getter tags : Array(String)
  derive serializable

  def initialize(@id : Int32, input : NoteInput)
    @title = input.title.strip
    @body = input.body
    @priority = input.priority
    @tags = input.tags
  end
end

# A list with its count. `{"count" => 2, "notes" => notes}` would be a
# `Hash(String, Int32 | Array(Note))`, which `JSON.to_json` refuses when
# the program is compiled: a struct, or `JSON.build`, says it instead.
struct NoteList
  getter count : Int32
  getter notes : Array(Note)
  derive serializable

  def initialize(@notes : Array(Note))
    @count = @notes.size
  end
end

# Kept in memory for as long as the program runs: a bare `Array` of
# `Note`s, whose tags are an `Array` too. Neither may be shared between
# workers, so the routes that reach it are registered with `workers: 1`,
# and the program serves on one thread; `examples/json_api.iyi` keeps its
# store behind a `Mutex` instead and serves on every core.
NOTES = [] of Note

post "/notes", workers: 1 do |env|
  # `NoteInput | BodyError`: the error goes back as the route's value and
  # is answered with its status, 400, 415 or 422.
  case input = env.params.json_as(NoteInput)
  in BodyError
    input
  in NoteInput
    note = Note.new(NOTES.size + 1, input)
    NOTES << note
    env.status(201).json(note)
  end
end

get "/notes", workers: 1 do |env|
  env.json(NoteList.new(NOTES))
end

# A `StatusError` returned is answered with its status: here the 404 page
# below.
get "/notes/:id", workers: 1 do |env|
  id = env.params.url["id"].to_i? || 0
  note = id > 0 ? NOTES[id - 1]? : nil
  if note
    env.json(note)
  else
    StatusError.new(404)
  end
end

error 404 do |env|
  env.json({"error" => "not found"})
end

run
