# Typed routes: a request body, a query string and a path segment read into
# types of the application's own, and responses written from such types.
# Nothing in a route parses or checks by hand: what cannot be read is
# answered before the block runs. Run from the repository root with
# `iyi run examples/typed_json.iyi`.
#
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":"Groceries","body":"eggs, milk","tags":["home"]}'
#   curl localhost:3000/notes
#   curl 'localhost:3000/notes?tag=home&limit=5'
#   curl localhost:3000/notes/1
#
# And the refusals, each answered as JSON (the 4xx ones say which field):
#
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":"Groceries",}'           # 400, line and column
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":7,"tags":"home"}'         # 422, title and tags
#   curl -X POST localhost:3000/notes -H 'Content-Type: application/json' -d '{"title":" ","priority":9}'        # 422, validation
#   curl -X POST localhost:3000/notes -H 'Accept: application/json' -d 'title=Groceries'                        # 415
#   curl -H 'Accept: application/json' 'localhost:3000/notes?limit=many'                                       # 422, limit
#   curl -H 'Accept: application/json' localhost:3000/notes/abc                                                # 422, id
#   curl localhost:3000/notes/9                                                                                # 404
module examples/typed_json

import std/json::{serializable}
import std/list::{List}
import iyi_web/dsl::*
import iyi_web/failure::{StatusError}
import iyi_web/store::{Store}
import iyi_web/validation::{Validate, Validator}

# What a client sends. A field with a default may be left out; `title`
# may not.
struct NoteInput
  getter title : String
  getter body : String = ""
  getter priority : Int32 = 3
  getter tags : Array(String) = [] of String
  derive serializable
end

# Run once the body has been read: every failing field is reported, in
# one 422, and the route does not run.
impl Validate for NoteInput
  def validate(v : Validator) : Nil
    v.required("title", title)
    v.length("title", title, max: 80)
    v.range("priority", priority, min: 1, max: 5)
    v.length("tags", tags, max: 5)
  end
end

# The query string of `GET /notes`, read the way a body is: `?limit=5`
# is an `Int32`, `?limit=many` a 422 naming `limit`, and a field left out
# keeps its default.
struct NoteFilter
  getter tag : String?
  getter limit : Int32 = 20
  derive serializable
end

impl Validate for NoteFilter
  def validate(v : Validator) : Nil
    v.range("limit", limit, min: 1, max: 100)
  end
end

# What is kept: a note's fields, its tags in a `List`. A `List` of
# strings is `Share`, so a `StoredNote` may leave the `Store`'s lock below
# and every worker may read it; a struct holding an `Array` may not.
struct StoredNote
  getter id : Int32
  getter title : String
  getter body : String
  getter priority : Int32
  getter tags : List(String)

  def initialize(@id : Int32, input : NoteInput)
    @title = input.title.strip
    @body = input.body
    @priority = input.priority
    @tags = List.new(input.tags)
  end
end

# What the API answers with. `derive serializable` is also what lets a
# route declare it as its `response:`.
struct Note
  getter id : Int32
  getter title : String
  getter body : String
  getter priority : Int32
  getter tags : Array(String)
  derive serializable

  def initialize(stored : StoredNote)
    @id = stored.id
    @title = stored.title
    @body = stored.body
    @priority = stored.priority
    @tags = stored.tags.to_a
  end
end

# A list with its count. `{"count" => 2, "notes" => notes}` would be a
# `Hash(String, Int32 | Array(Note))`, which `JSON.to_json` refuses when
# the program is compiled: a struct, or `JSON.build`, says it instead.
struct NoteList
  getter count : Int32
  getter notes : Array(Note)
  derive serializable

  def initialize(@notes : Array(Note))
    @count = @notes.size
  end
end

# Kept in memory for as long as the program runs, behind a `Store`'s
# lock: every route below runs on whichever core is free. Ids come from
# an atomic counter, so no two requests are handed the same one.
NOTES   = Store.new { {} of Int32 => StoredNote }
LAST_ID = Atomic(Int32).new(0)

# The block gets a `NoteInput` that passed `validate`, and answers the
# `Note` it made: `response:` writes it as JSON, with `status:`.
post "/notes", body: NoteInput, response: Note, status: 201 do |env, input|
  stored = StoredNote.new(LAST_ID.add(1) + 1, input)
  NOTES.update { |notes| notes[stored.id] = stored; nil }
  Note.new(stored)
end

# `values` copies the notes out under the lock, in the order they were
# written; filtering the copy holds no lock at all.
get "/notes", query: NoteFilter, response: NoteList do |env, filter|
  wanted = filter.tag
  every = NOTES.values
  found = wanted ? every.select { |note| note.tags.includes?(wanted) } : every
  NoteList.new(found.first(filter.limit).map { |note| Note.new(note) })
end

# `path: Int32` reads the one capture, `:id`. A `StatusError` answered
# beside the `Note` is sent with its status: here the 404 page below.
get "/notes/:id", path: Int32, response: Note do |env, id|
  stored = NOTES[id]?
  stored ? Note.new(stored) : StatusError.new(404)
end

error 404 do |env|
  env.json({"error" => "not found"})
end

run
