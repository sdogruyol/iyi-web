# The application under test, as a module: a function that builds its
# router. The program (examples/testing.iyi) mounts it and serves it; the
# test (examples/testing_test.iyi) sends it requests in-process.
module examples/testing/notes

import iyi_web/router::{Router}
import iyi_web/store::{Store}

# Every call builds a new router with its own empty list of notes, so each
# test starts from a clean application. The list is in a `Store`, which
# holds its lock, since the routes run on every core at once.
pub def notes_routes : Router
  notes = Store.new { [] of String }
  router = Router.new

  router.get "/notes" do |env|
    env.json(notes.to_a)
  end

  # `path: Int32` reads `:index` as a number; `/notes/first` is answered
  # 422 before the block runs.
  router.get "/notes/:index", path: Int32 do |env, index|
    note = index >= 0 ? notes[index]? : nil
    if note
      env.text(note)
    else
      env.halt(404, "No such note")
    end
  end

  router.post "/notes" do |env|
    text = (env.params.body["text"]? || "").strip
    if text.empty?
      env.halt(422, "A note needs text")
    else
      count = notes.update { |list| list << text; list.size }
      env.status(201).text("Note " + (count - 1).to_s)
    end
  end

  router
end
