# Templates: a view rendered inside a layout, `content_for` blocks the layout
# prints, a partial rendered from a view, and autoescape. The views are in
# examples/views/. Run from the repository root with
# `iyi run examples/templates.iyi` and open http://localhost:3000.
#
#   curl localhost:3000/
#   curl localhost:3000/books/3
#   curl -G localhost:3000/search --data-urlencode 'q=<script>alert(1)</script>'
module examples/templates

import std/list::{List}
import iyi_web/dsl::*

struct Book
  getter id : Int32
  getter title : String
  getter author : String
  getter year : Int32
  getter rating : Int32

  def initialize(@id : Int32, @title : String, @author : String, @year : Int32, @rating : Int32)
  end
end

# Constants are defined before the blocks that read them. A `List`, which
# nothing writes, so every worker may read it: a bare `Array` named in a
# route is refused.
BOOKS = List.new([
  Book.new(1, "The Left Hand of Darkness", "Ursula K. Le Guin", 1969, 5),
  Book.new(2, "Kindred", "Octavia E. Butler", 1979, 5),
  Book.new(3, "Snow & Silence", "Unknown <anonymous>", 2001, 3),
])

# Markup the program builds itself, from nothing a request sent: the view
# prints it with `raw(...)`, the one way past autoescape.
def stars(rating : Int32) : String
  "<p class=\"stars\">" + "&#9733;" * rating + "&#9734;" * (5 - rating) + "</p>"
end

# Templates are compiled into the program and see the locals where `render`
# is written: `books` here, `book` below. Paths are relative to this file.
# `<%= %>` escapes what it prints, so "Snow & Silence" and the author's
# "<anonymous>" arrive as text, not markup.
get "/" do |env|
  books = BOOKS
  render "views/books.eiy", "views/layout.eiy"
end

get "/books/:id" do |env|
  id = env.params.url["id"].to_i? || 0
  if book = BOOKS.find { |candidate| candidate.id == id }
    render "views/book.eiy", "views/layout.eiy"
  else
    # An error status hands the response to the `error 404` page below.
    env.response.status_code = 404
    ""
  end
end

# The query is the visitor's own text, printed twice by the view: in an
# attribute and in a heading. Neither needs an `HTML.escape`.
get "/search" do |env|
  query = env.params.query["q"]? || ""
  found = [] of Book
  BOOKS.each do |book|
    found << book if !query.empty? && (book.title.includes?(query) || book.author.includes?(query))
  end
  render "views/search.eiy", "views/layout.eiy"
end

# Error pages can render templates too; the request's path is escaped like
# any other value.
error 404 do |env|
  path = env.request.path
  render "views/not_found.eiy", "views/layout.eiy"
end

run
