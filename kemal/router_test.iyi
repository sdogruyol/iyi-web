# Router dispatch without a socket: path params, HEAD fallback, 404, 405.
module kemal/router_test

import kemal/router
import kemal/request
import kemal/context
import kemal/headers

using kemal/router::{Router, RouteHandler}
using kemal/request::{Request}
using kemal/context::{Context}
using kemal/headers::{Headers}

def request(method : String, path : String) : Request
  request_with_query(method, path, "")
end

def request_with_query(method : String, path : String, query : String) : Request
  headers = Headers.new
  headers["Host"] = "localhost"
  Request.new(method, path, query, "HTTP/1.1", headers, "")
end

def dispatch(handler : RouteHandler, method : String, path : String) : Context
  ctx = Context.for(request(method, path))
  handler.call(ctx)
  ctx
end

router = Router.new
router.get "/" do |env|
  "home"
end
router.get "/users/:id" do |env|
  env.params.url["id"]
end
router.post "/users" do |env|
  "created"
end
router.get "/search" do |env|
  q = env.params.query["q"]?
  q ? "q=#{q}" : "none"
end
router.get "/count" do |env|
  42
end
router.before "/admin" do |env|
  env.halt(401, "no")
  ""
end
router.get "/admin" do |env|
  "secret"
end

handler = RouteHandler.new(router)

home = dispatch(handler, "GET", "/")
assert home.response.body == "home", "GET /"
assert home.response.status_code == 200, "GET / status"

user = dispatch(handler, "GET", "/users/7")
assert user.response.body == "7", "url param"

created = dispatch(handler, "POST", "/users")
assert created.response.body == "created", "POST"

count = dispatch(handler, "GET", "/count")
assert count.response.body == "42", "IntoBody Int32"

search = Context.for(request_with_query("GET", "/search", "q=iyi"))
handler.call(search)
assert search.response.body == "q=iyi", "query param"

head = dispatch(handler, "HEAD", "/")
assert head.response.body == "", "HEAD body empty"
assert head.response.headers["content-length"] == "4", "HEAD content-length of home"

missing = dispatch(handler, "GET", "/nope")
assert missing.response.status_code == 404, "404"

wrong = dispatch(handler, "GET", "/users")
assert wrong.response.status_code == 405, "405 GET on POST /users"
assert wrong.response.headers["allow"].includes?("POST"), "Allow POST"

denied = dispatch(handler, "GET", "/admin")
assert denied.response.status_code == 401, "before filter halt"
assert denied.response.body == "no", "halt body"

puts "router_test ok"
